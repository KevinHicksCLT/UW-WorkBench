    string roleId FK "-> Role (nullable; was roleName)"
    string name
    int allocationPct
  }
  RiskScoringBand {
    string id PK
    string companyId FK
    string label
    int minScore
    int maxScore
  }
  %% ---------- REGULATIONS (50-state, Jurisdiction-keyed) ----------
  Jurisdiction {
    string status "one row per state + DC (51); first-class key"
    string id PK
    string companyId FK
    string code "AL..DC"
    string name
