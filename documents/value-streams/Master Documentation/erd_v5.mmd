  %% ================================================================
  %% COMPLETE application ERD (erd_v5). Seeded from erd_v4 (generic typed
  %% graph), then EXTENDED with the re-modeled peripheral modules so this
  %% diagram reflects the WHOLE app schema (backend/prisma/schema.prisma):
  %%   - Portfolio SPM (Program -> Workstream -> PortfolioInitiative + children)
  %%   - 50-state Regulations (Jurisdiction-keyed, RegulatoryRequirement single reg)
  %%   - App Rationalization (workspace decomposition + v3 Normalize entries)
  %%   - Product Model Rationalization (legacy models -> 11-component findings
  %%     -> canonical models; WorkspaceVocabulary = DB-driven board vocabulary)
  %%   - Scenario, TelemetrySignal, NodeAiAdoption, AnalysisStatus
  %% All operating-model links are real FKs into the spine (ProcessNode/OrgUnit/Role).
  %% dbValue = system/generic name; displayValue = admin-editable label (relabel
  %% via Terminology). Junctions: surrogate id PK + @@unique natural key.
  %% Closures use composite PK. People/Capacity REMOVED. Nothing parked.
  %% ================================================================
  %% ---------- ORG SPINE (generic, level-typed) ----------
  Company {
    string id PK
    string name
    string dbValue
    string displayValue "EDITABLE label"
  }
  OrgLevelType {
    string status "generic levels, db + display value"
    string id PK
    string companyId FK
    int levelNumber
    string dbValue "L1 L2 L3..."
    string displayValue "EDITABLE: Division, Department, Team..."
  }
  OrgUnit {
    string status "adjacency-list tree, any depth"
    string id PK
    string companyId FK
    string orgLevelTypeId FK
    string parentId FK "self -> OrgUnit"
    string dbValue
    string displayValue "EDITABLE label"
    int sortOrder
  }
  OrgUnitClosure {
    string status "DERIVED — fast subtree (move-with-children, rollups)"
    string ancestorId PK, FK
    string descendantId PK, FK
    int depth
  }
  Role {
    string id PK
    string companyId FK
    string orgUnitId FK "primary home"
    string managerRoleId FK "self -> Role (solid-line reporting)"
    string dbValue
    string displayValue "EDITABLE label"
    string description "job description (research-sourced, nullable)"
    string roleFamily "functional family (nullable)"
    string roleLevel "Executive|Senior Leadership|Manager|Individual Contributor (nullable)"
    int sortOrder "display order within the org home (org map drag-reorder)"
  }
  RoleOrgAssignment {
    string status "NEW — role at multiple levels (M:N)"
    string id PK
    string roleId FK
    string orgUnitId FK
    bool isPrimary
  }
  %% ---------- VALUE-STREAM SPINE (generic recursive) ----------
  ProcessLevelType {
    string status "generic levels, db + display value"
    string id PK
    string companyId FK
    int levelNumber
    string dbValue "L1 L2 L3 L4 L5"
    string displayValue "EDITABLE: Domain, Value Stream, Process, Step"
  }
  ProcessNode {
    string status "VALUE STREAM = ProcessNode at L2; L5/isTask = Task"
    string id PK
    string companyId FK
    string processLevelTypeId FK
    string parentId FK "self -> ProcessNode"
    string dbValue
    string displayValue "EDITABLE label"
    bool isTask
    string automatability "manual|augmented|automated"
    string agentSkill "slug -> generated pack in SkillFile (task-scoped)"
    datetime agentSkillGeneratedAt "when task agent-skill pack last (re)generated"
    int sortOrder "<- Seq"
    string code
    json attributes "Verified/Issues"
  }
  ProcessNodeClosure {
    string status "DERIVED — fast subtree (move-with-children, rollups)"
    string ancestorId PK, FK
    string descendantId PK, FK
    int depth
  }
  %% ---------- PRODUCT SPINE (generic recursive) ----------
  ProductLevelType {
    string status "generic levels, db + display value"
