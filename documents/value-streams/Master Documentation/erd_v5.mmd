erDiagram
  direction LR
  %% ================================================================
  %% COMPLETE application ERD (erd_v5). Seeded from erd_v4 (generic typed
  %% graph), then EXTENDED with the re-modeled peripheral modules so this
  %% diagram reflects the WHOLE app schema (backend/prisma/schema.prisma):
  %%   - Portfolio SPM (Program -> Workstream -> PortfolioInitiative + children)
  %%   - 50-state Regulations (Jurisdiction-keyed, RegulatoryRequirement single reg)
  %%   - App Rationalization (workspace decomposition)
  %%   - Scenario, TelemetrySignal, NodeAiAdoption, AnalysisStatus
  %% All operating-model links are real FKs into the spine (ProcessNode/OrgUnit/Role).
  %% dbValue = system/generic name; displayValue = admin-editable label (relabel
  %% via Terminology). Junctions: surrogate id PK + @@unique natural key.
  %% Closures use composite PK. People/Capacity REMOVED. Nothing parked.
  %% ================================================================
  %% ---------- ORG SPINE (generic, level-typed) ----------
  Company {
    string id PK
    string name
    string dbValue
    string displayValue "EDITABLE label"
  }
  OrgLevelType {
    string status "generic levels, db + display value"
    string id PK
    string companyId FK
    int levelNumber
    string dbValue "L1 L2 L3..."
    string displayValue "EDITABLE: Division, Department, Team..."
  }
  OrgUnit {
    string status "adjacency-list tree, any depth"
    string id PK
    string companyId FK
    string orgLevelTypeId FK
    string parentId FK "self -> OrgUnit"
    string dbValue
    string displayValue "EDITABLE label"
    int sortOrder
  }
  OrgUnitClosure {
    string status "DERIVED — fast subtree (move-with-children, rollups)"
    string ancestorId PK, FK
    string descendantId PK, FK
    int depth
  }
  Role {
    string id PK
    string companyId FK
    string orgUnitId FK "primary home"
    string managerRoleId FK "self -> Role (solid-line reporting)"
    string jobDescription "concise purpose & scope (FB-53)"
    string dbValue
    string displayValue "EDITABLE label"
  }
  RoleDottedLine {
    string status "FB-45 — dotted-line reporting (role -> manager role)"
    string id PK
    string companyId FK
    string roleId FK "the reporting role"
    string managerRoleId FK "the dotted-line manager role"
  }
  RoleOrgAssignment {
    string status "NEW — role at multiple levels (M:N)"
    string id PK
    string roleId FK
    string orgUnitId FK
    bool isPrimary
  }
  %% ---------- VALUE-STREAM SPINE (generic recursive) ----------
  ProcessLevelType {
    string status "generic levels, db + display value"
    string id PK
    string companyId FK
    int levelNumber
    string dbValue "L1 L2 L3 L4 L5"
    string displayValue "EDITABLE: Domain, Value Stream, Process, Step"
  }
  ProcessNode {
    string status "VALUE STREAM = ProcessNode at L2; L5/isTask = Task"
    string id PK
    string companyId FK
    string processLevelTypeId FK
    string parentId FK "self -> ProcessNode"
    string dbValue
    string displayValue "EDITABLE label"
    bool isTask
    string automatability "manual|augmented|automated"
    int sortOrder "<- Seq"
    string code
    json attributes "Verified/Issues"
  }
  ProcessNodeClosure {
    string status "DERIVED — fast subtree (move-with-children, rollups)"
    string ancestorId PK, FK
    string descendantId PK, FK
    int depth
  }
  %% ---------- WORK & CONTROL ENTITIES ----------
  Deliverable {
    string id PK
    string companyId FK
    string title
    string automatability "manual|augmented|automated"
  }
  Checklist {
    string status "group over items (codified test)"
    string id PK
    string companyId FK
    string name
  }
  ChecklistItem {
    string id PK
    string checklistId FK
    string roleId FK "nullable"
    string text
  }
  TestingTemplate {
    string status "CHANGED v3 — PRIMARY tie = Deliverable"
    string id PK
    string deliverableId FK "PRIMARY (v3)"
    string taskNodeId FK "-> ProcessNode (task-level), nullable"
    string system
    string location
    string checkType "presence|absence"
    string expected
  }
  Standard {
    string status "EXTENDED v5 — area→leaf tree for the Standards tab"
    string id PK
    string companyId FK
    string name
    boolean isArea "true = department charter"
    string parentId FK "self-rel: area → group → leaf"
    string department
    string category
    string description
    string buildRun
    string ownerRoleId FK "→ Role (accountable)"
    string appliesToValueStreams "raw VS refs (also NodeStandard links)"
    string link
    string mission
    string scope
    boolean charterIncluded
    string ownerLabel
    string relatedRole
    string relatedCategory
    string agentSkill
    string sdlcGates
    string regCitation
    string testProcedure "FB-58 — how to independently verify the leaf"
    string evidence "FB-58 — evidence artifact the check leaves"
  }
  Application {
    string status "CHANGED v3 — internal/external, org-scoped, source-fed; + TCO fields"
    string id PK
    string companyId FK
    string orgUnitId FK "owning org (real usage M:N via NodeAppUsage)"
    string sourceId FK "PRIMARY source (nullable)"
    string name
    string kind "SystemOfRecord|Tool|Service"
    bool isInternal
    string ownershipModel
    float totalTco
    string code
    bool systemOfRecord
    string criticality
    string category
    string vendor
    bool illustrative
  }
  IntegrationSource {
    string status "NEW v3 — systems-of-record sync + delta tracking"
    string id PK
    string companyId FK
    string name
    string kind "ServiceNow|ITAM|CMDB|RCM|Finance|Other"
    string syncDirection "in|bidirectional"
    string changeDetection "delta|snapshot"
    string lastSyncAt
  }
  %% ---------- CONNECTIONS (junctions, bind at ANY level) ----------
  NodeDeliverable {
    string status "was StepDeliverable (L3 only)"
    string id PK
    string companyId FK
    string processNodeId FK
    string deliverableId FK
  }
  RoleDeliverable {
    string id PK
    string companyId FK
    string roleId FK
    string deliverableId FK
    string role "Owner|Contributor"
  }
  NodeRole {
    string status "NEW v4 — CRITICAL: task owner/participant (role <-> ProcessNode)"
    string id PK
    string companyId FK
    string processNodeId FK
    string roleId FK
    string role "Owner|Participant"
    string ownerLevel
  }
  NodeRegulation {
    string status "was RequirementValueStream; -> RegulatoryRequirement"
    string id PK
    string companyId FK
    string processNodeId FK
    string regId FK "-> RegulatoryRequirement"
    string relationship
  }
  RegulationApplication {
    string status "NEW — reg -> apps + evidence"
    string id PK
    string companyId FK
    string regId FK "-> RegulatoryRequirement"
    string applicationId FK
    string evidenceRef
  }
  RegulationDeliverable {
    string status "NEW v3 — reg evidence as a deliverable"
    string id PK
    string companyId FK
    string regId FK "-> RegulatoryRequirement"
    string deliverableId FK
  }
  RoleRegulation {
    string status "NEW — reg Owner/Contributor role"
    string id PK
    string companyId FK
    string roleId FK
    string regId FK "-> RegulatoryRequirement"
    string role_ "Owner|Contributor"
  }
  NodeStandard {
    string status "was Standard_L4"
    string id PK
    string companyId FK
    string processNodeId FK
    string standardId FK
  }
  RoleStandard {
    string status "NEW v3 — standard owned/followed by role"
    string id PK
    string companyId FK
    string roleId FK
    string standardId FK
  }
  StandardDeliverable {
    string status "NEW v3 — standard -> deliverable"
    string id PK
    string companyId FK
    string standardId FK
    string deliverableId FK
  }
  NodeAppUsage {
    string status "was StepAppUsage (L5)"
    string id PK
    string companyId FK
    string processNodeId FK
    string applicationId FK
    string usageType "performed|memorialized"
  }
  NodeChecklist {
    string status "was Checklist_Step"
    string id PK
    string companyId FK
    string processNodeId FK
    string checklistItemId FK
  }
  %% ---------- INITIATIVE & METRIC (UNPARKED) ----------
  Initiative {
    string status "UNPARKED"
    string id PK
    string companyId FK
    string name
    string state
    string startDate
    string targetDate
  }
  NodeInitiative {
    string status "NEW — initiative -> value-stream nodes (any level)"
    string id PK
    string companyId FK
    string processNodeId FK
    string initiativeId FK
  }
  Metric {
    string status "UNPARKED — polymorphic target by kind (exactly one set)"
    string id PK
    string companyId FK
    string processNodeId FK "nullable — kpi / value stream"
    string orgUnitId FK "nullable — workforce (org)"
    string roleId FK "nullable — workforce (role)"
    string applicationId FK "nullable — system"
    string name
    float value
    string unit
    string period
    string kind "workforce|system|kpi"
  }
  %% ---------- EXTERNAL PARTIES (operating-model boundary) ----------
  ExternalParty {
    string status "NEW — Agent/Broker/Regulator/MGA/Insured/Vendor/SaaS/SI"
    string id PK
    string companyId FK
    string name
    string partyType "Agent|Broker|Regulator|MGA|Insured|Vendor|SaaS|SystemIntegrator"
  }
  ExternalInteraction {
    string status "NEW — dependency on parties you don't control (wait-time)"
    string id PK
    string roleId FK "nullable"
    string externalPartyId FK
    string processNodeId FK "nullable"
    string nature "handoff|approval|data|service"
  }
  %% ---------- AGENT ENABLEMENT (UNPARKED) ----------
  KnowledgeBase {
    string status "UNPARKED — domain/subject knowledge base"
    string id PK
    string companyId FK
    string name
    string domain
  }
  AgentSkill {
    string status "UNPARKED — KB tied to app/task; powers automation"
    string id PK
    string knowledgeBaseId FK
    string taskNodeId FK "-> ProcessNode, nullable"
    string name
  }
  %% ---------- ADMIN & CROSS-CUTTING ----------
  Terminology {
    string status "NEW — display over db value (any entity); taxonomy/dictionary/ontology"
    string id PK
    string companyId FK
    string entity
    string dbValue
    string displayValue "EDITABLE"
  }
  AuditEntry {
    string status "CHANGED v3 — tie to process/role, not just company"
    string id PK
    string tenantId FK
    string actorRoleId FK "nullable"
    string processNodeId FK "nullable"
    string entityType
    string entityId
    string action
    string actorEmail
  }
  UserPreference {
    string status "NEW — end-user prefs (col order) vs admin config"
    string id PK
    string roleId FK "actor proxy (People removed)"
    string scope
    string prefsJson
  }
  NodeAiAdoption {
    string status "1:1 ProcessNode — Telemetry / Active AI autonomy modes"
    string id PK
    string processNodeId FK "UNIQUE"
    string aiAssist
    string aiAugment
    string aiWorkflow
    string aiAutonomous
    json useCases
    json stats
  }
  %% ---------- TELEMETRY / SCENARIO / ANALYSIS ----------
  TelemetrySignal {
    string status "Trackable Metrics catalog (kept as-is)"
    string id PK
    string companyId FK
    string kind "system|kpi"
    string name
    string unit
    bool isLive
  }
  Scenario {
    string status "change-impact economics; div/vs -> real FKs"
    string id PK
    string companyId FK
    string orgUnitId FK "nullable (was divisionName)"
    string processNodeId FK "nullable (was valueStreamName)"
    string name
    string changeType
    float oneTimeCost
    float annualNetImpact
  }
  AnalysisStatus {
    string status "Metrics coverage; subjectId references a node/role/org id (string)"
    string id PK
    string companyId FK
    string subjectType "valueStream|division|role"
    string subjectId "ProcessNode/OrgUnit/Role id (indexed string)"
    string status_ "Not Started|In Progress|Complete"
  }
  %% ---------- PORTFOLIO SPM (Program -> Workstream -> PortfolioInitiative) ----------
  Program {
    string id PK
    string companyId FK
    string name
    string startDate
    string endDate
    string status "ON_TRACK|AT_RISK|OFF_TRACK"
  }
  Workstream {
    string id PK
    string companyId FK
    string programId FK
    string name
    string status
  }
  PortfolioInitiative {
    string status "stage-gate IDEA->...->COMPLETE; operating-model links = real FKs"
    string id PK
    string companyId FK
    string workstreamId FK
    string name
    string stage
    string valueStreamNodeId FK "-> ProcessNode (nullable)"
    string orgUnitId FK "-> OrgUnit (nullable)"
    string ownerRoleId FK "-> Role (nullable)"
    string sponsorRoleId FK "-> Role (nullable)"
