    float valueScore
  }
  BenefitLine {
    string id PK
    string initiativeId FK
    string name
    string startDate
    string endDate
  }
  CostLine {
    string id PK
    string initiativeId FK
    string name
    string startDate
    string endDate
  }
  MetricValue {
    string status "time-phased monthly; sparse FK benefit OR cost"
    string id PK
    string benefitLineId FK "nullable"
    string costLineId FK "nullable"
    string dataset "ACTUAL|TARGET|FORECAST"
    string periodStart
    float amount
  }
  Milestone {
    string id PK
    string initiativeId FK
    string name
    string dueDate
    bool isGate
  }
  RaidItem {
    string id PK
    string initiativeId FK
    string type "RISK|ASSUMPTION|ISSUE|DECISION"
