erDiagram
  direction LR
  %% ================================================================
  %% COMPLETE application ERD (merged, v4 — connection-review fixes applied).
  %% People/Capacity REMOVED. Nothing parked. Every table: surrogate id PK
  %% (junctions too); closures use composite PK. dbValue = system/generic
  %% name; displayValue = admin-editable label (relabel via Terminology).
  %% Per-level VIEWS are virtual (joins rendered for screens, not stored).
  %% Checklist/ChecklistItem = codified manual checklist; TestingTemplate =
  %% agent-teaching/automated verification — DIFFERENT, not interchangeable.
  %% Actor = Role (People removed); auth users/accounts are not modeled here.
  %% ================================================================
  %% ---------- ORG SPINE (generic, level-typed) ----------
  Company {
    string id PK
    string name
    string displayValue "EDITABLE label"
  }
  OrgLevelType {
    string status "generic levels, db + display value"
    string id PK
    string companyId FK
    int levelNumber
    string dbValue "L1 L2 L3..."
    string displayValue "EDITABLE: Division, Department, Team..."
  }
  OrgUnit {
    string status "adjacency-list tree, any depth"
    string id PK
    string companyId FK
    string orgLevelTypeId FK
    string parentId FK "self -> OrgUnit"
    string dbValue
    string displayValue "EDITABLE label"
  }
  OrgUnitClosure {
    string status "DERIVED — fast subtree (move-with-children, rollups)"
    string ancestorId PK, FK
    string descendantId PK, FK
    int depth
  }
  Role {
    string id PK
    string companyId FK
    string orgUnitId FK "primary home"
    string managerRoleId FK "self -> Role (reporting)"
    string name
  }
  RoleOrgAssignment {
    string status "NEW — role at multiple levels (M:N)"
    string id PK
    string roleId FK
    string orgUnitId FK
    bool isPrimary
  }
  %% ---------- VALUE-STREAM SPINE (generic recursive) ----------
  ProcessLevelType {
    string status "generic levels, db + display value"
    string id PK
    string companyId FK
    int levelNumber
    string dbValue "L1 L2 L3 L4 L5"
    string displayValue "EDITABLE: Domain, Value Stream, Process, Step"
  }
  ProcessNode {
    string status "VALUE STREAM = ProcessNode at L2; L5/isTask = Task"
    string id PK
    string companyId FK
    string processLevelTypeId FK
    string parentId FK "self -> ProcessNode"
    string dbValue
    string displayValue "EDITABLE label"
    bool isTask
    string automatability "manual|augmented|automated"
  }
  ProcessNodeClosure {
    string status "DERIVED — fast subtree (move-with-children, rollups)"
    string ancestorId PK, FK
    string descendantId PK, FK
    int depth
  }
  %% ---------- WORK & CONTROL ENTITIES ----------
  Deliverable {
    string id PK
    string companyId FK
    string title
    string automatability "manual|augmented|automated"
  }
  Checklist {
    string status "group over items (codified test)"
    string id PK
    string companyId FK
    string name
  }
  ChecklistItem {
    string id PK
    string checklistId FK
    string roleId FK
    string text
  }
  TestingTemplate {
    string status "CHANGED v3 — PRIMARY tie = Deliverable"
    string id PK
    string deliverableId FK "PRIMARY (v3)"
    string taskNodeId FK "-> ProcessNode (task-level)"
    string system
    string location
    string checkType "presence|absence"
    string expected
  }
  Standard {
    string status "behaves as task group"
    string id PK
    string companyId FK
    string name
  }
  RegulatoryReq {
    string status "behaves as task group"
    string id PK
    string companyId FK
    string name
  }
  Application {
    string status "CHANGED v3 — internal/external, org-scoped, source-fed"
    string id PK
    string companyId FK
    string orgUnitId FK "owning org (real usage M:N via NodeAppUsage)"
    string sourceId FK "PRIMARY source (apps may appear in many)"
    string name
    string kind "SystemOfRecord|Tool|Service"
    bool isInternal "NEW v3 — internal vs external app"
  }
  IntegrationSource {
    string status "NEW v3 — systems-of-record sync + delta tracking"
    string id PK
    string companyId FK
    string name
    string kind "ServiceNow|ITAM|CMDB|RCM|Finance|Other"
    string syncDirection "in|bidirectional"
    string changeDetection "delta|snapshot"
    string lastSyncAt
  }
  %% ---------- CONNECTIONS (junctions, bind at ANY level) ----------
  NodeDeliverable {
    string status "was StepDeliverable (L3 only)"
    string id PK
    string processNodeId FK
    string deliverableId FK
  }
  RoleDeliverable {
    string id PK
    string roleId FK
    string deliverableId FK
    string role "Owner|Contributor"
  }
  NodeRole {
    string status "NEW v4 — CRITICAL: task owner/participant (role <-> ProcessNode)"
    string id PK
    string processNodeId FK
    string roleId FK
    string role "Owner|Participant"
  }
  NodeRegulation {
    string status "was RequirementValueStream (L3)"
    string id PK
    string processNodeId FK
    string regId FK
  }
  RegulationApplication {
    string status "NEW — reg -> apps + evidence"
    string id PK
    string regId FK
    string applicationId FK
    string evidenceRef
  }
  RegulationDeliverable {
    string status "NEW v3 — reg evidence as a deliverable"
    string id PK
    string regId FK
    string deliverableId FK
  }
  NodeStandard {
    string status "was Standard_L4"
    string id PK
    string processNodeId FK
    string standardId FK
  }
  RoleStandard {
    string status "NEW v3 — standard owned/followed by role"
    string id PK
    string roleId FK
    string standardId FK
  }
  StandardDeliverable {
    string status "NEW v3 — standard -> deliverable"
    string id PK
    string standardId FK
    string deliverableId FK
  }
  NodeAppUsage {
    string status "was StepAppUsage (L5)"
    string id PK
    string processNodeId FK
    string applicationId FK
    string usageType "performed|memorialized"
  }
  NodeChecklist {
    string status "was Checklist_Step"
    string id PK
    string processNodeId FK
    string checklistItemId FK
  }
  %% ---------- INITIATIVE & METRIC (UNPARKED) ----------
  Initiative {
    string status "UNPARKED"
    string id PK
    string companyId FK
    string name
    string state
    string startDate
    string targetDate
  }
  NodeInitiative {
    string status "NEW — initiative -> value-stream nodes (any level)"
    string id PK
    string processNodeId FK
    string initiativeId FK
  }
  Metric {
    string status "UNPARKED — polymorphic target by kind (exactly one set)"
    string id PK
    string companyId FK
    string processNodeId FK "nullable — kpi / value stream"
    string orgUnitId FK "nullable — workforce (org)"
    string roleId FK "nullable — workforce (role)"
    string applicationId FK "nullable — system"
    string name
    float value
    string unit
    string period
    string kind "workforce|system|kpi"
  }
  %% ---------- EXTERNAL PARTIES (operating-model boundary) ----------
  ExternalParty {
    string status "NEW — Agent/Broker/Regulator/MGA/Insured/Vendor/SaaS/SI"
    string id PK
    string companyId FK
    string name
    string partyType "Agent|Broker|Regulator|MGA|Insured|Vendor|SaaS|SystemIntegrator"
  }
  ExternalInteraction {
    string status "NEW — dependency on parties you don't control (wait-time)"
    string id PK
    string roleId FK
    string externalPartyId FK
    string processNodeId FK
    string nature "handoff|approval|data|service"
  }
  %% ---------- AGENT ENABLEMENT (UNPARKED) ----------
  KnowledgeBase {
    string status "UNPARKED — domain/subject knowledge base"
    string id PK
    string companyId FK
    string name
    string domain
  }
  AgentSkill {
    string status "UNPARKED — KB tied to app/task; powers automation"
    string id PK
    string knowledgeBaseId FK
    string taskNodeId FK "-> ProcessNode"
    string name
  }
  %% ---------- ADMIN & CROSS-CUTTING ----------
  Terminology {
    string status "NEW — display over db value (any entity); taxonomy/dictionary/ontology"
    string id PK
    string companyId FK
    string entity
    string dbValue
    string displayValue "EDITABLE"
  }
  AuditEntry {
    string status "CHANGED v3 — tie to process/level, not just company"
    string id PK
    string companyId FK
    string actorRoleId FK
    string processNodeId FK "NEW v3"
    string entity
    string action
    string timestamp
  }
  UserPreference {
    string status "NEW — end-user prefs (col order) vs admin config"
    string id PK
    string roleId FK "actor proxy (People removed)"
    string scope
    string prefsJson
  }
  %% ================= RELATIONSHIPS =================
  %% org spine
  Company ||--o{ OrgLevelType : "defines"
  Company ||--o{ OrgUnit : "has"
  OrgLevelType ||--o{ OrgUnit : "types"
  OrgUnit ||--o{ OrgUnit : "parent-of"
