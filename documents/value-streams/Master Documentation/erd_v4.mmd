  Application ||--o{ RegulationApplication : "evidenced-by"
  RegulatoryReq ||--o{ RegulationDeliverable : "evidence"
  Deliverable ||--o{ RegulationDeliverable : "evidences"
  ProcessNode ||--o{ NodeStandard : ""
