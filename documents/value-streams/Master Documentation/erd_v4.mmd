  ProcessNode ||--o{ NodeAppUsage : ""
  Application ||--o{ NodeAppUsage : ""
  ProcessNode ||--o{ NodeChecklist : ""
  ChecklistItem ||--o{ NodeChecklist : ""
  %% initiative & metric
  Company ||--o{ Initiative : "runs"
  ProcessNode ||--o{ NodeInitiative : ""
  Initiative ||--o{ NodeInitiative : ""
  Company ||--o{ Metric : "measures"
  ProcessNode |o--o{ Metric : "kpi / VS"
  OrgUnit |o--o{ Metric : "workforce (org)"
  Role |o--o{ Metric : "workforce (role)"
  Application |o--o{ Metric : "system"
  %% external parties
  Company ||--o{ ExternalParty : "interacts-with"
  Role ||--o{ ExternalInteraction : "depends-on"
  ExternalParty ||--o{ ExternalInteraction : "party"
  ProcessNode ||--o{ ExternalInteraction : "at"
  %% agent enablement
  Company ||--o{ KnowledgeBase : "owns"
  KnowledgeBase ||--o{ AgentSkill : "exposes"
  ProcessNode ||--o{ AgentSkill : "automatable-via"
  %% admin & prefs
  Company ||--o{ Terminology : "relabels"
  Company ||--o{ AuditEntry : "logs"
  Role ||--o{ AuditEntry : "actor"
  ProcessNode ||--o{ AuditEntry : "on"
  Role ||--o{ UserPreference : "sets"
  %% derived
  Role }o..o{ ProcessNode : "derived (via work)"
  %% ================= COLOR CODING =================
