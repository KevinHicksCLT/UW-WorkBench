# Copy to server/.env (or export in your shell).
# Local Postgres from docker-compose.yml:
DATABASE_URL=postgresql://uw:uw@localhost:5433/uw_workbench
# Sign + verify JWTs. CHANGE THIS in any real deployment.
JWT_SECRET=dev-secret-change-me
PORT=4000
