# Postgres connection string used by the app at runtime.
# For Neon, use the POOLED host (…-pooler…) and append ?pgbouncer=true.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Direct (non-pooled) connection used by `prisma migrate` / `prisma db push`.
# Required by schema.prisma (datasource directUrl). For Neon, the non-pooler host.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Sign JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me"

# Local dev only — Vercel sets PORT itself
PORT=4000

# ─── AI Assistant (/chat) ──────────────────────────────────────────────────
# Anthropic API key (token-billed; separate from any Claude Max subscription).
ANTHROPIC_API_KEY="sk-ant-..."
# Read-only Postgres role used ONLY by the assistant. Same HOST as DATABASE_URL;
# chatbot_ro has SELECT on public with "User" + _prisma_migrations revoked
# (setup: scripts/chatbot-ro-setup.sql).
DATABASE_URL_RO="postgresql://chatbot_ro:PASSWORD@HOST/DB?sslmode=require"
# Schema the assistant is allowed to read (optional, default public), and the model it uses (optional).
CHATBOT_SCHEMA="public"
CHATBOT_MODEL="claude-sonnet-4-6"
