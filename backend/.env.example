# Postgres (Neon): pooled URL for app queries, direct URL for migrations.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# JWT signing secret — set a real one outside local dev.
JWT_SECRET="dev-secret"

# Optional
# PORT=4000
# LOG_LEVEL=info
