# Postgres connection string used by the app at runtime.
# For Neon, use the POOLED host (…-pooler…) and append ?pgbouncer=true.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Direct (non-pooled) connection used by `prisma migrate` / `prisma db push`.
# Required by schema.prisma (datasource directUrl). For Neon, the non-pooler host.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Sign JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me"

# Local dev only — Vercel sets PORT itself
PORT=4000

# ─── Multi-company / white-label configuration (all optional) ───────────────
# Platform display name used in AI assistant prompts.
# PLATFORM_NAME="Capgemini Transformation Bridge"
# Seed-time overrides for onboarding a new company (see
# documents/refactor/hardcoded-data-audit.md):
# SEED_COMPANY_SLUG="abc-insurance"
# SEED_L3_LABEL="Department"

# ─── AI Assistant (/chat) ──────────────────────────────────────────────────
# Anthropic API key (token-billed; separate from any Claude Max subscription).
ANTHROPIC_API_KEY="sk-ant-..."
# Read-only Postgres role used ONLY by the assistant. Same HOST as DATABASE_URL;
# chatbot_ro has SELECT on public with "User" + _prisma_migrations revoked
# (setup: scripts/chatbot-ro-setup.sql).
DATABASE_URL_RO="postgresql://chatbot_ro:PASSWORD@HOST/DB?sslmode=require"
# Schema the assistant is allowed to read (optional, default public), and the model it uses (optional).
CHATBOT_SCHEMA="public"
CHATBOT_MODEL="claude-sonnet-4-6"

# ─── Feedback pipeline (/feedback) ─────────────────────────────────────────
# Non-secret settings (button toggle, Jira project, notification list) live in
# backend/config/feedback.config.json. Secrets go here. Uses ANTHROPIC_API_KEY
# (above) for ticket generation; override the model with FEEDBACK_MODEL.
# FEEDBACK_MODEL="claude-opus-4-8"
# Jira Cloud basic auth — the account email + an API token from
# https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_EMAIL="you@company.com"
# JIRA_API_TOKEN="..."
# Resend API key + verified sender for notification emails (defaults to
# Resend's shared onboarding sender when FEEDBACK_FROM_EMAIL is unset).
# RESEND_API_KEY="re_..."
# FEEDBACK_FROM_EMAIL="Transformation Bridge <feedback@your-domain.com>"
