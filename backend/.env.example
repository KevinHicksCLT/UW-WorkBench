# Postgres connection string (Neon, Vercel Postgres, Supabase, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Sign JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me"

# Local dev only — Vercel sets PORT itself
PORT=4000
