{
  "name": "cascade-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "postinstall": "prisma generate",
    "vercel-build": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:setup": "prisma generate && prisma migrate deploy && tsx src/seed/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx src/seed/seed.ts",
    "db:seed": "tsx src/seed/seed.ts",
    "db:seed:master": "tsx src/seed/seedMaster.ts",
    "db:seed:regulations": "tsx src/seed/seedRegulations.ts",
    "db:seed:entitlements": "tsx scripts/seed-entitlements.ts",
    "db:transform": "tsx scripts/transform-workbook.ts ../IT_Roles_Analytics_v16.xlsx",
    "import:levels": "tsx scripts/import-levels.ts",
    "connect:levels": "tsx scripts/connect-levels.ts",
    "import:org": "tsx scripts/import-org-levels.ts",
    "load:standards": "tsx scripts/load-standards.ts",
    "db:verify": "tsx scripts/verify-seed.ts",
    "db:backfill": "tsx scripts/backfill-roles.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@cascade/shared": "*",
    "@prisma/client": "^6.19.3",
    "@types/compression": "^1.8.1",
    "@types/multer": "^2.2.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.6",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.9",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.9",
    "yaml": "^2.9.0"
  }
}
