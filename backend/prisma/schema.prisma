  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  domain    String?
  createdAt DateTime @default(now())

  skills AgentSkill[]

  @@index([companyId])
}

// UNPARKED — KB tied to app/task; powers automation.
model AgentSkill {
  id              String        @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  taskNodeId      String?
  taskNode        ProcessNode?  @relation(fields: [taskNodeId], references: [id], onDelete: SetNull)
  name            String
  createdAt       DateTime      @default(now())

  @@index([knowledgeBaseId])
  @@index([taskNodeId])
}

// Persisted skill-pack files (SKILL.md + references/data/etc.), served from the
// DB so prod/serverless doesn't depend on the repo filesystem. Standards' hand-
// authored KEEP packs (ccpa/gdpr/nydfs/sox/acord) live here; per-category packs
// are built on demand instead (see lib/skillPacks.ts). Task agent-skill packs
// (skill = "task-<nodeId>") are also stored here — generated once from a task's
// plan (lib/taskSkillPack.ts), then editable and preserved.
model SkillFile {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  skill     String // pack folder name, e.g. "sox-itgc-sdlc-compliance"
  path      String // pack-relative POSIX path, e.g. "references/audit-evidence-map.md"
  content   String
  bytes     Int
  updatedAt DateTime @updatedAt

  @@unique([companyId, skill, path])
  @@index([companyId, skill])
}

// ─── ADMIN & CROSS-CUTTING ──────────────────────────────────────────────

// NEW — display override over db value (any entity); taxonomy/dictionary/ontology.
model Terminology {
  id           String   @id @default(cuid())
