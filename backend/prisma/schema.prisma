// Strata — Operating-Model Data Spine (Phase 1)
// One governed model of a company's operating model:
//   Company → Division → Department → Role
//   ValueStream → SubValueStream (L3→L4 self-relation)
//   Role ↔ ValueStream (participation), Role → ChecklistItem / RoleTask,
//   Category, ExternalInteraction.
// Seeded from IT_Roles_Analytics_v12.xlsx. Every spine record carries inline
// provenance (sourceSheet/sourceRow) back to the workbook.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Tenancy & Identity (reusable infra, carried from Cascade) ──────────

model Tenant {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  createdAt    DateTime     @default(now())
  users        User[]
  companies    Company[]
  auditEntries AuditEntry[]
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  email     String   @unique
  name      String
  password  String // bcrypt hash
  role      String   @default("MEMBER") // ADMIN | MANAGER | MEMBER | VIEWER
  createdAt DateTime @default(now())
}

// ─── Operating-model spine ──────────────────────────────────────────────

model Company {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Home-dashboard layout chosen in Data Admin → Home. Shape: { widgets: string[] }
  // (ordered widget ids from the frontend catalog). Null = the default layout.
  dashboardConfig Json?

  divisions            Division[]
  departments          Department[]
  roles                Role[]
  categories           Category[]
  valueStreams         ValueStream[]
  externalInteractions ExternalInteraction[]
  applications         Application[]
  metrics              Metric[]
  initiatives          Initiative[]
  people               Person[]
  risks                Risk[]
  domains              ValueStreamDomain[]
  standards            Standard[]
  standardItems        StandardItem[]
  scenarios            Scenario[]
  rationalizationWorkspaces RationalizationWorkspace[]
  levels               Level[]
  orgLevels            OrgLevel[]
  programs             Program[]
  workstreams          Workstream[]
  portfolioInitiatives PortfolioInitiative[]
  deliverables         Deliverable[]
  tasks                Task[]
  nodes                Node[]
  telemetrySignals     TelemetrySignal[]

  @@unique([tenantId, slug])
}

// Trackable telemetry signal — one row per signal/metric the Telemetry
// "Trackable Metrics" catalog renders. Two origins, imported 1:1 by
// scripts/seed-telemetry-signals.ts: the live workforce signals (isLive=true,
// per-person readings exist in PersonSignal/PersonMetric — queryType holds which
// store, 'signal' | 'metric') and the workbook reference catalog
// (Metric_Catalog_Expanded + External_Metric_Catalog; isLive=false, queryType is
// the extraction/calculation note). Editable in Data Admin → Telemetry.
model TelemetrySignal {
  id          String   @id @default(cuid())
  tenantId    String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind        String // workforce (per-person Viva/M365 telemetry) | system (system-of-record metric)
  name        String
  description String?
  source      String? // raw source system text, e.g. "Microsoft Viva Insights"
  category    String?
  unit        String? // unit or data type, e.g. "hrs/wk", "Percent / score"
  frequency   String?
  direction   String   @default("up") // up = higher is better, down = lower is better
  origin      String? // provenance — the workbook sheet the row came from
  queryType   String? // live rows: which store ('signal'|'metric'); catalog rows: how it's calculated
  isLive      Boolean  @default(false) // true = per-person readings exist (role drill-down works)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
}

// ─── Configurable Level hierarchy (value-stream rebuild) ────────────────
// A single, fully-configurable, self-referential level tree that backs the
// "Levels" editor in Data Admin and (next) the value-stream list + map.
// `levelNumber` is the depth (0 Company · 1 Domain · 2 Division · 3 Value Stream
// · 4 Sub-Process · 5 Process Step) and `parentId` connects each node to the one
// above it. L0–L2 mirror the org spine (sourceType/sourceRefId point back to the
// Company/Division record); L3–L5 are imported from the E2E Process Flows catalog.
// The detail fields carry the L5 step metadata shown in the metrics sidebar.
model Level {
  id          String  @id @default(cuid())
  tenantId    String
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  levelNumber Int
  parentId    String?
  parent      Level?  @relation("LevelTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Level[] @relation("LevelTree")
  name        String
  sortOrder   Int     @default(0)

  // L5 step detail (also generic). From the E2E catalog: G description, H+I roles,
  // J inputs, K outputs, M external participants, L notes.
  description          String?
  leads                String?
  supporting           String?
  inputs               String?
  outputs              String?
  externalParticipants String?
  notes                String?

  // Provenance. sourceType ∈ company | domain | division | catalog; sourceRefId
  // points at the org record for L0–L2 nodes mirrored from the spine.
  sourceType  String?
  sourceRefId String?

  // AI-adoption (Telemetry) for value-stream nodes (levelNumber = 3). Optional 1:1.
  aiAdoption LevelAiAdoption?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, levelNumber])
  @@index([parentId])
}

// AI-adoption levels for a value-stream Level node (audit D3/D7/U2/A1). One row per
// value-stream node; columns are the four AI autonomy modes. Values:
// not_used | pilot | emerging | scaling | embedded. `useCases` holds the authored
// per-mode use-case detail (JSON) shown on the value-stream detail / Telemetry.
model LevelAiAdoption {
  id           String   @id @default(cuid())
  levelId      String   @unique
  level        Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  aiAssist     String   @default("not_used")
  aiAugment    String   @default("not_used")
  aiWorkflow   String   @default("not_used")
  aiAutonomous String   @default("not_used")
  useCases     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Organization level tree — the SEPARATE configurable hierarchy for the org side
// (Company · Domain · Division · Department · Role …). Kept distinct from `Level`
// (value streams) so configuring one never touches the other or the live
// operating data (IoItem/ProcessStep/etc.). Same shape as Level for a shared editor.
model OrgLevel {
  id          String  @id @default(cuid())
  tenantId    String
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  levelNumber Int
  parentId    String?
  parent      OrgLevel?  @relation("OrgLevelTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    OrgLevel[] @relation("OrgLevelTree")
  name        String
  sortOrder   Int     @default(0)

  description          String?
  leads                String?
  supporting           String?
  inputs               String?
  outputs              String?
  externalParticipants String?
  notes                String?

  sourceType  String?
  sourceRefId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, levelNumber])
  @@index([parentId])
}

model Division {
  id        String  @id @default(cuid())
  tenantId  String
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code      String
  name      String
  // Top-level CEO grouping from Org Chart View 2 "Higher-Level Category" column.
  // One of: "Core Business" | "IT" | "Corporate Function"
  higherCategory String?

  sourceSheet String?
  sourceRow   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  departments     Department[]
  roles           Role[]
  initiativeLinks InitiativeDivision[]

  @@unique([tenantId, companyId, name])
  @@index([companyId])
}

model Department {
  id         String   @id @default(cuid())
  tenantId   String
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  name       String

  sourceSheet String?
  sourceRow   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles Role[]

  @@unique([divisionId, name])
  @@index([companyId])
  @@index([divisionId])
}

model Role {
  id           String      @id @default(cuid())
  tenantId     String
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  divisionId   String?
  division     Division?   @relation(fields: [divisionId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  name         String // canonical display name
  itemRole     String? // name used by the Items / Aligned Role Tasks sheets (join key)
  roleFamily   String?
  // v13 extended attributes (reporting hierarchy + role profile)
  roleLevel          String? // Executive | Leadership | Manager | Individual Contributor
  description        String?
  responsibilities   String?
  status             String? // New (Extended Role Inventory) | null (org-chart roster)
  primaryDomain      String?
  primaryValueStream String?
  managerRoleId      String?
  manager            Role?   @relation("RoleReports", fields: [managerRoleId], references: [id])
  reports            Role[]  @relation("RoleReports")
  sourceSheet  String?
  sourceRow    Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  checklistItems       ChecklistItem[]
  roleTasks            RoleTask[]
  valueStreamLinks     RoleValueStream[]
  externalInteractions ExternalInteraction[]
  assignments          Assignment[]
  sponsoredInitiatives Initiative[]          @relation("InitiativeSponsor")
  ownedRisks           Risk[]               @relation("RiskOwner")
  ownedStandardItems   StandardItem[]       @relation("StandardItemOwner")

  @@unique([tenantId, companyId, name])
  @@index([companyId])
  @@index([departmentId])
  @@index([managerRoleId])
}

model Category {
  id        String   @id @default(cuid())
  tenantId  String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  checklistItems ChecklistItem[]
  roleTasks      RoleTask[]

  @@unique([tenantId, companyId, name])
  @@index([companyId])
}

model ValueStream {
  id        String  @id @default(cuid())
  tenantId  String
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  domain    String? // raw domain label (also linked via domainId below)
  domainId  String?
  domainRef ValueStreamDomain? @relation(fields: [domainId], references: [id])

  sourceSheet String?
  sourceRow   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subStreams       SubValueStream[]
  roleLinks        RoleValueStream[]
  applicationLinks ApplicationValueStream[]
  metrics          Metric[]
  initiativeLinks  InitiativeValueStream[]
  risks            Risk[]
  processSteps     ProcessStep[]
  ioItems          IoItem[]

  @@unique([tenantId, companyId, name])
  @@index([companyId])
  @@index([domainId])
}

// v13 value-stream DOMAINS — the top of the "how the business operates" axis
// (Core Insurance, Technology, Finance, Risk & Control, …). Groups value streams.
model ValueStreamDomain {
  id           String        @id @default(cuid())
  tenantId     String
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  illustrative Boolean       @default(false)
  createdAt    DateTime      @default(now())
  valueStreams ValueStream[]

  @@unique([companyId, name])
  @@index([companyId])
}

// L3 (Process Area), L4 (Sub-Process), and L5 (Process Step) nodes. Each level
// points at its parent via parentId (self-relation), queried by recursive CTE.
// L5 steps (v15) carry their brief description in `notes`; ordered by sourceRow.
model SubValueStream {
  id            String           @id @default(cuid())
  tenantId      String
  valueStreamId String
  valueStream   ValueStream      @relation(fields: [valueStreamId], references: [id], onDelete: Cascade)
  parentId      String?
  parent        SubValueStream?  @relation("SubStreamTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      SubValueStream[] @relation("SubStreamTree")
  level         Int // 3 = Process Area, 4 = Sub-Process, 5 = Process Step
  name          String
  inputs        String?
  outputs       String?
  upstream      String?
  downstream    String?
  notes         String?

  sourceSheet String?
  sourceRow   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([valueStreamId, parentId, name])
  @@index([valueStreamId])
  @@index([parentId])
}

model ChecklistItem {
  id         String    @id @default(cuid())
  tenantId   String
  roleId     String
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  text       String
  crossRole  Boolean   @default(false)

  sourceSheet String?
  sourceRow   Int?
  createdAt   DateTime @default(now())

  @@index([roleId])
  @@index([categoryId])
}

model RoleTask {
  id         String    @id @default(cuid())
  tenantId   String
  roleId     String
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  text       String

  sourceSheet String?
  sourceRow   Int?
  createdAt   DateTime @default(now())

  personTasks PersonTask[]

  @@index([roleId])
  @@index([categoryId])
}

// Role ↔ ValueStream participation (one row per role/stream/sub-stream).
model RoleValueStream {
  id                String      @id @default(cuid())
  tenantId          String
  roleId            String
  role              Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  valueStreamId     String
  valueStream       ValueStream @relation(fields: [valueStreamId], references: [id], onDelete: Cascade)
  subStream         String?
  participationType String // Lead | Core | Support | Oversight | Control
  inputs            String?
  outputs           String?
  upstream          String?
  downstream        String?
  notes             String?

  sourceSheet String?
  sourceRow   Int?
  createdAt   DateTime @default(now())

  @@unique([roleId, valueStreamId, subStream])
  @@index([roleId])
  @@index([valueStreamId])
}

model ExternalInteraction {
  id                 String  @id @default(cuid())
  tenantId           String
  companyId          String
  company            Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partyType          String
  externalRole       String
  internalRoleId     String?
  internalRole       Role?   @relation(fields: [internalRoleId], references: [id])
  internalRoleOwner  String? // raw owner text (may name multiple roles)
  divisionFunction   String?
  interactionType    String?
  inputs             String?
  outputs            String?
  relatedValueStream String?
  dependencyType     String?
  frequency          String?
  notes              String?

  sourceSheet String?
  sourceRow   Int?
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([internalRoleId])
}

// v15 Scenario Inputs — operating-model change-impact economics. Each row is a
// modeled change (automation, rationalization, control uplift, …) with its
// one-time cost, recurring benefit/added-cost, net impact, and confidence,
// linked to a division + value stream. Real workbook data ("Scenario Inputs").
model Scenario {
  id              String   @id @default(cuid())
  tenantId        String
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  changeType      String? // Automation | Application rationalization | Control uplift | SaaS replacement | Digital enablement
  impactScope     String? // Cross-functional | Finance-led | …
  divisionName    String? // raw; joins to Division by name
  valueStreamName String? // raw; joins to ValueStream by name
  application     String?
  roleImpact      String?
  oneTimeCost     Float?
  annualBenefit   Float?
  annualAddedCost Float?
  annualNetImpact Float?
  confidence      String? // High | Medium | Low

  sourceSheet String?
  sourceRow   Int?
  createdAt   DateTime @default(now())

  @@index([companyId])
}

// ─── Audit log (reusable infra, carried from Cascade) ───────────────────

model AuditEntry {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  entityType String
  entityId   String
  action     String
  actorEmail String
  diff       String? // JSON
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// ─── Systems & metrics (illustrative — the "Where" and "How well" lenses) ──
// Synthesized data, flagged `illustrative`, until real systems/metrics arrive
// via the Phase 8 connector framework.

model Application {
  id           String  @id @default(cuid())
  tenantId     String
  companyId    String
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  kind         String  @default("Internal") // Core | SaaS | Internal | External | Platform
  category     String? // Policy | Claims | Billing | Distribution | Data | Finance | Security | Infra
  vendor       String?
  criticality  String  @default("Medium") // High | Medium | Low
  description  String?
  illustrative Boolean @default(true)
  // v15 Application TCO fields (null for illustrative apps; populated for the 6 real apps)
  ownershipModel      String? // Hybrid | In-house | SaaS
  primaryDivisionName String? // raw string from TCO sheet; joins to Division by name
  licenseCost         Float?  // License / Subscription
  laborCost           Float?  // Internal Labor
  vendorServicesCost  Float?  // Vendor Services
  infraCost           Float?  // Infrastructure / Platform
  depreciationCost    Float?  // Depreciation / Amortization
  overheadCost        Float?  // Allocated Overhead
  totalTco            Float?  // Total Annual TCO
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  valueStreamLinks ApplicationValueStream[]

  @@unique([tenantId, companyId, name])
  @@index([companyId])
}

model ApplicationValueStream {
  id            String      @id @default(cuid())
  tenantId      String
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  valueStreamId String
  valueStream   ValueStream @relation(fields: [valueStreamId], references: [id], onDelete: Cascade)
  systemRole    String      @default("Supporting") // System of Record | Supporting | Channel | Analytics
  illustrative  Boolean     @default(true)
  createdAt     DateTime    @default(now())

  @@unique([applicationId, valueStreamId])
  @@index([applicationId])
  @@index([valueStreamId])
}

// Value-stream KPI. v13 supplies a real DEFINITION (category, formula, target
// text, owner, framework); `value` is an illustrative current actual plotted
// against the parsed numeric `target` (so the definition is real, the reading
// is synthesized → illustrative=true).
model Metric {
  id            String       @id @default(cuid())
  tenantId      String
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  valueStreamId String?
  valueStream   ValueStream? @relation(fields: [valueStreamId], references: [id], onDelete: Cascade)
  l3            String? // process area the KPI measures
  category      String? // Financial | Operational | Quality | DORA | …
  name          String
  description   String?
  formula       String?
  targetText    String? // raw target/benchmark, e.g. "30-45 days", ">99%"
  measurementLevel String?
  frequency     String?
  ownerRole     String?
  framework     String?
  notes         String?
  value         Float
  unit          String // % | days | /mo | score
  target        Float?
  direction     String  @default("up") // up = higher is better, down = lower is better
  illustrative  Boolean @default(true)
  createdAt     DateTime @default(now())

  @@index([companyId])
  @@index([valueStreamId])
}

// v13 E2E process flow — sequenced steps for a value stream (optionally scoped
// to an L3 process area / L4 sub-process). The "how the work flows" axis.
model ProcessStep {
  id                   String      @id @default(cuid())
  tenantId             String
  valueStreamId        String
  valueStream          ValueStream @relation(fields: [valueStreamId], references: [id], onDelete: Cascade)
  l3                   String?
  l4                   String?
  stepNumber           Int
  name                 String
  description          String?
  leads                String?
  supporting           String?
  inputs               String?
  outputs              String?
  notes                String?
  externalParticipants String?
  illustrative         Boolean     @default(false)
  createdAt            DateTime    @default(now())

  @@index([valueStreamId])
  @@index([valueStreamId, stepNumber])
}

// v13 Inputs/Outputs/Deliverables inventory + their data elements.
model IoItem {
  id            String      @id @default(cuid())
  tenantId      String
  valueStreamId String
  valueStream   ValueStream @relation(fields: [valueStreamId], references: [id], onDelete: Cascade)
  l3            String?
  l4            String?
  type          String // Input | Output | Deliverable
  name          String
  keyRoles      String?
  dataElements  String?
  illustrative  Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([valueStreamId])
  @@index([valueStreamId, type])
}

// v13 department standards index (count, charter, owner) — governance signal.
// `count` is the number of individual StandardItem rows in the area; `mission`
// and `scope` come from the per-department Standards sheet's charter block.
model Standard {
  id              String   @id @default(cuid())
  tenantId        String
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department      String
  count           Int      @default(0)
  charterIncluded Boolean  @default(false)
  owner           String?
  link            String?
  mission         String?
  scope           String? // newline-joined scope bullets from the charter block
  illustrative    Boolean  @default(false)
  createdAt       DateTime @default(now())

  items           StandardItem[]

  @@index([companyId])
}

// Individual standard / guideline within a department standards area. Real,
// authored data from the workbook's per-department Standards sheets. `ownerRole`
// is the accountable role as written; `ownerRoleId` resolves it to a roster Role
// when one matches (left null otherwise — the raw text still displays).
model StandardItem {
  id              String   @id @default(cuid())
  tenantId        String
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  standardId      String
  standard        Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  category        String // grouping within the area, e.g. "Encryption"
  name            String // the standard / guideline title
  description     String
  buildRun        String? // Build | Run | Build/Run — lifecycle phase it applies in
  ownerRole       String? // accountable role, raw text from the sheet
  ownerRoleId     String?
  ownerRoleRef    Role?    @relation("StandardItemOwner", fields: [ownerRoleId], references: [id])
  relatedRole     String? // "Related Items (Role)" cross-reference
  relatedCategory String? // "Related Items (Category)" cross-reference
  itemsLink       String? // pointer back into the workbook Items sheet
  // Regulatory-compliance traceability (e.g. the GDPR/CCPA/NYDFS packs):
  agentSkill           String? // the SDLC agent skill that enforces this standard (e.g. "gdpr-sdlc-compliance")
  sdlcGates            String? // SDLC phases the standard applies at, e.g. "Requirements; Design"
  regCitation          String? // regulatory article/section reference, e.g. "Art. 6; Art. 5(1)(a)"
  appliesToValueStreams String? // value streams the standard applies to (raw, "; "-joined)
  sourceRow       Int?
  createdAt       DateTime @default(now())

  @@index([companyId])
  @@index([standardId])
  @@index([ownerRoleId])
}

// ─── Initiatives / People / Tasks / Risks (illustrative) ────────────────
// Transformation initiatives, the people (employees + contractors) who staff
// roles, their live tasks + performance metrics, and first-class risks. All
// synthesized for now (illustrative=true); replaced by real/authored/connected
// data in later phases. These power the deep levels of the explorer drill.

model Initiative {
  id            String   @id @default(cuid())
  tenantId      String
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  code          String?
  description   String?
  status        String   @default("In Progress") // Proposed | In Progress | On Hold | Delivered | Cancelled
  stage         String? // Discovery | Build | Pilot | Rollout | BAU
  health        String   @default("Green") // Green | Amber | Red
  sponsorRoleId String?
  sponsorRole   Role?    @relation("InitiativeSponsor", fields: [sponsorRoleId], references: [id])
  budget        Float?
  startDate     DateTime?
  targetDate    DateTime?
  illustrative  Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  valueStreamLinks InitiativeValueStream[]
  divisionLinks    InitiativeDivision[]
  assignments      Assignment[]
  risks            Risk[]

  @@unique([tenantId, companyId, name])
  @@index([companyId])
  @@index([sponsorRoleId])
}

model InitiativeValueStream {
  id            String      @id @default(cuid())
  tenantId      String
  initiativeId  String
  initiative    Initiative  @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  valueStreamId String
  valueStream   ValueStream @relation(fields: [valueStreamId], references: [id], onDelete: Cascade)
  impactType    String      @default("Transforms") // Transforms | Enables | Depends-on
  illustrative  Boolean     @default(true)
  createdAt     DateTime    @default(now())

  @@unique([initiativeId, valueStreamId])
  @@index([initiativeId])
  @@index([valueStreamId])
}

model InitiativeDivision {
  id           String     @id @default(cuid())
  tenantId     String
  initiativeId String
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  divisionId   String
  division     Division   @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  role         String     @default("Sponsoring") // Sponsoring | Contributing | Impacted
  illustrative Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@unique([initiativeId, divisionId])
  @@index([initiativeId])
  @@index([divisionId])
}

model Person {
  id             String   @id @default(cuid())
  tenantId       String
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  employmentType String   @default("badged") // badged | contractor | si_partner
  vendor         String? // set for contractor / si_partner
  location       String?
  region         String? // Onshore | Nearshore | Offshore
  title          String?
  illustrative   Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignments Assignment[]
  tasks       PersonTask[]
  metrics     PersonMetric[]
  signals     PersonSignal[]
  appUsage    PersonAppUsage[]

  @@index([companyId])
  @@index([companyId, employmentType])
}

// Digital-productivity signals for an individual (time online, code activity,
// collaboration). ILLUSTRATIVE: the workbook has no such telemetry, so these are
// synthesized to show how individual activity would surface. Monthly time-series.
model PersonSignal {
  id           String   @id @default(cuid())
  tenantId     String
  personId     String
  person       Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  period       String // YYYY-MM
  name         String // Time online | GitHub activity | Team messages | Focus hours | Meetings
  value        Float
  unit         String // hrs/day | commits/mo | msgs/wk | hrs/wk
  illustrative Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([personId, period, name])
  @@index([personId])
}

// Application usage mix for an individual (the "most used app" signal). One row
// per app, ranked by share of active time. ILLUSTRATIVE.
model PersonAppUsage {
  id           String   @id @default(cuid())
  tenantId     String
  personId     String
  person       Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  appName      String
  category     String? // IDE | Comms | Analytics | Domain | Productivity
  usagePct     Int // share of active time (0–100)
  rank         Int // 1 = most used
  illustrative Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([personId])
}

model Assignment {
  id             String      @id @default(cuid())
  tenantId       String
  personId       String
  person         Person      @relation(fields: [personId], references: [id], onDelete: Cascade)
  roleId         String
  role           Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  initiativeId   String?
  initiative     Initiative? @relation(fields: [initiativeId], references: [id], onDelete: SetNull)
  employmentType String      @default("badged") // denormalized for fast filtering
  allocationPct  Int         @default(100)
  isPrimary      Boolean     @default(true)
  startDate      DateTime?
  endDate        DateTime?
  illustrative   Boolean     @default(true)
  createdAt      DateTime    @default(now())

  tasks PersonTask[]

  @@index([roleId])
  @@index([personId])
  @@index([initiativeId])
  @@index([initiativeId, employmentType])
}

model PersonTask {
  id           String      @id @default(cuid())
  tenantId     String
  personId     String
  person       Person      @relation(fields: [personId], references: [id], onDelete: Cascade)
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  roleTaskId   String?
  roleTask     RoleTask?   @relation(fields: [roleTaskId], references: [id], onDelete: SetNull)
  title        String
  status       String      @default("In Progress") // To Do | In Progress | Blocked | Done
  priority     String      @default("Medium") // High | Medium | Low
  dueDate      DateTime?
  illustrative Boolean     @default(true)
  createdAt    DateTime    @default(now())

  @@index([personId])
  @@index([personId, status])
  @@index([assignmentId])
}

model PersonMetric {
  id           String   @id @default(cuid())
  tenantId     String
  personId     String
  person       Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  period       String // YYYY-MM
  name         String // Throughput | Quality | Utilization | Cycle time
  value        Float
  unit         String // % | /mo | days | score
  target       Float?
  direction    String   @default("up") // up | down
  illustrative Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([personId, period, name])
  @@index([personId])
  @@index([personId, period])
}

model Risk {
  id            String       @id @default(cuid())
  tenantId      String
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  valueStreamId String?
  valueStream   ValueStream? @relation(fields: [valueStreamId], references: [id], onDelete: SetNull)
  initiativeId  String?
  initiative    Initiative?  @relation(fields: [initiativeId], references: [id], onDelete: SetNull)
  ownerRoleId   String?
  ownerRole     Role?        @relation("RiskOwner", fields: [ownerRoleId], references: [id])
  title         String
  category      String       @default("Operational") // Operational | Compliance | Delivery | Security | Financial | Vendor
  severity      String       @default("Medium") // Critical | High | Medium | Low
  likelihood    String       @default("Possible") // Rare | Unlikely | Possible | Likely | Almost Certain
  status        String       @default("Open") // Open | Mitigating | Accepted | Closed
  mitigation    String?
  illustrative  Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([companyId])
  @@index([valueStreamId])
  @@index([initiativeId])
  @@index([ownerRoleId])
}

// ─── "Evergreen" Portfolio Rationalization ("How") ──────────────────────
// Decompose overlapping legacy ("brown-field") applications by business-process
// step AND IT layer, classify each capability as keep vs anti-pattern, normalize
// the overlap (CAPDAN — Common As Possible, Different As Needed) into target
// components, and re-constitute onto a green-field microservice architecture.
// Migration status on every capability/component/microservice rolls up into the
// workspace's progress. All illustrative until real portfolio data arrives.
//
// IT layers are a fixed vocabulary (string, not a table):
//   UI | Integration | Business Service | Data | Infrastructure
// migrationStatus is an ordered vocabulary that drives progress %:
//   Identified | In Analysis | Normalized | In Migration | Migrated | Retired

model RationalizationWorkspace {
  id              String   @id @default(cuid())
  tenantId        String
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  application     String? // the application/platform being rationalized (groups stages into one chevron flow)
  stageOrder      Int      @default(0) // position in the value-stream chevron flow
  businessProcess String? // the value-stream stage / business-process this chevron represents
  description     String?
  northstar       String? // the green-field / Northstar architecture target statement
  valueStreamId   String? // optional link to the value stream this process belongs to
  status          String   @default("In Progress") // Proposed | In Progress | Migrating | Complete
  illustrative    Boolean  @default(true)
  layout          Json? // user-curated board overlay: { positions, addedEdges, removedEdges }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  apps          RationalizationApp[]
  capabilities  RationalizationCapability[]
  components    RationalizationComponent[]
  microservices RationalizationMicroservice[]
  planSteps     RationalizationPlanStep[]

  @@unique([tenantId, companyId, name])
  @@index([companyId])
}

// Brown-field legacy application in a workspace (one grid column).
model RationalizationApp {
  id           String                    @id @default(cuid())
  tenantId     String
  companyId    String
  workspaceId  String
  workspace    RationalizationWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  disposition  String   @default("Refactor") // Retain | Refactor | Replace | Retire
  // Application-specific profile of the legacy system being decomposed.
  techStack    String? // e.g. "C# / .NET Framework 4.7, WCF, SQL Server 2014"
  vendor       String? // COTS vendor / "In-house"
  hosting      String? // On-prem | Private cloud | SaaS | Hybrid
  criticality  String? // High | Medium | Low (business criticality)
  ageYears     Int?    // years in production
  annualCost   Float?  // run cost ($/yr)
  position     Int      @default(0) // left-to-right column order
  illustrative Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  capabilities RationalizationCapability[]

  @@index([companyId])
  @@index([workspaceId])
}

// CAPDAN-normalized target component for one IT layer (one middle-column box).
// Where the kept capabilities across apps re-constitute, and where they land.
model RationalizationComponent {
  id             String                       @id @default(cuid())
  tenantId       String
  companyId      String
  workspaceId    String
  workspace      RationalizationWorkspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  layer          String // UI | Integration | Business Service | Data | Infrastructure
  name           String // e.g. "UI Components / Fields"
  principle      String? // CAPDAN rationale — what is common vs intentionally different
  pattern        String? // target architecture pattern, e.g. "Strangler facade", "CQRS + event sourcing"
  targetTech     String? // target technology, e.g. "React + Module Federation", "Spring Boot + Kafka"
  destination    String? // free-text destination label
  microserviceId String? // green-field microservice it lands in
  microservice   RationalizationMicroservice? @relation(fields: [microserviceId], references: [id], onDelete: SetNull)
  migrationStatus String  @default("Identified")
  illustrative   Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  capabilities RationalizationCapability[]

  @@index([companyId])
  @@index([workspaceId])
  @@index([microserviceId])
}

// A single decomposed capability (one line inside a grid cell). Classified keep
// (Retain) vs anti-pattern (Eliminate); kept ones map to a normalized component.
model RationalizationCapability {
  id              String                     @id @default(cuid())
  tenantId        String
  companyId       String
  workspaceId     String
  workspace       RationalizationWorkspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appId           String
  app             RationalizationApp         @relation(fields: [appId], references: [id], onDelete: Cascade)
  layer           String // current layer: UI | Integration | Business Service | Data | Infrastructure
  name            String // the specific finding (e.g. "Validate premium > 0")
  category        String? // finding group used for the high-level tag, e.g. "Business validations"
  capdan          String   @default("Common") // Common | Different | Relocate | Eliminate (CAPDAN classification)
  targetLayer     String? // when capdan=Relocate: the layer this finding belongs in (drives the relocation line)
  treatment       String   @default("Retain") // Retain (keep) | Eliminate (anti-pattern) — derived from capdan
  migrationStatus String   @default("Identified")
  componentId     String? // normalized target component it folds into (kept capabilities)
  component       RationalizationComponent?  @relation(fields: [componentId], references: [id], onDelete: SetNull)
  // Application-specific decomposition detail.
  codeRef         String? // the specific code identified, e.g. "PolicyForm.aspx.cs : ValidatePremium()"
  migrationApproach String? // how this finding is migrated / normalized
  targetTech      String? // where/how it is rebuilt, e.g. "Drools rules service"
  rationale       String? // why keep / why eliminate (the application-specific reason)
  effort          String? // S | M | L | XL (rebuild/decommission effort)
  complexity      String? // Low | Medium | High
  notes           String?
  illustrative    Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId])
  @@index([workspaceId])
  @@index([appId])
  @@index([componentId])
}

// Green-field target microservice / application (one right-column box).
model RationalizationMicroservice {
  id           String                     @id @default(cuid())
  tenantId     String
  companyId    String
  workspaceId  String
  workspace    RationalizationWorkspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  kind         String   @default("Microservice") // Microservice | Application
  description  String?
  status       String   @default("Planned") // Planned | Building | Live
  techStack    String? // target runtime/stack, e.g. "Java 21 / Spring Boot, Postgres, Kafka"
  ownerRole    String? // owning team / role
  repo         String? // source repository / service slug
  position     Int      @default(0)
  illustrative Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  components RationalizationComponent[]

  @@index([companyId])
  @@index([workspaceId])
}

// Migration plan — a sequenced wave/step in re-constituting the business process
// onto the green-field architecture. Gives each initiative an actual roadmap
// (deliverables, owner, target window, dependencies) with its own status that
// rolls up alongside the capability-level progress.
model RationalizationPlanStep {
  id           String                   @id @default(cuid())
  tenantId     String
  companyId    String
  workspaceId  String
  workspace    RationalizationWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  wave         Int      @default(1) // grouping (Wave 1, 2, 3 …)
  sequence     Int      @default(0) // order within the plan
  name         String
  description  String?
  layer        String? // optional IT-layer focus (UI | Integration | …)
  status       String   @default("Not Started") // Not Started | In Progress | Done | Blocked
  ownerRole    String?
  targetWindow String? // e.g. "Q3 2026"
  effortWeeks  Int?
  dependsOn    String? // free-text dependency / predecessor
  deliverables String? // what ships at the end of this step
  illustrative Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
  @@index([workspaceId])
  @@index([workspaceId, wave, sequence])
}

// ─── Initiative Tracker (strategic-portfolio management) ─────────────────
// A self-contained SPM tracker carried over from the Cascade app, surfaced in
// its own "Initiatives" tab. Hierarchy: Program → Workstream → PortfolioInitiative
// (named to avoid colliding with the operating-model `Initiative` above). Each
// initiative carries a stage-gate workflow (IDEA→PLAN→EXECUTE→REALIZE→COMPLETE),
// time-phased benefit/cost lines (monthly MetricValue rows keyed by dataset),
// milestones, and a RAID log. It integrates with the operating model through
// optional scalar links (valueStreamId / divisionId / owner+sponsor roleId);
// those FKs are enforced at the DB level (see the migration) but are NOT modeled
// as Prisma relations, so no existing model is touched. Every write is recorded
// in the shared AuditEntry log. Scoped to tenant + company.

model Program {
  id          String   @id @default(cuid())
  tenantId    String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  status      String   @default("ON_TRACK") // ON_TRACK | AT_RISK | OFF_TRACK
  statusNote  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workstreams Workstream[]

  @@index([companyId])
}

model Workstream {
  id          String   @id @default(cuid())
  tenantId    String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  programId   String
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      String   @default("ON_TRACK")
  statusNote  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  initiatives PortfolioInitiative[]

  @@index([companyId])
  @@index([programId])
}

model PortfolioInitiative {
  id             String     @id @default(cuid())
  tenantId       String
  companyId      String
  company        Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workstreamId   String
  workstream     Workstream @relation(fields: [workstreamId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  // Stage-gate workflow
  stage          String     @default("IDEA") // IDEA | PLAN | EXECUTE | REALIZE | COMPLETE
  workflowAction String? // SUBMIT (pending approval) | null
  state          String     @default("PLANNING") // PLANNING | ACTIVE | DONE
  status         String     @default("ON_TRACK") // ON_TRACK | AT_RISK | OFF_TRACK
  statusNote     String?
  startDate      DateTime
  dueDate        DateTime
  // Operating-model integration — optional scalar FKs (constraints in the migration).
  valueStreamId  String?
  divisionId     String?
  ownerRoleId    String?
  sponsorRoleId  String?
  // Denormalized rollups, refreshed by the rollup service after benefit/cost writes.
  cumulativeBenefit    Float @default(0)
  cumulativeCost       Float @default(0)
  cumulativeNetBenefit Float @default(0)
  // Charter / prioritization inputs (I3/I4): complexity is authored, value
  // score is recomputed from the objective links' impact levels.
  complexityScore Float @default(5)
  valueScore      Float @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  objectives InitiativeObjective[]
  resources  InitiativeResource[]
  activities WorkplanActivity[]
  benefits   BenefitLine[]
  costs      CostLine[]
  milestones Milestone[]
  raidItems  RaidItem[]

  @@index([companyId])
  @@index([workstreamId])
  @@index([valueStreamId])
  @@index([divisionId])
}

model BenefitLine {
  id           String              @id @default(cuid())
  initiativeId String
  initiative   PortfolioInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  name         String
  category     String? // e.g. Cost Savings, Revenue Uplift, Cost Avoidance
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime            @default(now())

  values MetricValue[]

  @@index([initiativeId])
}

model CostLine {
  id           String              @id @default(cuid())
  initiativeId String
  initiative   PortfolioInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  name         String
  category     String? // OPEX | CAPEX | Resource | Vendor
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime            @default(now())

  values MetricValue[]

  @@index([initiativeId])
}

// Time-phased monthly value. Either benefitLineId OR costLineId is set (sparse FK).
model MetricValue {
  id            String       @id @default(cuid())
  benefitLineId String?
  costLineId    String?
  benefitLine   BenefitLine? @relation(fields: [benefitLineId], references: [id], onDelete: Cascade)
  costLine      CostLine?    @relation(fields: [costLineId], references: [id], onDelete: Cascade)
  dataset       String // ACTUAL | TARGET | FORECAST
  periodStart   DateTime // first day of the month
  amount        Float

  @@index([benefitLineId, dataset, periodStart])
  @@index([costLineId, dataset, periodStart])
}

// Risk-scoring bands: how a 5×5 probability×impact score (1–25) reads as a
// rating. Data, not code — editable in Data Admin → Initiatives.
model RiskScoringBand {
  id          String   @id @default(cuid())
  tenantId    String
  companyId   String
  label       String
  minScore    Int
  maxScore    Int
  color       String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([companyId])
}

// ── Initiative-tracker extensions (gap backlog I3/I4/I6/I9) ─────────────────

// Strategic objectives the portfolio aligns to (I3). Company-scoped via scalar.
model StrategicObjective {
  id          String   @id @default(cuid())
  tenantId    String
  companyId   String
  name        String
  description String?
  weight      Float    @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  links InitiativeObjective[]

  @@index([companyId])
}

// Level-of-impact M2M between initiatives and objectives — drives valueScore.
model InitiativeObjective {
  id           String              @id @default(cuid())
  initiativeId String
  initiative   PortfolioInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  objectiveId  String
  objective    StrategicObjective  @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  impact       Int                 @default(3) // 1–5 level of impact
  createdAt    DateTime            @default(now())

  @@unique([initiativeId, objectiveId])
}

// Resource demand on an initiative (I6): a named person or an unnamed role.
model InitiativeResource {
  id            String              @id @default(cuid())
  initiativeId  String
  initiative    PortfolioInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  personId      String?
  roleName      String?
  name          String
  allocationPct Int                 @default(50)
  startDate     DateTime
  endDate       DateTime
  createdAt     DateTime            @default(now())

  @@index([initiativeId])
}

// Workplan activity (I9): a dated bar on the initiative timeline; optional
// finish-to-start dependency on another activity.
model WorkplanActivity {
  id           String              @id @default(cuid())
  initiativeId String
  initiative   PortfolioInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  name         String
  startDate    DateTime
  endDate      DateTime
  status       String              @default("PLANNED") // PLANNED | IN_PROGRESS | DONE
  dependsOnId  String?
  dependsOn    WorkplanActivity?   @relation("ActivityDep", fields: [dependsOnId], references: [id], onDelete: SetNull)
  dependents   WorkplanActivity[]  @relation("ActivityDep")
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now())

  @@index([initiativeId])
}

model Milestone {
  id           String              @id @default(cuid())
  initiativeId String
  initiative   PortfolioInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  name         String
  dueDate      DateTime
  completedAt  DateTime?
  isGate       Boolean             @default(false) // stage-gate milestone?
  status       String              @default("PENDING") // PENDING | DONE | MISSED
  createdAt    DateTime            @default(now())

  @@index([initiativeId])
}

model RaidItem {
  id           String              @id @default(cuid())
  initiativeId String
  initiative   PortfolioInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  type         String // RISK | ASSUMPTION | ISSUE | DECISION
  title        String
  description  String?
  probability  Int                 @default(3) // 1–5 (risks)
  impact       Int                 @default(3) // 1–5
  severity     Int                 @default(9) // probability * impact
  mitigation   String?
  status       String              @default("OPEN") // OPEN | MITIGATED | CLOSED
  ownerRoleId  String? // optional link to an operating-model Role (constraint in migration)
  dueDate      DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([initiativeId])
}

// ─── Deliverables & Tasks (work tracker) ─────────────────────────────────
// A lightweight, standalone work tracker surfaced in its own "Deliverables &
// Tasks" tab. A Deliverable is a tangible output (document, system, report …);
// a Task is a unit of work, optionally rolling up to a Deliverable. Both are
// scoped to tenant + company and may link to an operating-model ValueStream
// (DB-level FK with ON DELETE SET NULL, declared in the migration — not modeled
// as a Prisma relation, so no existing model is touched). Illustrative demo data.

model Deliverable {
  id            String   @id @default(cuid())
  tenantId      String
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  owner         String? // free-text owner / accountable role
  type          String   @default("Document") // Document | System | Report | Process | Model | Other
  status        String   @default("Not Started") // Not Started | In Progress | At Risk | Done
  valueStreamId String? // optional link to an operating-model ValueStream (constraint in migration)
  dueDate       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tasks Task[]

  @@index([companyId])
  @@index([valueStreamId])
}

model Task {
  id            String       @id @default(cuid())
  tenantId      String
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deliverableId String?
  deliverable   Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  title         String
  owner         String? // free-text assignee
  status        String       @default("To Do") // To Do | In Progress | Blocked | Done
  priority      String       @default("Medium") // High | Medium | Low
  source        String       @default("process") // process (L5 step) | role (role responsibility)
  dueDate       DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([companyId])
  @@index([deliverableId])
  @@index([status])
}

// ─── Unified operating-model graph (rework) ──────────────────────────────────
// See docs/operating-model-architecture.md. One typed-node tree + a link layer
// replaces Level/OrgLevel/Division/Department/Role/ValueStream/SubValueStream/
// ValueStreamDomain. Built additively alongside the legacy tables during migration.

// Taxonomy: what the levels are CALLED + their branching rules — data, not code.
model NodeType {
  id          String   @id @default(cuid())
  tenantId    String
  dimension   String   @default("STRUCTURE")
  key         String // segment | division | department | role | value_stream | sub_process | step | io_item | external_party
  label       String
  pluralLabel String
  level       Int
  parentKeys  String[] @default([]) // node-type keys allowed as parent (branching)
  icon        String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, key])
}

// One row per structural concept. "Core Business" is ONE Node; everything points
// at it by id. provenance: real | illustrative | imported.
model Node {
  id          String     @id @default(cuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  typeKey     String // → NodeType.key (the level + label)
  parentId    String?
  parent      Node?      @relation("NodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Node[]     @relation("NodeTree")
  name        String
  code        String? // original legacy id / external code (backfill provenance)
  description String?
  sortOrder   Int        @default(0)
  provenance  String     @default("illustrative")
  attributes  Json?
  aiAdoption  NodeAiAdoption?
  outLinks    NodeLink[] @relation("NodeLinkFrom")
  inLinks     NodeLink[] @relation("NodeLinkTo")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([companyId, typeKey])
  @@index([parentId])
}

// Cross-cutting typed edges (the "web"): role↔value-stream, app↔value-stream,
// step→deliverable, owned-by, etc. The default + extension point; rich, hot-path
// links also keep their typed junctions (hybrid).
model NodeLink {
  id           String   @id @default(cuid())
  companyId    String
  fromId       String
  from         Node     @relation("NodeLinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId         String
  to           Node     @relation("NodeLinkTo", fields: [toId], references: [id], onDelete: Cascade)
  relationType String // PARTICIPATES_IN | SUPPORTS | OWNS | LEADS | PRODUCES | CONSUMES | IMPACTS | REPORTS_TO | ...
  attributes   Json?
  createdAt    DateTime @default(now())

  @@unique([fromId, toId, relationType])
  @@index([toId, relationType])
  @@index([companyId, relationType])
}

// AI-adoption per value_stream NODE (replaces LevelAiAdoption as the editable
// store; the Level-keyed table remains only as a retired legacy copy).
model NodeAiAdoption {
  id           String   @id @default(cuid())
  nodeId       String   @unique
  node         Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  aiAssist     String   @default("not_used")
  aiAugment    String   @default("not_used")
  aiWorkflow   String   @default("not_used")
  aiAutonomous String   @default("not_used")
  useCases     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
