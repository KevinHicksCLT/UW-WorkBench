// Strata — Operating-Model Data Spine (Phase 1)
// One governed model of a company's operating model:
//   Company → Division → Department → Role
//   ValueStream → SubValueStream (L3→L4 self-relation)
//   Role ↔ ValueStream (participation), Role → ChecklistItem / RoleTask,
//   Category, ExternalInteraction.
// Seeded from IT_Roles_Analytics_v12.xlsx. Every spine record carries inline
// provenance (sourceSheet/sourceRow) back to the workbook.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Tenancy & Identity (reusable infra, carried from Cascade) ──────────

model Tenant {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  createdAt    DateTime     @default(now())
  users        User[]
  companies    Company[]
  auditEntries AuditEntry[]
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  email     String   @unique
  name      String
  password  String // bcrypt hash
  role      String   @default("MEMBER") // ADMIN | MANAGER | MEMBER | VIEWER
  createdAt DateTime @default(now())
}

// ─── Operating-model spine ──────────────────────────────────────────────

model Company {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  divisions            Division[]
  departments          Department[]
  roles                Role[]
  categories           Category[]
  valueStreams         ValueStream[]
  externalInteractions ExternalInteraction[]

  @@unique([tenantId, slug])
}

model Division {
  id        String  @id @default(cuid())
  tenantId  String
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code      String
  name      String

  sourceSheet String?
  sourceRow   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  departments Department[]
  roles       Role[]

  @@unique([tenantId, companyId, name])
  @@index([companyId])
}

model Department {
  id         String   @id @default(cuid())
  tenantId   String
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  name       String

  sourceSheet String?
  sourceRow   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles Role[]

  @@unique([divisionId, name])
  @@index([companyId])
  @@index([divisionId])
}

model Role {
  id           String      @id @default(cuid())
  tenantId     String
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  divisionId   String?
  division     Division?   @relation(fields: [divisionId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  name         String // canonical display name
  itemRole     String? // name used by the Items / Aligned Role Tasks sheets (join key)
  roleFamily   String?
  sourceSheet  String?
  sourceRow    Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  checklistItems       ChecklistItem[]
  roleTasks            RoleTask[]
  valueStreamLinks     RoleValueStream[]
  externalInteractions ExternalInteraction[]

  @@unique([tenantId, companyId, name])
  @@index([companyId])
  @@index([departmentId])
}

model Category {
  id        String   @id @default(cuid())
  tenantId  String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  checklistItems ChecklistItem[]
  roleTasks      RoleTask[]

  @@unique([tenantId, companyId, name])
  @@index([companyId])
}

model ValueStream {
  id        String  @id @default(cuid())
  tenantId  String
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  domain    String?

  sourceSheet String?
  sourceRow   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subStreams SubValueStream[]
  roleLinks  RoleValueStream[]

  @@unique([tenantId, companyId, name])
  @@index([companyId])
}

// L3 (Process Area) and L4 (Sub-Process) nodes. L4 nodes point at their L3
// parent via parentId (self-relation), queried by recursive CTE.
model SubValueStream {
  id            String           @id @default(cuid())
  tenantId      String
  valueStreamId String
  valueStream   ValueStream      @relation(fields: [valueStreamId], references: [id], onDelete: Cascade)
  parentId      String?
  parent        SubValueStream?  @relation("SubStreamTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      SubValueStream[] @relation("SubStreamTree")
  level         Int // 3 = Process Area, 4 = Sub-Process
  name          String
  inputs        String?
  outputs       String?
  upstream      String?
  downstream    String?
  notes         String?

  sourceSheet String?
  sourceRow   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([valueStreamId, parentId, name])
  @@index([valueStreamId])
  @@index([parentId])
}

model ChecklistItem {
  id         String    @id @default(cuid())
  tenantId   String
  roleId     String
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  text       String
  crossRole  Boolean   @default(false)

  sourceSheet String?
  sourceRow   Int?
  createdAt   DateTime @default(now())

  @@index([roleId])
  @@index([categoryId])
}

model RoleTask {
  id         String    @id @default(cuid())
  tenantId   String
  roleId     String
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  text       String

  sourceSheet String?
  sourceRow   Int?
  createdAt   DateTime @default(now())

  @@index([roleId])
  @@index([categoryId])
}

// Role ↔ ValueStream participation (one row per role/stream/sub-stream).
model RoleValueStream {
  id                String      @id @default(cuid())
  tenantId          String
  roleId            String
  role              Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  valueStreamId     String
  valueStream       ValueStream @relation(fields: [valueStreamId], references: [id], onDelete: Cascade)
  subStream         String?
  participationType String // Lead | Core | Support | Oversight | Control
  inputs            String?
  outputs           String?
  upstream          String?
  downstream        String?
  notes             String?

  sourceSheet String?
  sourceRow   Int?
  createdAt   DateTime @default(now())

  @@unique([roleId, valueStreamId, subStream])
  @@index([roleId])
  @@index([valueStreamId])
}

model ExternalInteraction {
  id                 String  @id @default(cuid())
  tenantId           String
  companyId          String
  company            Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partyType          String
  externalRole       String
  internalRoleId     String?
  internalRole       Role?   @relation(fields: [internalRoleId], references: [id])
  internalRoleOwner  String? // raw owner text (may name multiple roles)
  divisionFunction   String?
  interactionType    String?
  inputs             String?
  outputs            String?
  relatedValueStream String?
  dependencyType     String?
  frequency          String?
  notes              String?

  sourceSheet String?
  sourceRow   Int?
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([internalRoleId])
}

// ─── Audit log (reusable infra, carried from Cascade) ───────────────────

model AuditEntry {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  entityType String
  entityId   String
  action     String
  actorEmail String
  diff       String? // JSON
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}
