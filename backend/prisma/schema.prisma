// Strata / Cascade — Operating-Model Data Spine (erd_v5)
// Clean generic typed-graph. Org spine (OrgLevelType → OrgUnit → Role) and the
// value-stream spine (ProcessLevelType → ProcessNode) are both level-typed,
// recursive, and closure-backed. Named spine entities carry dbValue (canonical
// system name) + displayValue (admin-editable label); catalog entities carry one
// canonical name and relabel via the Terminology override table. Junctions get a
// surrogate id PLUS a @@unique on the natural key. Peripheral modules (Portfolio,
// Regulations, Rationalization, Scenario, Telemetry, AI-adoption) are re-modeled
// in the same style with their operating-model links as real FK relations.
// Implements documents/value-streams/Master Documentation/erd_v5.mmd.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Tenancy & Identity (reusable infra) ────────────────────────────────

model Tenant {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  createdAt    DateTime     @default(now())
  users        User[]
  companies    Company[]
  auditEntries AuditEntry[]
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  email     String   @unique
  name      String
  password  String // bcrypt hash
  role      String   @default("MEMBER") // ADMIN | MANAGER | MEMBER | VIEWER
  createdAt DateTime @default(now())
}

// ─── Company ────────────────────────────────────────────────────────────

model Company {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  slug         String
  // Named-spine convention: dbValue = canonical system name, displayValue = label.
  dbValue      String?
  displayValue String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Home-dashboard layout chosen in Data Admin → Home. Shape: { widgets: string[] }.
  dashboardConfig Json?

  // Org spine
  orgLevelTypes             OrgLevelType[]
  orgUnits                  OrgUnit[]
  roles                     Role[]
  // Value-stream spine
  processLevelTypes         ProcessLevelType[]
  processNodes              ProcessNode[]
  // Work & control
  deliverables              Deliverable[]
  checklists                Checklist[]
  standards                 Standard[]
  applications              Application[]
  workTemplates             WorkTemplate[]
  integrationSources        IntegrationSource[]
  // Initiative & metric
  initiatives               Initiative[]
  metrics                   Metric[]
  // External parties / agent enablement
  externalParties           ExternalParty[]
  knowledgeBases            KnowledgeBase[]
  skillFiles                SkillFile[]
  // Admin & cross-cutting
  terminology               Terminology[]
  // Portfolio SPM
  programs                  Program[]
  workstreams               Workstream[]
  portfolioInitiatives      PortfolioInitiative[]
  strategicObjectives       StrategicObjective[]
  riskScoringBands          RiskScoringBand[]
  // Regulations
  jurisdictions             Jurisdiction[]
  integrationSystems        IntegrationSystem[]
  regulatoryRequirements    RegulatoryRequirement[]
  regulatoryBulletins       RegulatoryBulletin[]
  complianceRules           ComplianceRule[]
  regulatorySources         RegulatorySource[]
  // App Rationalization
  rationalizationWorkspaces RationalizationWorkspace[]
  // Scenario / telemetry / analysis
  scenarios                 Scenario[]
  telemetrySignals          TelemetrySignal[]
  analysisStatuses          AnalysisStatus[]

  @@unique([tenantId, slug])
}

// ─── ORG SPINE (generic, level-typed) ───────────────────────────────────

model OrgLevelType {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  levelNumber  Int
  dbValue      String // "L1 L2 L3 ..."
  displayValue String // EDITABLE: Division, Department, Team ...
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orgUnits OrgUnit[]

  @@unique([companyId, levelNumber])
  @@index([companyId])
}

model OrgUnit {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orgLevelTypeId String
  orgLevelType   OrgLevelType @relation(fields: [orgLevelTypeId], references: [id])
  parentId       String?
  parent         OrgUnit?     @relation("OrgUnitTree", fields: [parentId], references: [id])
  children       OrgUnit[]    @relation("OrgUnitTree")
  dbValue        String
  displayValue   String // EDITABLE label
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Closure (both directions)
  ancestorEdges   OrgUnitClosure[] @relation("OrgUnitClosureAncestor")
  descendantEdges OrgUnitClosure[] @relation("OrgUnitClosureDescendant")

  // Things scoped to / homed at this org unit
  roles                Role[]
  roleAssignments      RoleOrgAssignment[]
  applications         Application[]
  metrics              Metric[]
  portfolioInitiatives PortfolioInitiative[]
  scenarios            Scenario[]

  @@index([companyId, orgLevelTypeId])
  @@index([parentId])
}

// DERIVED — fast subtree (move-with-children, rollups).
model OrgUnitClosure {
  ancestorId   String
  ancestor     OrgUnit @relation("OrgUnitClosureAncestor", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendantId String
  descendant   OrgUnit @relation("OrgUnitClosureDescendant", fields: [descendantId], references: [id], onDelete: Cascade)
  depth        Int

  @@id([ancestorId, descendantId])
  @@index([descendantId, depth])
  @@index([ancestorId, depth])
}

model Role {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orgUnitId     String? // primary home
  orgUnit       OrgUnit? @relation(fields: [orgUnitId], references: [id])
  managerRoleId String? // SOLID-LINE manager (the role this role reports to)
  manager       Role?    @relation("RoleReports", fields: [managerRoleId], references: [id])
  reports       Role[]   @relation("RoleReports")
  roleType      String? // Approver | Reviewer | Contributor — governance classification (Roles tab)
  dbValue       String
  displayValue  String // EDITABLE label
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orgAssignments                RoleOrgAssignment[]
  checklistItems                ChecklistItem[]
  roleDeliverables              RoleDeliverable[]
  nodeRoles                     NodeRole[]
  roleStandards                 RoleStandard[]
  roleRegulations               RoleRegulation[]
  ownedStandards                Standard[]                   @relation("StandardOwnerRole")
  externalInteractions          ExternalInteraction[]
  metrics                       Metric[]
  auditEntries                  AuditEntry[]
  // Portfolio links
  ownedPortfolioInitiatives     PortfolioInitiative[]         @relation("PortfolioInitiativeOwner")
  sponsoredPortfolioInitiatives PortfolioInitiative[]         @relation("PortfolioInitiativeSponsor")
  raidItems                     RaidItem[]
  initiativeResources           InitiativeResource[]
  rationalizationMicroservices  RationalizationMicroservice[] @relation("RationalizationMicroserviceOwner")
  rationalizationPlanSteps      RationalizationPlanStep[]     @relation("RationalizationPlanStepOwner")
  // Work Library entity-typed values pointing at this role
  nodeTemplateAnswers           NodeTemplateAnswer[]
  standardTemplateAnswers       StandardTemplateAnswer[]
  regulationTemplateAnswers     RegulationTemplateAnswer[]
  nodeStandardEvidences         NodeStandardEvidence[]
  nodeRegulationEvidences       NodeRegulationEvidence[]

  @@unique([companyId, dbValue])
  @@index([companyId])
  @@index([orgUnitId])
  @@index([managerRoleId])
}

// NEW — role at multiple levels (M:N).
model RoleOrgAssignment {
  id        String  @id @default(cuid())
  roleId    String
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  orgUnitId String
  orgUnit   OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  isPrimary Boolean @default(false)

  @@unique([roleId, orgUnitId])
  @@index([roleId])
  @@index([orgUnitId])
}

// ─── VALUE-STREAM SPINE (generic recursive) ─────────────────────────────

model ProcessLevelType {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  levelNumber  Int
  dbValue      String // "L1 L2 L3 L4 L5"
  displayValue String // EDITABLE: Domain, Value Stream, Process, Step
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  processNodes ProcessNode[]

  @@unique([companyId, levelNumber])
  @@index([companyId])
}

// VALUE STREAM = ProcessNode at L2; L5/isTask = Task.
model ProcessNode {
  id                 String           @id @default(cuid())
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  processLevelTypeId String
  processLevelType   ProcessLevelType @relation(fields: [processLevelTypeId], references: [id])
  parentId           String?
  parent             ProcessNode?     @relation("ProcessNodeTree", fields: [parentId], references: [id])
  children           ProcessNode[]    @relation("ProcessNodeTree")
  dbValue            String
  displayValue       String // EDITABLE label
  description        String? // atomic task: what is done / definition of done
  isTask             Boolean          @default(false)
  automatability     String? // manual | augmented | automated
  sortOrder          Int              @default(0)
  code               String?
  attributes         Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Closure (both directions)
  ancestorEdges   ProcessNodeClosure[] @relation("ProcessNodeClosureAncestor")
  descendantEdges ProcessNodeClosure[] @relation("ProcessNodeClosureDescendant")

  // Junctions / links off a process node
  nodeDeliverables          NodeDeliverable[]
  nodeRoles                 NodeRole[]
  nodeRegulations           NodeRegulation[]
  nodeStandards             NodeStandard[]
  nodeAppUsages             NodeAppUsage[]
  nodeChecklists            NodeChecklist[]
  nodeInitiatives           NodeInitiative[]
  testingTemplates          TestingTemplate[] // task-level (secondary tie)
  nodeWorkTemplates         NodeWorkTemplate[]
  nodeTemplateAnswers       NodeTemplateAnswer[]
  nodeStandardEvidences     NodeStandardEvidence[]
  nodeRegulationEvidences   NodeRegulationEvidence[]
  metrics                   Metric[]
  externalInteractions      ExternalInteraction[]
  agentSkills               AgentSkill[]
  auditEntries              AuditEntry[]
  aiAdoption                NodeAiAdoption?
  // Portfolio / peripheral links
  portfolioInitiatives      PortfolioInitiative[]
  scenarios                 Scenario[]
  rationalizationWorkspaces RationalizationWorkspace[]

  @@index([companyId, processLevelTypeId])
  @@index([parentId])
}

// DERIVED — fast subtree (move-with-children, rollups).
model ProcessNodeClosure {
  ancestorId   String
  ancestor     ProcessNode @relation("ProcessNodeClosureAncestor", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendantId String
  descendant   ProcessNode @relation("ProcessNodeClosureDescendant", fields: [descendantId], references: [id], onDelete: Cascade)
  depth        Int

  @@id([ancestorId, descendantId])
  @@index([descendantId, depth])
  @@index([ancestorId, depth])
}

// ─── WORK & CONTROL ENTITIES ────────────────────────────────────────────

model Deliverable {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title          String
  description    String? // what single artifact this deliverable is (atomic)
  automatability String? // manual | augmented | automated
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  nodeDeliverables          NodeDeliverable[]
  roleDeliverables          RoleDeliverable[]
  testingTemplates          TestingTemplate[]
  standardDeliverables      StandardDeliverable[]
  regulationDeliverables    RegulationDeliverable[]
  nodeTemplateAnswers       NodeTemplateAnswer[]
  standardTemplateAnswers   StandardTemplateAnswer[]
  regulationTemplateAnswers RegulationTemplateAnswer[]
  nodeStandardEvidences     NodeStandardEvidence[]
  nodeRegulationEvidences   NodeRegulationEvidence[]

  @@index([companyId])
}

// Group over items (codified manual checklist).
model Checklist {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ChecklistItem[]

  @@index([companyId])
}

model ChecklistItem {
  id          String    @id @default(cuid())
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  roleId      String?
  role        Role?     @relation(fields: [roleId], references: [id])
  text        String
  createdAt   DateTime  @default(now())

  nodeChecklists NodeChecklist[]

  @@index([checklistId])
  @@index([roleId])
}

// CHANGED v3 — agent-teaching / automated verification (≠ manual checklist).
// PRIMARY tie = Deliverable; secondary tie = task-level ProcessNode.
model TestingTemplate {
  id            String       @id @default(cuid())
  deliverableId String
  deliverable   Deliverable  @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  taskNodeId    String?
  taskNode      ProcessNode? @relation(fields: [taskNodeId], references: [id])
  system        String?
  location      String?
  checkType     String? // presence | absence
  expected      String?
  createdAt     DateTime     @default(now())

  @@index([deliverableId])
  @@index([taskNodeId])
}

// Behaves as a task group.
model Standard {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Standards-tab display fields (area → leaf item structure).
  isArea                Boolean    @default(false) // true = department charter, false = leaf standard
  parentId              String? // leaf → its area Standard (or group → area; group children → group)
  parent                Standard?  @relation("StandardTree", fields: [parentId], references: [id], onDelete: Cascade)
  children              Standard[] @relation("StandardTree")
  department            String? // area department name (denormalized onto every row for the flat sheet)
  category              String? // leaf regulatory category
  description           String?
  buildRun              String? // Build | Run
  ownerRoleId           String? // resolved accountable role
  ownerRole             Role?      @relation("StandardOwnerRole", fields: [ownerRoleId], references: [id])
  appliesToValueStreams String? // raw VS reference text (also materialized as NodeStandard links)
  link                  String? // area: source sheet link
  mission               String? // area charter mission
  scope                 String? // area charter scope (newline-bulleted)
  charterIncluded       Boolean? // area: charter present in the sheet
  ownerLabel            String? // area/leaf: raw owner text (CISO, Chief Actuary, …)
  relatedRole           String? // leaf: accountable/governance role text
  relatedCategory       String?
  agentSkill            String?
  sdlcGates             String?
  regCitation           String?
  // FB-58 — granular leaf standards are independently testable + evidenceable.
  testProcedure         String? // how to independently verify the standard is met
  evidence              String? // the evidence artifact the verification leaves behind

  nodeStandards           NodeStandard[]
  roleStandards           RoleStandard[]
  standardDeliverables    StandardDeliverable[]
  standardWorkTemplates   StandardWorkTemplate[]
  standardTemplateAnswers StandardTemplateAnswer[]
  nodeStandardEvidences   NodeStandardEvidence[]

  @@index([companyId])
  @@index([companyId, isArea])
  @@index([parentId])
  @@index([ownerRoleId])
}

// CHANGED v3 — internal/external, org-scoped, source-fed.
model Application {
  id                 String             @id @default(cuid())
  companyId          String
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orgUnitId          String? // owning org (real usage M:N via NodeAppUsage)
  orgUnit            OrgUnit?           @relation(fields: [orgUnitId], references: [id])
  sourceId           String? // PRIMARY source (apps may appear in many)
  source             IntegrationSource? @relation(fields: [sourceId], references: [id])
  name               String
  kind               String             @default("Tool") // SystemOfRecord | Tool | Service
  isInternal         Boolean            @default(true)
  // Preserved TCO / catalog fields (from the legacy Application model).
  ownershipModel     String? // Hybrid | In-house | SaaS
  licenseCost        Float?
  laborCost          Float?
  vendorServicesCost Float?
  infraCost          Float?
  depreciationCost   Float?
  overheadCost       Float?
  totalTco           Float?
  code               String?
  systemOfRecord     Boolean?
  criticality        String             @default("Medium") // High | Medium | Low
  category           String? // Policy | Claims | Billing | Distribution | Data | Finance | Security | Infra
  vendor             String?
  illustrative       Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  nodeAppUsages             NodeAppUsage[]
  regulationApplications    RegulationApplication[]
  metrics                   Metric[]
  nodeTemplateAnswers       NodeTemplateAnswer[]
  standardTemplateAnswers   StandardTemplateAnswer[]
  regulationTemplateAnswers RegulationTemplateAnswer[]
  nodeStandardEvidences     NodeStandardEvidence[]
  nodeRegulationEvidences   NodeRegulationEvidence[]

  @@index([companyId])
  @@index([orgUnitId])
  @@index([sourceId])
}

// NEW v3 — systems-of-record sync + delta tracking.
model IntegrationSource {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  kind            String // ServiceNow | ITAM | CMDB | RCM | Finance | Other
  syncDirection   String?   @default("in") // in | bidirectional
  changeDetection String?   @default("delta") // delta | snapshot
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  applications Application[]

  @@index([companyId])
}

// ─── CONNECTIONS (junctions, bind at ANY level) ─────────────────────────

model NodeDeliverable {
  id            String      @id @default(cuid())
  companyId     String
  processNodeId String
  processNode   ProcessNode @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  deliverableId String
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@unique([processNodeId, deliverableId])
  @@index([processNodeId])
  @@index([deliverableId])
  @@index([companyId, processNodeId])
}

model RoleDeliverable {
  id            String      @id @default(cuid())
  companyId     String
  roleId        String
  role          Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  deliverableId String
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  role_         String // "Owner|Contributor" (named `role_` — `role` is the relation)

  @@unique([roleId, deliverableId, role_])
  @@index([roleId])
  @@index([deliverableId])
  @@index([companyId, roleId])
}

// NEW v4 — CRITICAL: task owner/participant (role ↔ ProcessNode).
model NodeRole {
  id            String      @id @default(cuid())
  companyId     String
  processNodeId String
  processNode   ProcessNode @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  roleId        String
  role          Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  role_         String // "Owner|Participant" (named `role_` — `role` is the relation)
  ownerLevel    String?

  @@unique([processNodeId, roleId, role_])
  @@index([processNodeId])
  @@index([roleId])
  @@index([companyId, processNodeId])
}

model NodeAppUsage {
  id            String      @id @default(cuid())
  companyId     String
  processNodeId String
  processNode   ProcessNode @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  usageType     String // performed | memorialized

  @@unique([processNodeId, applicationId, usageType])
  @@index([processNodeId])
  @@index([applicationId])
  @@index([companyId, processNodeId])
}

model NodeChecklist {
  id              String        @id @default(cuid())
  companyId       String
  processNodeId   String
  processNode     ProcessNode   @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  checklistItemId String
  checklistItem   ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)

  @@unique([processNodeId, checklistItemId])
  @@index([processNodeId])
  @@index([checklistItemId])
  @@index([companyId, processNodeId])
}

model NodeStandard {
  id            String      @id @default(cuid())
  companyId     String
  processNodeId String
  processNode   ProcessNode @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  standardId    String
  standard      Standard    @relation(fields: [standardId], references: [id], onDelete: Cascade)
  // Task-level override: true = this standard (inherited from an L2/L3 ancestor)
  // is explicitly NOT applied at this node. Applicability = ancestor/self links
  // where excluded=false, minus self links where excluded=true.
  excluded      Boolean     @default(false)

  @@unique([processNodeId, standardId])
  @@index([processNodeId])
  @@index([standardId])
  @@index([companyId, processNodeId])
}

model RoleStandard {
  id         String   @id @default(cuid())
  companyId  String
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  standardId String
  standard   Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  @@unique([roleId, standardId])
  @@index([roleId])
  @@index([standardId])
  @@index([companyId, roleId])
}

model StandardDeliverable {
  id            String      @id @default(cuid())
  companyId     String
  standardId    String
  standard      Standard    @relation(fields: [standardId], references: [id], onDelete: Cascade)
  deliverableId String
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@unique([standardId, deliverableId])
  @@index([standardId])
  @@index([deliverableId])
  @@index([companyId, standardId])
}

// was RequirementValueStream (now points at ProcessNode + RegulatoryRequirement).
model NodeRegulation {
  id            String                @id @default(cuid())
  companyId     String
  processNodeId String
  processNode   ProcessNode           @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  regId         String
  regulation    RegulatoryRequirement @relation(fields: [regId], references: [id], onDelete: Cascade)
  relationship  String                @default("GOVERNS") // GOVERNS | REQUIRES_INTEGRATION | INFORMS
  notes         String?
  excluded      Boolean               @default(false) // task-level override (see NodeStandard.excluded)
  createdAt     DateTime              @default(now())

  @@unique([processNodeId, regId])
  @@index([processNodeId])
  @@index([regId])
  @@index([companyId, processNodeId])
}

// NEW — reg → apps + evidence.
model RegulationApplication {
  id            String                @id @default(cuid())
  companyId     String
  regId         String
  regulation    RegulatoryRequirement @relation(fields: [regId], references: [id], onDelete: Cascade)
  applicationId String
  application   Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  evidenceRef   String?

  @@unique([regId, applicationId])
  @@index([regId])
  @@index([applicationId])
  @@index([companyId, regId])
}

// NEW — reg → role (accountable Owner + hands-on Contributors). Mirrors
// RoleDeliverable: role_ discriminates the responsibility kind.
model RoleRegulation {
  id         String                @id @default(cuid())
  companyId  String
  roleId     String
  role       Role                  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  regId      String
  regulation RegulatoryRequirement @relation(fields: [regId], references: [id], onDelete: Cascade)
  role_      String // "Owner|Contributor"

  @@unique([roleId, regId, role_])
  @@index([roleId])
  @@index([regId])
  @@index([companyId, regId])
}

// NEW v3 — reg evidence as a deliverable.
model RegulationDeliverable {
  id            String                @id @default(cuid())
  companyId     String
  regId         String
  regulation    RegulatoryRequirement @relation(fields: [regId], references: [id], onDelete: Cascade)
  deliverableId String
  deliverable   Deliverable           @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@unique([regId, deliverableId])
  @@index([regId])
  @@index([deliverableId])
  @@index([companyId, regId])
}

// ─── INITIATIVE & METRIC ────────────────────────────────────────────────

// ─── WORK LIBRARY (checklist/testing templates + per-item plans) ─────────

// Reusable generic template. kind CHECKLIST = pattern module (Core evidence base +
// 5 add-on modules); kind TEST = one of the 8 "Test by …" patterns. ADMIN-edited.
model WorkTemplate {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind        String // CHECKLIST | TEST
  name        String
  description String?
  isDefault   Boolean  @default(false) // seeded library default (Core evidence is always applied)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  keys            WorkTemplateKey[]
  nodeLinks       NodeWorkTemplate[]
  standardLinks   StandardWorkTemplate[]
  regulationLinks RegulationWorkTemplate[]

  @@index([companyId, kind])
}

// One generic key (question/step) of a template — key text lives HERE once;
// renaming propagates to every plan using the pattern.
model WorkTemplateKey {
  id         String       @id @default(cuid())
  templateId String
  template   WorkTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key        String
  guidance   String?
  valueKind  String       @default("TEXT") // TEXT | APPLICATION | ROLE | DELIVERABLE — drives the plan-side value combobox
  sortOrder  Int          @default(0)

  nodeAnswers       NodeTemplateAnswer[]
  standardAnswers   StandardTemplateAnswer[]
  regulationAnswers RegulationTemplateAnswer[]

  @@index([templateId])
}

// Assignment junctions — which templates a work item's plan uses (the dropdown
// selections). Deselecting removes the row; saved answers persist independently.
model NodeWorkTemplate {
  id            String       @id @default(cuid())
  companyId     String
  processNodeId String
  processNode   ProcessNode  @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  templateId    String
  template      WorkTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([processNodeId, templateId])
  @@index([processNodeId])
  @@index([templateId])
  @@index([companyId, processNodeId])
}

model StandardWorkTemplate {
  id         String       @id @default(cuid())
  companyId  String
  standardId String
  standard   Standard     @relation(fields: [standardId], references: [id], onDelete: Cascade)
  templateId String
  template   WorkTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([standardId, templateId])
  @@index([standardId])
  @@index([templateId])
  @@index([companyId, standardId])
}

model RegulationWorkTemplate {
  id         String                @id @default(cuid())
  companyId  String
  regId      String
  regulation RegulatoryRequirement @relation(fields: [regId], references: [id], onDelete: Cascade)
  templateId String
  template   WorkTemplate          @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([regId, templateId])
  @@index([regId])
  @@index([templateId])
  @@index([companyId, regId])
}

// Per-work-item answers. Keyed (subject, templateKey) and kept INDEPENDENT of the
// assignment junctions so switching patterns preserves saved values. templateKeyId
// null = item-specific custom step (customKey holds its text; user-editable).
// suppressed = generic key removed for this one item. Entity-typed values store an
// FK to the owning row (Application/Role/Deliverable) — never a copied name.
model NodeTemplateAnswer {
  id            String           @id @default(cuid())
  companyId     String
  processNodeId String
  processNode   ProcessNode      @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  templateKeyId String?
  templateKey   WorkTemplateKey? @relation(fields: [templateKeyId], references: [id], onDelete: Cascade)
  customKey     String?
  kind          String?          // CHECKLIST | TEST — block placement for custom steps (derived from the template for generic keys)
  value         String?
  applicationId String?
  application   Application?     @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  roleId        String?
  role          Role?            @relation(fields: [roleId], references: [id], onDelete: SetNull)
  deliverableId String?
  deliverable   Deliverable?     @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  suppressed    Boolean          @default(false)
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt @default(now())

  @@unique([processNodeId, templateKeyId])
  @@index([processNodeId])
  @@index([templateKeyId])
  @@index([companyId, processNodeId])
}

model StandardTemplateAnswer {
  id            String           @id @default(cuid())
  companyId     String
  standardId    String
  standard      Standard         @relation(fields: [standardId], references: [id], onDelete: Cascade)
  templateKeyId String?
  templateKey   WorkTemplateKey? @relation(fields: [templateKeyId], references: [id], onDelete: Cascade)
  customKey     String?
  kind          String?          // CHECKLIST | TEST — block placement for custom steps (derived from the template for generic keys)
  value         String?
  applicationId String?
  application   Application?     @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  roleId        String?
  role          Role?            @relation(fields: [roleId], references: [id], onDelete: SetNull)
  deliverableId String?
  deliverable   Deliverable?     @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  suppressed    Boolean          @default(false)
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt @default(now())

  @@unique([standardId, templateKeyId])
  @@index([standardId])
  @@index([templateKeyId])
  @@index([companyId, standardId])
}

model RegulationTemplateAnswer {
  id            String                @id @default(cuid())
  companyId     String
  regId         String
  regulation    RegulatoryRequirement @relation(fields: [regId], references: [id], onDelete: Cascade)
  templateKeyId String?
  templateKey   WorkTemplateKey?      @relation(fields: [templateKeyId], references: [id], onDelete: Cascade)
  customKey     String?
  kind          String?               // CHECKLIST | TEST — block placement for custom steps (derived from the template for generic keys)
  value         String?
  applicationId String?
  application   Application?          @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  roleId        String?
  role          Role?                 @relation(fields: [roleId], references: [id], onDelete: SetNull)
  deliverableId String?
  deliverable   Deliverable?          @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  suppressed    Boolean               @default(false)
  sortOrder     Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt @default(now())

  @@unique([regId, templateKeyId])
  @@index([regId])
  @@index([templateKeyId])
  @@index([companyId, regId])
}

// Per-task checklist/testing STEP LISTS for an inherited standard/regulation, so
// application of the standard/reg at that task is implemented AND verified.
// Applicability stays DERIVED (NodeStandard/NodeRegulation on L2/L3 ancestors) —
// these hold only the task-local steps; users add/remove/edit rows freely.
model NodeStandardEvidence {
  id            String       @id @default(cuid())
  companyId     String
  processNodeId String
  processNode   ProcessNode  @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  standardId    String
  standard      Standard     @relation(fields: [standardId], references: [id], onDelete: Cascade)
  kind          String // CHECKLIST | TEST
  step          String
  value         String?
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  roleId        String?
  role          Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  deliverableId String?
  deliverable   Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt @default(now())

  @@index([processNodeId])
  @@index([standardId])
  @@index([companyId, processNodeId])
}

model NodeRegulationEvidence {
  id            String                @id @default(cuid())
  companyId     String
  processNodeId String
  processNode   ProcessNode           @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  regId         String
  regulation    RegulatoryRequirement @relation(fields: [regId], references: [id], onDelete: Cascade)
  kind          String // CHECKLIST | TEST
  step          String
  value         String?
  applicationId String?
  application   Application?          @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  roleId        String?
  role          Role?                 @relation(fields: [roleId], references: [id], onDelete: SetNull)
  deliverableId String?
  deliverable   Deliverable?          @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  sortOrder     Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt @default(now())

  @@index([processNodeId])
  @@index([regId])
  @@index([companyId, processNodeId])
}

model Initiative {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  state      String?
  startDate  DateTime?
  targetDate DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  nodeInitiatives NodeInitiative[]

  @@index([companyId])
}

// NEW — initiative → value-stream nodes (any level).
model NodeInitiative {
  id            String      @id @default(cuid())
  companyId     String
  processNodeId String
  processNode   ProcessNode @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  initiativeId  String
  initiative    Initiative  @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  @@unique([processNodeId, initiativeId])
  @@index([processNodeId])
  @@index([initiativeId])
  @@index([companyId, processNodeId])
}

// UNPARKED — polymorphic target by kind (exactly one of the *Id set).
model Metric {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  processNodeId String?
  processNode   ProcessNode? @relation(fields: [processNodeId], references: [id], onDelete: SetNull)
  orgUnitId     String?
  orgUnit       OrgUnit?     @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  roleId        String?
  role          Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  name          String
  value         Float?
  unit          String?
  period        String?
  kind          String // workforce | system | kpi
  createdAt     DateTime     @default(now())

  @@index([companyId])
  @@index([processNodeId])
  @@index([orgUnitId])
  @@index([roleId])
  @@index([applicationId])
}

// ─── EXTERNAL PARTIES (operating-model boundary) ────────────────────────

model ExternalParty {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  partyType String // Agent | Broker | Regulator | MGA | Insured | Vendor | SaaS | SystemIntegrator
  createdAt DateTime @default(now())

  interactions ExternalInteraction[]

  @@index([companyId])
}

// NEW — dependency on parties you don't control (wait-time).
model ExternalInteraction {
  id              String        @id @default(cuid())
  roleId          String?
  role            Role?         @relation(fields: [roleId], references: [id], onDelete: SetNull)
  externalPartyId String
  externalParty   ExternalParty @relation(fields: [externalPartyId], references: [id], onDelete: Cascade)
  processNodeId   String?
  processNode     ProcessNode?  @relation(fields: [processNodeId], references: [id], onDelete: SetNull)
  nature          String // handoff | approval | data | service
  createdAt       DateTime      @default(now())

  @@index([roleId])
  @@index([externalPartyId])
  @@index([processNodeId])
}

// ─── AGENT ENABLEMENT ───────────────────────────────────────────────────

model KnowledgeBase {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  domain    String?
  createdAt DateTime @default(now())

  skills AgentSkill[]

  @@index([companyId])
}

// UNPARKED — KB tied to app/task; powers automation.
model AgentSkill {
  id              String        @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  taskNodeId      String?
  taskNode        ProcessNode?  @relation(fields: [taskNodeId], references: [id], onDelete: SetNull)
  name            String
  createdAt       DateTime      @default(now())

  @@index([knowledgeBaseId])
  @@index([taskNodeId])
}

// Hand-authored compliance skill-pack files (SKILL.md + references/data/etc.),
// served from the DB so prod/serverless doesn't depend on the repo filesystem.
// Generated (per-category) packs are NOT stored here — they're built on demand
// from Standard rows (see lib/skillPacks.ts). Only the hand-authored KEEP packs
// (ccpa/gdpr/nydfs/sox/acord) live here.
model SkillFile {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  skill     String // pack folder name, e.g. "sox-itgc-sdlc-compliance"
  path      String // pack-relative POSIX path, e.g. "references/audit-evidence-map.md"
  content   String
  bytes     Int
  updatedAt DateTime @updatedAt

  @@unique([companyId, skill, path])
  @@index([companyId, skill])
}

// ─── ADMIN & CROSS-CUTTING ──────────────────────────────────────────────

// NEW — display override over db value (any entity); taxonomy/dictionary/ontology.
model Terminology {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entity       String
  dbValue      String
  displayValue String // EDITABLE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([companyId, entity, dbValue])
  @@index([companyId])
}

// CHANGED v3 — tie to process/role, not just company.
model AuditEntry {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  actorRoleId   String?
  actorRole     Role?        @relation(fields: [actorRoleId], references: [id], onDelete: SetNull)
  processNodeId String?
  processNode   ProcessNode? @relation(fields: [processNodeId], references: [id], onDelete: SetNull)
  entityType    String
  entityId      String
  action        String
  actorEmail    String
  diff          String? // JSON
  createdAt     DateTime     @default(now())

  @@index([entityType, entityId])
  @@index([actorRoleId])
  @@index([processNodeId])
}

// ─── AI-ADOPTION per ProcessNode (Telemetry / Active AI) ────────────────
// 1:1 with a value-stream ProcessNode. Replaces NodeAiAdoption/LevelAiAdoption.
model NodeAiAdoption {
  id            String      @id @default(cuid())
  processNodeId String      @unique
  processNode   ProcessNode @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  aiAssist      String      @default("not_used")
  aiAugment     String      @default("not_used")
  aiWorkflow    String      @default("not_used")
  aiAutonomous  String      @default("not_used")
  useCases      Json?
  // Per-mode adoption statistics shown on the Active AI drill-in.
  stats         Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ─── TELEMETRY SIGNAL CATALOG (kept as-is) ──────────────────────────────

model TelemetrySignal {
  id          String   @id @default(cuid())
  tenantId    String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind        String // system | kpi
  name        String
  description String?
  source      String?
  category    String?
  unit        String?
  frequency   String?
  direction   String   @default("up")
  origin      String?
  queryType   String?
  isLive      Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
}

// ─── SCENARIO INPUTS (change-impact economics) ──────────────────────────

model Scenario {
  id              String       @id @default(cuid())
  tenantId        String
  companyId       String
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  changeType      String?
  impactScope     String?
  // Operating-model links as real FKs (were divisionName / valueStreamName).
  orgUnitId       String?
  orgUnit         OrgUnit?     @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  processNodeId   String?
  processNode     ProcessNode? @relation(fields: [processNodeId], references: [id], onDelete: SetNull)
  application     String?
  roleImpact      String?
  oneTimeCost     Float?
  annualBenefit   Float?
  annualAddedCost Float?
  annualNetImpact Float?
  confidence      String?
  createdAt       DateTime     @default(now())

  @@index([companyId])
  @@index([orgUnitId])
  @@index([processNodeId])
}

// ─── ANALYSIS STATUS (Metrics coverage) ─────────────────────────────────
// One row per analyzed operating-model subject. subjectId references a node id
// (ProcessNode / OrgUnit / Role) by string — kept a plain indexed string because
// it can point at any of the three spines (no single FK target).
model AnalysisStatus {
  id            String    @id @default(cuid())
  tenantId      String
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subjectType   String // valueStream | division | role
  subjectId     String // ProcessNode / OrgUnit / Role id of the analyzed subject
  status        String    @default("Not Started") // Not Started | In Progress | Complete
  plannedDate   DateTime?
  completedDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([companyId, subjectType, subjectId])
  @@index([companyId])
  @@index([subjectId])
}

// ─── PORTFOLIO SPM (Program → Workstream → PortfolioInitiative) ─────────

model Program {
  id          String   @id @default(cuid())
  tenantId    String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  status      String   @default("ON_TRACK") // ON_TRACK | AT_RISK | OFF_TRACK
  statusNote  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workstreams Workstream[]

  @@index([companyId])
}

model Workstream {
  id          String   @id @default(cuid())
  tenantId    String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  programId   String
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      String   @default("ON_TRACK")
  statusNote  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  initiatives PortfolioInitiative[]

  @@index([companyId])
  @@index([programId])
}

model PortfolioInitiative {
  id                   String       @id @default(cuid())
  tenantId             String
  companyId            String
  company              Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workstreamId         String
  workstream           Workstream   @relation(fields: [workstreamId], references: [id], onDelete: Cascade)
  name                 String
  description          String?
  // Stage-gate workflow
  stage                String       @default("IDEA") // IDEA | PLAN | EXECUTE | COMPLETE
  workflowAction       String?
  state                String       @default("PLANNING") // PLANNING | ACTIVE | DONE
  status               String       @default("ON_TRACK") // ON_TRACK | AT_RISK | OFF_TRACK
  statusNote           String?
  startDate            DateTime
  dueDate              DateTime
  // Operating-model integration — real FK relations.
  valueStreamNodeId    String?
  valueStreamNode      ProcessNode? @relation(fields: [valueStreamNodeId], references: [id], onDelete: SetNull)
  orgUnitId            String?
  orgUnit              OrgUnit?     @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  ownerRoleId          String?
  ownerRole            Role?        @relation("PortfolioInitiativeOwner", fields: [ownerRoleId], references: [id], onDelete: SetNull)
  sponsorRoleId        String?
  sponsorRole          Role?        @relation("PortfolioInitiativeSponsor", fields: [sponsorRoleId], references: [id], onDelete: SetNull)
  // Denormalized rollups, refreshed by the rollup service.
  cumulativeBenefit    Float        @default(0)
  cumulativeCost       Float        @default(0)
  cumulativeNetBenefit Float        @default(0)
  complexityScore      Float        @default(5)
  valueScore           Float        @default(0)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  objectives     InitiativeObjective[]
  resources      InitiativeResource[]
  activities     WorkplanActivity[]
  benefits       BenefitLine[]
  costs          CostLine[]
  milestones     Milestone[]
  raidItems      RaidItem[]
  changeRequests ChangeRequest[]

  @@index([companyId])
  @@index([workstreamId])
  @@index([companyId, valueStreamNodeId])
  @@index([companyId, orgUnitId])
  @@index([ownerRoleId])
  @@index([sponsorRoleId])
}

// FB-27: change-request register for an initiative — who raised it, when, the
// cost + schedule impact, and an approval status.
model ChangeRequest {
  id                 String              @id @default(cuid())
  initiativeId       String
  initiative         PortfolioInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  raisedBy           String
  costImpact         Float               @default(0)
  scheduleImpactDays Int                 @default(0)
  status             String              @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([initiativeId])
}

model BenefitLine {
  id           String              @id @default(cuid())
  initiativeId String
  initiative   PortfolioInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  name         String
  category     String?
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime            @default(now())

  values MetricValue[]

  @@index([initiativeId])
}

model CostLine {
  id           String              @id @default(cuid())
  initiativeId String
  initiative   PortfolioInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  name         String
  category     String?
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime            @default(now())

  values MetricValue[]

  @@index([initiativeId])
}

// Time-phased monthly value. Either benefitLineId OR costLineId is set (sparse FK).
model MetricValue {
  id            String       @id @default(cuid())
  benefitLineId String?
  costLineId    String?
  benefitLine   BenefitLine? @relation(fields: [benefitLineId], references: [id], onDelete: Cascade)
  costLine      CostLine?    @relation(fields: [costLineId], references: [id], onDelete: Cascade)
  dataset       String // ACTUAL | TARGET | FORECAST
  periodStart   DateTime
  amount        Float

  @@index([benefitLineId, dataset, periodStart])
  @@index([costLineId, dataset, periodStart])
}

model RiskScoringBand {
  id          String   @id @default(cuid())
  tenantId    String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label       String
  minScore    Int
  maxScore    Int
  color       String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([companyId])
}

model StrategicObjective {
  id          String   @id @default(cuid())
  tenantId    String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  weight      Float    @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  links InitiativeObjective[]

  @@index([companyId])
}

model InitiativeObjective {
  id           String              @id @default(cuid())
  initiativeId String
  initiative   PortfolioInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  objectiveId  String
  objective    StrategicObjective  @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  impact       Int                 @default(3)
  createdAt    DateTime            @default(now())

  @@unique([initiativeId, objectiveId])
}

model InitiativeResource {
  id            String              @id @default(cuid())
  initiativeId  String
  initiative    PortfolioInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  roleId        String?
  role          Role?               @relation(fields: [roleId], references: [id], onDelete: SetNull)
  name          String
  allocationPct Int                 @default(50)
  startDate     DateTime
  endDate       DateTime
  createdAt     DateTime            @default(now())

  @@index([initiativeId])
  @@index([roleId])
}

model WorkplanActivity {
  id           String              @id @default(cuid())
  initiativeId String
  initiative   PortfolioInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  name         String
  startDate    DateTime
  endDate      DateTime
  status       String              @default("PLANNED") // PLANNED | IN_PROGRESS | DONE
  assignedTo   String?
  dependsOnId  String?
  dependsOn    WorkplanActivity?   @relation("ActivityDep", fields: [dependsOnId], references: [id], onDelete: SetNull)
  dependents   WorkplanActivity[]  @relation("ActivityDep")
  // Typed dependency (FB-19): TEAM | ROLE | PERSON | PROJECT | CHANGE_APPROVAL.
  // refId points at the chosen entity when it comes from a list (org unit / role /
  // program); label is the human-readable value (also used for free-text types).
  dependencyType  String?
  dependencyRefId String?
  dependencyLabel String?
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now())

  @@index([initiativeId])
}

model Milestone {
  id           String              @id @default(cuid())
  initiativeId String
  initiative   PortfolioInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  name         String
  dueDate      DateTime
  completedAt  DateTime?
  isGate       Boolean             @default(false)
  status       String              @default("PENDING") // PENDING | DONE | MISSED
  createdAt    DateTime            @default(now())

  @@index([initiativeId])
}

model RaidItem {
  id           String              @id @default(cuid())
  initiativeId String
  initiative   PortfolioInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  type         String // RISK | ASSUMPTION | ISSUE | DECISION
  title        String
  description  String?
  probability  Int                 @default(3)
  impact       Int                 @default(3)
  severity     Int                 @default(9)
  mitigation   String?
  status       String              @default("OPEN") // OPEN | MITIGATED | CLOSED
  ownerRoleId  String?
  ownerRole    Role?               @relation(fields: [ownerRoleId], references: [id], onDelete: SetNull)
  dueDate      DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([initiativeId])
  @@index([ownerRoleId])
}

// ─── APP RATIONALIZATION ("How") ────────────────────────────────────────

model RationalizationWorkspace {
  id                String       @id @default(cuid())
  tenantId          String
  companyId         String
  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  application       String?
  stageOrder        Int          @default(0)
  businessProcess   String?
  description       String?
  northstar         String?
  // value-stream link as a real FK (was valueStreamId scalar).
  valueStreamNodeId String?
  valueStreamNode   ProcessNode? @relation(fields: [valueStreamNodeId], references: [id], onDelete: SetNull)
  status            String       @default("In Progress") // Proposed | In Progress | Migrating | Complete
  illustrative      Boolean      @default(true)
  layout            Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  apps          RationalizationApp[]
  capabilities  RationalizationCapability[]
  components    RationalizationComponent[]
  microservices RationalizationMicroservice[]
  planSteps     RationalizationPlanStep[]

  @@unique([tenantId, companyId, name])
  @@index([companyId])
  @@index([valueStreamNodeId])
}

model RationalizationApp {
  id           String                   @id @default(cuid())
  tenantId     String
  companyId    String
  workspaceId  String
  workspace    RationalizationWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  disposition  String                   @default("Refactor") // Retain | Refactor | Replace | Retire
  techStack    String?
  vendor       String?
  hosting      String?
  criticality  String?
  ageYears     Int?
  annualCost   Float?
  position     Int                      @default(0)
  illustrative Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  capabilities RationalizationCapability[]

  @@index([companyId])
  @@index([workspaceId])
}

model RationalizationComponent {
  id              String                       @id @default(cuid())
  tenantId        String
  companyId       String
  workspaceId     String
  workspace       RationalizationWorkspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  layer           String // UI | Integration | Business Service | Data | Infrastructure
  name            String
  principle       String?
  pattern         String?
  targetTech      String?
  destination     String?
  microserviceId  String?
  microservice    RationalizationMicroservice? @relation(fields: [microserviceId], references: [id], onDelete: SetNull)
  migrationStatus String                       @default("Identified")
  illustrative    Boolean                      @default(true)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  capabilities RationalizationCapability[]

  @@index([companyId])
  @@index([workspaceId])
  @@index([microserviceId])
}

model RationalizationCapability {
  id                String                    @id @default(cuid())
  tenantId          String
  companyId         String
  workspaceId       String
  workspace         RationalizationWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appId             String
  app               RationalizationApp        @relation(fields: [appId], references: [id], onDelete: Cascade)
  layer             String
  name              String
  category          String?
  capdan            String                    @default("Common") // Common | Different | Relocate | Eliminate
  targetLayer       String?
  treatment         String                    @default("Retain") // Retain | Eliminate
  migrationStatus   String                    @default("Identified")
  componentId       String?
  component         RationalizationComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)
  codeRef           String?
  migrationApproach String?
  targetTech        String?
  rationale         String?
  effort            String?
  complexity        String?
  notes             String?
  illustrative      Boolean                   @default(true)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([companyId])
  @@index([workspaceId])
  @@index([appId])
  @@index([componentId])
}

model RationalizationMicroservice {
  id           String                   @id @default(cuid())
  tenantId     String
  companyId    String
  workspaceId  String
  workspace    RationalizationWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  kind         String                   @default("Microservice") // Microservice | Application
  description  String?
  status       String                   @default("Planned") // Planned | Building | Live
  techStack    String?
  // owning team/role as a real FK (was ownerRole text).
  ownerRoleId  String?
  ownerRole    Role?                    @relation("RationalizationMicroserviceOwner", fields: [ownerRoleId], references: [id], onDelete: SetNull)
  repo         String?
  position     Int                      @default(0)
  illustrative Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  components RationalizationComponent[]

  @@index([companyId])
  @@index([workspaceId])
  @@index([ownerRoleId])
}

model RationalizationPlanStep {
  id           String                   @id @default(cuid())
  tenantId     String
  companyId    String
  workspaceId  String
  workspace    RationalizationWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  wave         Int                      @default(1)
  sequence     Int                      @default(0)
  name         String
  description  String?
  layer        String?
  status       String                   @default("Not Started") // Not Started | In Progress | Done | Blocked
  // owner as a real FK (was ownerRole text).
  ownerRoleId  String?
  ownerRole    Role?                    @relation("RationalizationPlanStepOwner", fields: [ownerRoleId], references: [id], onDelete: SetNull)
  targetWindow String?
  effortWeeks  Int?
  dependsOn    String?
  deliverables String?
  illustrative Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([companyId])
  @@index([workspaceId])
  @@index([workspaceId, wave, sequence])
  @@index([ownerRoleId])
}

// ─── REGULATIONS (50-state insurance regulatory baseline) ───────────────

model Jurisdiction {
  id                     String    @id @default(cuid())
  tenantId               String
  companyId              String
  company                Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code                   String // USPS code: "AL" … "DC"
  name                   String
  // Regulator
  regulatorName          String
  regulatorWebsite       String?
  regulatorType          String    @default("STATE_INSURANCE_REGULATOR")
  // Taxonomy flags — normalized token + raw doc text
  filingPortal           String // SERFF | PROPRIETARY | MIXED
  filingPortalDetail     String?
  compactStatus          String // MEMBER | NON_MEMBER
  autoVerification       String // YES | NO | PARTIAL
  autoVerificationDetail String?
  workersCompModel       String // EDI | NON_EDI | MIXED | MONOPOLISTIC_FUND | STATE_SPECIFIC
  workersCompDetail      String?
  apcd                   String // YES | NO | EMERGING
  sbs                    String // YES | NO | PARTIAL | TRANSITIONING
  // Narrative blocks (markdown, from the source doc)
  statutoryAuthority     String?
  summaryRegulator       String?
  summaryStatutes        String?
  summaryIntegration     String?
  executiveSummary       String?
  operatingModel         String?
  signalsJson            Json?
  // Governance / pipeline
  priorityTier           String    @default("STANDARD") // PRIORITY | STANDARD
  profileDepth           String    @default("NARRATIVE") // FULL_PROFILE | NARRATIVE
  lastReviewedAt         DateTime?
  lastVerifiedAt         DateTime?
  baselineVersion        Int       @default(1)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  requirements RegulatoryRequirement[]
  sources      RegulatorySource[]
  bulletins    RegulatoryBulletin[]
  rules        ComplianceRule[]
  integrations JurisdictionIntegration[]

  @@unique([companyId, code])
  @@index([companyId])
}

model IntegrationSystem {
  id              String   @id @default(cuid())
  tenantId        String
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  kind            String // FILING | LICENSING | TAX | DATA_REPORTING | CLAIMS_EDI | VERIFICATION | PAYMENT
  operator        String // NAIC | STATE | VENDOR | COMPACT
  website         String?
  description     String?
  apiAvailability String   @default("PORTAL_ONLY") // API | WEB_SERVICES | PORTAL_ONLY | SFTP_BATCH
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  jurisdictionLinks JurisdictionIntegration[]

  @@unique([companyId, name])
  @@index([companyId])
}

model JurisdictionIntegration {
  id             String            @id @default(cuid())
  jurisdictionId String
  jurisdiction   Jurisdiction      @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  systemId       String
  system         IntegrationSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  usage          String            @default("REQUIRED") // REQUIRED | ACCEPTED | NOT_USED | TRANSITIONING
  scope          String            @default("all lines")
  notes          String?
  effectiveDate  DateTime?
  createdAt      DateTime          @default(now())

  @@unique([jurisdictionId, systemId, scope])
  @@index([jurisdictionId])
  @@index([systemId])
}

// The core obligation rows — single regulation entity (NodeRegulation /
// RegulationApplication / RegulationDeliverable all point here).
model RegulatoryRequirement {
  id             String       @id @default(cuid())
  tenantId       String
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jurisdictionId String
  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  category       String // PRODUCT_FILING | LICENSING | PREMIUM_TAX | ...
  title          String
  requirement    String // full obligation text (markdown)
  lineOfBusiness String       @default("ALL")
  citation       String?
  citationUrl    String?
  obligationType String       @default("ONGOING")
  frequency      String?
  status         String       @default("ACTIVE") // ACTIVE | SUPERSEDED | PENDING
  effectiveDate  DateTime?
  supersededById String?
  // The named regulation / regime this obligation belongs to, surfaced as a
  // column so GDPR/CCPA/NYDFS/SERFF/IIPRC are visible without drilling in.
  regime         String? // GDPR | CCPA-CPRA | NYDFS-500 | SERFF | IIPRC | IAIABC-EDI | ...
  // Accuracy metadata
  confidence     String       @default("BASELINE") // BASELINE | VERIFIED | DERIVED | STALE
  sourceNote     String?
  // FB-59 — privacy/cyber regimes migrated from Standards carry their SDLC agent
  // skill (ccpa-cpra-sdlc-compliance, gdpr-sdlc-compliance, nydfs-500-sdlc-compliance)
  // so the regulation surfaces the same downloadable skill the standard did.
  agentSkill     String?
  lastVerifiedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  nodeRegulations           NodeRegulation[]
  regulationApplications    RegulationApplication[]
  regulationDeliverables    RegulationDeliverable[]
  roleRegulations           RoleRegulation[]
  bulletins                 RegulatoryBulletin[]
  regulationWorkTemplates   RegulationWorkTemplate[]
  regulationTemplateAnswers RegulationTemplateAnswer[]
  nodeRegulationEvidences   NodeRegulationEvidence[]

  @@index([companyId])
  @@index([jurisdictionId])
  @@index([companyId, category])
  @@index([companyId, status])
}

model RegulatoryBulletin {
  id             String                 @id @default(cuid())
  tenantId       String
  companyId      String
  company        Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jurisdictionId String
  jurisdiction   Jurisdiction           @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  reference      String
  title          String
  summary        String?
  url            String?
  issuedDate     DateTime?
  discoveredVia  String                 @default("BASELINE") // BASELINE | PIPELINE | MANUAL
  requirementId  String?
  requirement    RegulatoryRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([companyId])
  @@index([jurisdictionId])
}

model ComplianceRule {
  id             String       @id @default(cuid())
  tenantId       String
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jurisdictionId String
  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  ruleCode       String
  category       String
  description    String?
  ruleJson       Json
  origin         String       @default("DOCUMENT") // DOCUMENT | TEMPLATE_DERIVED | PIPELINE
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([companyId, ruleCode])
  @@index([companyId])
  @@index([jurisdictionId])
}

model RegulatorySource {
  id                  String        @id @default(cuid())
  tenantId            String
  companyId           String
  company             Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jurisdictionId      String?
  jurisdiction        Jurisdiction? @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  name                String
  url                 String
  sourceType          String
  authority           String        @default("OFFICIAL_REGULATOR")
  monitor             Boolean       @default(true)
  checkTier           String        @default("WEEKLY") // PRIORITY_DAILY | WEEKLY
  lastCheckedAt       DateTime?
  lastContentHash     String?
  lastChangedAt       DateTime?
  consecutiveFailures Int           @default(0)
  healthStatus        String        @default("OK") // OK | UNREACHABLE | PARSE_ERROR
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([companyId])
  @@index([jurisdictionId])
}
