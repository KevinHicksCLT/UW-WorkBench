  label       String
  minScore    Int
  maxScore    Int
  color       String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([companyId])
}

model StrategicObjective {
  id          String   @id @default(cuid())
  tenantId    String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  weight      Float    @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  links InitiativeObjective[]

  @@index([companyId])
}

model InitiativeObjective {
  id           String              @id @default(cuid())
  initiativeId String
  initiative   PortfolioInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  objectiveId  String
  objective    StrategicObjective  @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  impact       Int                 @default(3)
  createdAt    DateTime            @default(now())

  @@unique([initiativeId, objectiveId])
}

model InitiativeResource {
  id            String              @id @default(cuid())
  initiativeId  String
  initiative    PortfolioInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  roleId        String?
  role          Role?               @relation(fields: [roleId], references: [id], onDelete: SetNull)
  name          String
  allocationPct Int                 @default(50)
  startDate     DateTime
  endDate       DateTime
  createdAt     DateTime            @default(now())

  @@index([initiativeId])
  @@index([roleId])
}

model WorkplanActivity {
  id              String              @id @default(cuid())
  initiativeId    String
  initiative      PortfolioInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  name            String
  startDate       DateTime
  endDate         DateTime
  status          String              @default("PLANNED") // PLANNED | IN_PROGRESS | DONE
  assignedTo      String?
  dependsOnId     String?
  dependsOn       WorkplanActivity?   @relation("ActivityDep", fields: [dependsOnId], references: [id], onDelete: SetNull)
  dependents      WorkplanActivity[]  @relation("ActivityDep")
  // Typed dependency (FB-19): TEAM | ROLE | PERSON | PROJECT | CHANGE_APPROVAL.
  // refId points at the chosen entity when it comes from a list (org unit / role /
  // program); label is the human-readable value (also used for free-text types).
  dependencyType  String?
  dependencyRefId String?
  dependencyLabel String?
  sortOrder       Int                 @default(0)
  createdAt       DateTime            @default(now())

  @@index([initiativeId])
}

model Milestone {
  id           String              @id @default(cuid())
  initiativeId String
  initiative   PortfolioInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  name         String
  dueDate      DateTime
  completedAt  DateTime?
  isGate       Boolean             @default(false)
  status       String              @default("PENDING") // PENDING | DONE | MISSED
  createdAt    DateTime            @default(now())

  @@index([initiativeId])
}

model RaidItem {
  id           String              @id @default(cuid())
  initiativeId String
  initiative   PortfolioInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  type         String // RISK | ASSUMPTION | ISSUE | DECISION
  title        String
  description  String?
  probability  Int                 @default(3)
  impact       Int                 @default(3)
  severity     Int                 @default(9)
  mitigation   String?
  status       String              @default("OPEN") // OPEN | MITIGATED | CLOSED
  ownerRoleId  String?
  ownerRole    Role?               @relation(fields: [ownerRoleId], references: [id], onDelete: SetNull)
  dueDate      DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([initiativeId])
  @@index([ownerRoleId])
}

// ─── CHANGE-IMPACT DECISION PACKETS ─────────────────────────────────────
// A persisted change-impact assessment (Change Impact v2, Workstream D). The
// report itself stays DERIVED — this table only snapshots a decision packet so
// there is an audit trail and a maker-checker approval step. Following erd_v5
// discipline it holds NO denormalized copies of graph rows: `subjectRef`,
// `report` and `artifacts` are opaque jsonb; live data is always re-derived
// from the closures/junctions. `createdBy` (maker) ≠ `decidedBy` (checker) is
// enforced at the API layer for RECOMMENDED → APPROVED transitions.
model ImpactAssessment {
  id          String   @id @default(cuid())
  tenantId    String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // process-nodes | role | application | product-element | deliverable | plan
  subjectKind String
  subjectRef  Json // the ImpactSubject discriminated union
  subjectName String
  changeType  String
  intent      String? // the Intent Statement free text
  // DRAFT | ASSESSED | RECOMMENDED | APPROVED | REJECTED | FURTHER_ANALYSIS
  status         String    @default("DRAFT")
  recommendation String? // decision recommendation captured at RECOMMEND
  report         Json? // ImpactReport snapshot (jsonb)
  artifacts      Json? // staged artifacts, edited per stage (jsonb)
  createdBy      String // User id (maker)
  decidedBy      String? // User id (checker)
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId, subjectKind])
  @@index([companyId, createdAt])
  @@index([companyId, status])
}

// ─── APP RATIONALIZATION ("How") ────────────────────────────────────────

model RationalizationWorkspace {
  id                String       @id @default(cuid())
  tenantId          String
  companyId         String
  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  application       String? // display label; canonical link is applicationId (WR-01)
  // Estate-application link as a real FK (WR-01 — the free-text `application`
  // string always violated the no-free-text-references rule; kept as fallback
  // label for boards whose name matches no Application row).
  applicationId     String?
  applicationRef    Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  stageOrder        Int          @default(0)
  businessProcess   String?
  description       String?
  northstar         String?
  // value-stream link as a real FK (was valueStreamId scalar).
  valueStreamNodeId String?
  valueStreamNode   ProcessNode? @relation(fields: [valueStreamNodeId], references: [id], onDelete: SetNull)
  status            String       @default("In Progress") // Proposed | In Progress | Migrating | Complete
  // Which rationalizable structure this board works on — one workspace list
  // serves both rationalization types (Product Model Workspace build).
  domain            String       @default("APPLICATION") // APPLICATION | PRODUCT_MODEL
  illustrative      Boolean      @default(true)
  layout            Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  apps                 RationalizationApp[]
  capabilities         RationalizationCapability[]
  components           RationalizationComponent[]
  microservices        RationalizationMicroservice[]
  planSteps            RationalizationPlanStep[]
  screens              ScreenAsset[]
  normalizationEntries NormalizationEntry[]

  @@unique([tenantId, companyId, name])
  @@index([companyId])
  @@index([valueStreamNodeId])
  @@index([applicationId])
}

model RationalizationApp {
  id             String                   @id @default(cuid())
  tenantId       String
  companyId      String
  workspaceId    String
  workspace      RationalizationWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Estate-catalog link — every board app IS an Application row; board data
  // hangs off the catalog as the single source of truth.
  applicationId  String?
  applicationRef Application?             @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  kind           String                   @default("LEGACY") // LEGACY | SHARED_SERVICE — shared services (MDM/RDM, auth, docs) render in their own lane (WR-15)
  disposition    String                   @default("Refactor") // Retain | Refactor | Replace | Retire
  techStack      String?
  vendor         String?
  hosting        String?
  criticality    String?
  ageYears       Int?
  annualCost     Float?
  position       Int                      @default(0)
  illustrative   Boolean                  @default(true)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  capabilities      RationalizationCapability[]
  screens           ScreenAsset[]
  // Relocate findings whose destination is this shared service (WR-15).
  relocatedFindings RationalizationCapability[] @relation("CapabilitySharedService")

  @@index([companyId])
  @@index([workspaceId])
  @@index([applicationId])
}

model RationalizationComponent {
  id              String                       @id @default(cuid())
  tenantId        String
  companyId       String
  workspaceId     String
  workspace       RationalizationWorkspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  layer           String // UI | Integration | Business Service | Data | Infrastructure
  name            String
  principle       String?
  pattern         String?
  targetTech      String?
  destination     String?
  microserviceId  String?
  microservice    RationalizationMicroservice? @relation(fields: [microserviceId], references: [id], onDelete: SetNull)
  migrationStatus String                       @default("Identified")
  // Per-layer migration target date, surfaced in the Greenfield slot detail.
  targetDate      DateTime?
  illustrative    Boolean                      @default(true)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  capabilities         RationalizationCapability[]
  normalizationEntries NormalizationEntry[]

  @@index([companyId])
  @@index([workspaceId])
  @@index([microserviceId])
}

// Reference catalog for the anatomy taxonomy (WR-06): per layer × view, the
// element/behavior categories that BELONG there, plus the MISPLACED view —
// categories that must NOT be in the layer, each with the layer they belong
// in. Seeded from the dispositioned renovation taxonomy; admin-editable later.
model AnatomyCategory {
  id               String  @id @default(cuid())
  tenantId         String
  companyId        String
  company          Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  layer            String // UI | Integration | Business Service | Data | Infrastructure
  view             String // COMPONENT | BEHAVIOR | MISPLACED
  name             String
  description      String // plain-language, non-technical
  recommendedLayer String? // MISPLACED rows: the layer this concern belongs in
  sortOrder        Int     @default(0)

  @@unique([companyId, layer, view, name])
  @@index([companyId, layer])
}

// A concrete screen or modal of a legacy application, linkable from UI-layer
// findings (WR-06: "clickable link to see the actual UI screen(s) that align
// to an L4 process"). Optional FK to the L4 ProcessNode it serves.
model ScreenAsset {
  id            String                   @id @default(cuid())
  tenantId      String
  companyId     String
  workspaceId   String
  workspace     RationalizationWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appId         String?
  app           RationalizationApp?      @relation(fields: [appId], references: [id], onDelete: Cascade)
  name          String
  kind          String                   @default("SCREEN") // SCREEN | MODAL
  url           String? // deep link to the live screen (or image/asset)
  processNodeId String?
  processNode   ProcessNode?             @relation(fields: [processNodeId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, name])
  @@index([companyId])
  @@index([appId])
  @@index([processNodeId])
}

model RationalizationCapability {
  id                   String                    @id @default(cuid())
  tenantId             String
  companyId            String
  workspaceId          String
  workspace            RationalizationWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appId                String
  app                  RationalizationApp        @relation(fields: [appId], references: [id], onDelete: Cascade)
  layer                String
  name                 String
  category             String?
  view                 String                    @default("COMPONENT") // COMPONENT | BEHAVIOR — anatomy lens (WR-06)
  screenRef            String? // UI findings: screen or modal it lives on (e.g. "User Admin › Users")
  plainSummary         String? // one-sentence non-technical explanation (WR-10)
  recommendedLayer     String? // rule/AI-suggested correct layer for misplaced items (targetLayer = the human decision)
  capdan               String                    @default("Common") // Common | Different | Relocate | Eliminate
  targetLayer          String?
  // Relocate findings can land in a SHARED_SERVICE app instead of a layer —
  // e.g. a hard-coded state list replaced by an MDM/RDM call (WR-15).
  sharedServiceId      String?
  sharedService        RationalizationApp?       @relation("CapabilitySharedService", fields: [sharedServiceId], references: [id], onDelete: SetNull)
  treatment            String                    @default("Retain") // Retain | Eliminate
  migrationStatus      String                    @default("Identified")
  componentId          String?
  component            RationalizationComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)
  codeRef              String?
  migrationApproach    String?
  targetTech           String?
  rationale            String?
  effort               String?
  complexity           String?
  notes                String?
  // v3 board: the Normalize-column entry this raw finding rolls up into.
  normalizationEntryId String?
  normalizationEntry   NormalizationEntry?       @relation(fields: [normalizationEntryId], references: [id], onDelete: SetNull)
  // v3 board: unreachable/superseded findings render in the dead-code lane.
  deadCode             Boolean                   @default(false)
  // v3 board "WHY THIS MOVES" panel: { captured, sent, processed, validated, lands }.
  whyThisMoves         Json?
  illustrative         Boolean                   @default(true)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([companyId])
  @@index([workspaceId])
  @@index([appId])
  @@index([componentId])
  @@index([sharedServiceId])
  @@index([normalizationEntryId])
}

model RationalizationMicroservice {
  id           String                   @id @default(cuid())
  tenantId     String
  companyId    String
  workspaceId  String
  workspace    RationalizationWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  kind         String                   @default("Microservice") // Microservice | Application
  description  String?
  status       String                   @default("Planned") // Planned | Building | Live
  techStack    String?
  // owning team/role as a real FK (was ownerRole text).
  ownerRoleId  String?
  ownerRole    Role?                    @relation("RationalizationMicroserviceOwner", fields: [ownerRoleId], references: [id], onDelete: SetNull)
  repo         String?
  // Overall go-live target date for this green-field service.
  targetDate   DateTime?
  position     Int                      @default(0)
  illustrative Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  components RationalizationComponent[]

  @@index([companyId])
  @@index([workspaceId])
  @@index([ownerRoleId])
}

model RationalizationPlanStep {
  id           String                   @id @default(cuid())
  tenantId     String
  companyId    String
  workspaceId  String
  workspace    RationalizationWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  wave         Int                      @default(1)
  sequence     Int                      @default(0)
  name         String
  description  String?
  layer        String?
  status       String                   @default("Not Started") // Not Started | In Progress | Done | Blocked
  // owner as a real FK (was ownerRole text).
  ownerRoleId  String?
  ownerRole    Role?                    @relation("RationalizationPlanStepOwner", fields: [ownerRoleId], references: [id], onDelete: SetNull)
  targetWindow String?
  effortWeeks  Int?
  dependsOn    String?
  deliverables String?
  illustrative Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([companyId])
  @@index([workspaceId])
  @@index([workspaceId, wave, sequence])
  @@index([ownerRoleId])
}

// One normalized item in a v3-board Normalize box (#N-101 …) — the roll-up a
// group of raw findings (RationalizationCapability rows) merges into, with the
// wireframe's AUTO / REVIEW / HELD match verdict. Application domain; the
// product domain has a twin (ProductModelNormalizationEntry) because the two
// finding sources cascade from different workspaces.
model NormalizationEntry {
  id                 String                    @id @default(cuid())
  tenantId           String
  companyId          String
  workspaceId        String
  workspace          RationalizationWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  layer              String // row axis token (UI | Integration | Business Service | Data | Infrastructure)
  notation           String // "N-101" — stable, unique per workspace
  name               String
  matchStatus        String                    @default("AUTO") // AUTO | REVIEW | HELD
  matchBasis         String? // "all 14 fields match on name, type and order"
  differenceNote     String? // "same 22 fields — flow shape and validation timing differ"
  proposedResolution String? // shown on HELD cards awaiting sign-off
  // v3 side-by-side comparison cards: [{source, title, lines[], does?, moreNote?}]
  // — one card per legacy source, rendered in the Normalize box's source columns.
  sourceCards        Json?
  componentId        String?
  component          RationalizationComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)
  sortOrder          Int                       @default(0)
  illustrative       Boolean                   @default(true)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  capabilities RationalizationCapability[]

  @@unique([workspaceId, notation])
  @@index([companyId])
  @@index([workspaceId])
  @@index([componentId])
}

// Products-lens review sign-off. The product Normalize board derives its element
// groups from the live product spine (frontend buildComparison over ProductNode
// versions), so a "varies / unique" group has no persisted normalization row to
// PATCH. This table records the reviewer's decision for such a group, keyed by
// the compared LOB node + the group's stable key (`component::signature`):
// APPROVED = adopt everywhere / normalize; HELD = keep as a version variant.
model ProductNormalizationDecision {
  id        String   @id @default(cuid())
  tenantId  String
  companyId String
  lobNodeId String // the L2 LOB ProductNode whose versions are compared
  component String // model-component row (L5 axis token) — denormalized for filtering
  groupKey  String // ElementGroup.key ("component::signature"), stable per LOB
  status    String   @default("APPROVED") // APPROVED | HELD | RETIRED
  comment   String? // reviewer note left with the decision
  decidedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The named normalized policy this decision was made toward (nullable —
  // decisions made with no target selected stay unattached).
  targetId String?
  target   ProductNormalizationTarget? @relation(fields: [targetId], references: [id], onDelete: SetNull)

  @@unique([lobNodeId, groupKey])
  @@index([companyId])
  @@index([lobNodeId])
  @@index([targetId])
}

// A NAMED normalized policy — the consolidated multi-state policy a team is
// assembling. Created from the board (captures the scope filters, the target
// version/edition and the jurisdictions it will cover); review decisions carry
// its id, so the policy accumulates its content and survives across workflows.
model ProductNormalizationTarget {
  id           String   @id @default(cuid())
  tenantId     String
  companyId    String
  name         String
  versionToken String? // target edition label, e.g. "v3"
  filters      Json? // SpineFilters snapshot the policy was scoped from
  states       Json? // jurisdictions the normalized policy covers (string[])
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  decisions ProductNormalizationDecision[]

  @@unique([companyId, name])
  @@index([companyId])
}

// Board vocabulary — the "DB as source of truth" fix: one reference model
// replaces every hardcoded frontend vocabulary constant (LAYERS, CAPDAN_META,
// STATUS_META, MODES, VIEWS) and carries the product-model axis/scopes plus
// the scaffold templates (kind SCAFFOLD) formerly hardcoded in the route.
model WorkspaceVocabulary {
  id        String  @id @default(cuid())
  tenantId  String
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  domain    String // APPLICATION | PRODUCT_MODEL
  kind      String // LAYER | CLASSIFICATION | STATUS | MODE | VIEW | DISPOSITION | MATCH_STATUS | SCAFFOLD
  token     String // stable key, e.g. "UI", "Common", "Segment"
  label     String
  color     String? // tailwind token, e.g. "sky" — presentation defaults live with the data
  sortOrder Int     @default(0)
  meta      Json? // e.g. { legend: "correct — stays" } or scaffold template payloads

  @@unique([companyId, domain, kind, token])
  @@index([companyId])
}

// ─── PRODUCT MODEL RATIONALIZATION ──────────────────────────────────────
// Fourth rationalizable structure (alongside Applications / Value Streams /
// Roles): legacy product definitions are decomposed by the 11 product
// components, findings are scoped Common | Segment | Geography | Eliminate,
// normalized, and land on canonical (north-star) product models.

model ProductModelWorkspace {
  id           String   @id @default(cuid())
  tenantId     String
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  northstar    String?
  status       String   @default("In Progress") // Proposed | In Progress | Migrating | Complete
  illustrative Boolean  @default(true)
  layout       Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  legacyModels         LegacyProductModel[]
  components           ProductModelComponent[]
  findings             ProductModelFinding[]
  canonicalModels      CanonicalProductModel[]
  normalizationEntries ProductModelNormalizationEntry[]

  @@unique([tenantId, companyId, name])
  @@index([companyId])
}

// A legacy product definition as it exists in a source system today — the
// board's left-hand columns (e.g. "PolicyPro — Commercial Package (East)").
model LegacyProductModel {
  id           String                @id @default(cuid())
  tenantId     String
  companyId    String
  workspaceId  String
  workspace    ProductModelWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  sourceSystem String? // the estate application it lives in (PolicyPro, QuoteMaster…)
  segment      String? // SMB | Large Commercial | Personal Lines | Specialty | London Market…
  geography    String? // US | US-East | US-NY | UK | EU…
  disposition  String                @default("Refactor") // Retain | Refactor | Replace | Retire
  position     Int                   @default(0)
  illustrative Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  findings ProductModelFinding[]

  @@unique([workspaceId, name])
  @@index([companyId])
  @@index([workspaceId])
}

// Normalized target component per product-component row — what the kept
// findings fold into; lands on a CanonicalProductModel (the green-field twin
// of RationalizationComponent → RationalizationMicroservice).
model ProductModelComponent {
  id               String                 @id @default(cuid())
  tenantId         String
  companyId        String
  workspaceId      String
  workspace        ProductModelWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  component        String // one of the 11 product-component axis tokens (Party & Roles…)
  name             String
  description      String?
  principle        String?
  canonicalModelId String?
  canonicalModel   CanonicalProductModel? @relation(fields: [canonicalModelId], references: [id], onDelete: SetNull)
  migrationStatus  String                 @default("Identified")
  sortOrder        Int                    @default(0)
  illustrative     Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  findings             ProductModelFinding[]
  normalizationEntries ProductModelNormalizationEntry[]

  @@index([companyId])
  @@index([workspaceId])
  @@index([canonicalModelId])
}

// Reference catalog for the product-model anatomy: per component × scope ×
// view, the named sub-categories that belong there (mirrors AnatomyCategory,
// WR-06, including the MISPLACED view). `slug` is the stable SKOS concept id
// (tbi:pma-<slug>) used by the taxonomy exporter and the semantic matcher.
model ProductModelAnatomyCategory {
  id                   String  @id @default(cuid())
  tenantId             String
  companyId            String
  company              Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  component            String // one of the 11 product-component axis tokens
  scope                String // COMMON | SEGMENT | GEOGRAPHY
  view                 String  @default("COMPONENT") // COMPONENT | BEHAVIOR | MISPLACED
  slug                 String // stable kebab-case id, unique per company (SKOS concept id)
  name                 String
  description          String // plain-language, non-technical
  recommendedComponent String? // MISPLACED rows: the component this concern belongs in
  sortOrder            Int     @default(0)

  findings ProductModelFinding[]

  @@unique([companyId, slug])
  @@unique([companyId, component, scope, view, name])
  @@index([companyId, component])
}

// An atomic observation about a legacy product model within one component —
// the board's cards (e.g. "Hired & non-owned auto endorsement CA 20 01
// attached by default" — scope Segment/SMB).
model ProductModelFinding {
  id                   String                          @id @default(cuid())
  tenantId             String
  companyId            String
  workspaceId          String
  workspace            ProductModelWorkspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  legacyModelId        String
  legacyModel          LegacyProductModel              @relation(fields: [legacyModelId], references: [id], onDelete: Cascade)
  component            String // row axis token (one of the 11)
  name                 String
  detail               String? // the atomic specifics: field names, form numbers, thresholds
  scope                String                          @default("Common") // Common | Segment | Geography | Eliminate
  segmentValue         String? // scope Segment: which segment (SMB, Large Commercial…)
  geographyValue       String? // scope Geography: which geography (US-NY, UK…)
  sourceRef            String? // where it lives in the source (rate routine RT-114, VSAM copybook…)
  anatomyCategoryId    String?
  anatomyCategory      ProductModelAnatomyCategory?    @relation(fields: [anatomyCategoryId], references: [id], onDelete: SetNull)
  targetComponentId    String?
  targetComponent      ProductModelComponent?          @relation(fields: [targetComponentId], references: [id], onDelete: SetNull)
  migrationStatus      String                          @default("Identified")
  // v3 board: the Normalize-column entry this raw finding rolls up into.
  normalizationEntryId String?
  normalizationEntry   ProductModelNormalizationEntry? @relation(fields: [normalizationEntryId], references: [id], onDelete: SetNull)
  // v3 board: unreachable/superseded findings render in the dead-code lane.
  deadCode             Boolean                         @default(false)
  // v3 board "WHY THIS MOVES" panel: { captured, sent, processed, validated, lands }.
  whyThisMoves         Json?
  illustrative         Boolean                         @default(true)
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt

  @@index([companyId])
  @@index([workspaceId])
  @@index([legacyModelId])
  @@index([anatomyCategoryId])
  @@index([targetComponentId])
  @@index([normalizationEntryId])
}

// Product-domain twin of NormalizationEntry (same DTO shape; separate table so
// each domain's entries cascade from their own workspace + component types).
model ProductModelNormalizationEntry {
  id                 String                 @id @default(cuid())
  tenantId           String
  companyId          String
  workspaceId        String
  workspace          ProductModelWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  layer              String // row axis token (one of the 11 product components)
  notation           String // "N-101" — stable, unique per workspace
  name               String
  matchStatus        String                 @default("AUTO") // AUTO | REVIEW | HELD
  matchBasis         String?
  differenceNote     String?
  proposedResolution String?
  // v3 side-by-side comparison cards — same shape as NormalizationEntry.sourceCards.
  sourceCards        Json?
  componentId        String?
  component          ProductModelComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)
  sortOrder          Int                    @default(0)
  illustrative       Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  findings ProductModelFinding[]

  @@unique([workspaceId, notation])
  @@index([companyId])
  @@index([workspaceId])
  @@index([componentId])
}

// The north-star target — one canonical product model per major line, built
// from linked ProductModelComponents. Status is a roll-up computed on read
// from the linked components' migrationStatus (never denormalized).
model CanonicalProductModel {
  id             String                @id @default(cuid())
  tenantId       String
  companyId      String
  workspaceId    String
  workspace      ProductModelWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  lineOfBusiness String? // Commercial Package | Personal Auto | Annuity…
  ownerRoleId    String?
  ownerRole      Role?                 @relation("CanonicalProductModelOwner", fields: [ownerRoleId], references: [id], onDelete: SetNull)
  position       Int                   @default(0)
  illustrative   Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  components ProductModelComponent[]

  @@unique([workspaceId, name])
  @@index([companyId])
  @@index([workspaceId])
  @@index([ownerRoleId])
}

// ─── REGULATIONS (50-state insurance regulatory baseline) ───────────────

model Jurisdiction {
  id                     String    @id @default(cuid())
  tenantId               String
  companyId              String
  company                Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code                   String // USPS code: "AL" … "DC"
  name                   String
  // Regulator
  regulatorName          String
  regulatorWebsite       String?
  regulatorType          String    @default("STATE_INSURANCE_REGULATOR")
  // Taxonomy flags — normalized token + raw doc text
  filingPortal           String // SERFF | PROPRIETARY | MIXED
  filingPortalDetail     String?
  compactStatus          String // MEMBER | NON_MEMBER
  autoVerification       String // YES | NO | PARTIAL
  autoVerificationDetail String?
  workersCompModel       String // EDI | NON_EDI | MIXED | MONOPOLISTIC_FUND | STATE_SPECIFIC
  workersCompDetail      String?
  apcd                   String // YES | NO | EMERGING
  sbs                    String // YES | NO | PARTIAL | TRANSITIONING
  // Narrative blocks (markdown, from the source doc)
  statutoryAuthority     String?
  summaryRegulator       String?
  summaryStatutes        String?
  summaryIntegration     String?
  executiveSummary       String?
  operatingModel         String?
  signalsJson            Json?
  // Governance / pipeline
  priorityTier           String    @default("STANDARD") // PRIORITY | STANDARD
  profileDepth           String    @default("NARRATIVE") // FULL_PROFILE | NARRATIVE
  lastReviewedAt         DateTime?
  lastVerifiedAt         DateTime?
  baselineVersion        Int       @default(1)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  requirements RegulatoryRequirement[]
  sources      RegulatorySource[]
  bulletins    RegulatoryBulletin[]
  rules        ComplianceRule[]
  integrations JurisdictionIntegration[]
  rpRuleSets   RpJurisdictionRuleSet[]

  @@unique([companyId, code])
  @@index([companyId])
}

model IntegrationSystem {
  id              String   @id @default(cuid())
  tenantId        String
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  kind            String // FILING | LICENSING | TAX | DATA_REPORTING | CLAIMS_EDI | VERIFICATION | PAYMENT
  operator        String // NAIC | STATE | VENDOR | COMPACT
  website         String?
  description     String?
  apiAvailability String   @default("PORTAL_ONLY") // API | WEB_SERVICES | PORTAL_ONLY | SFTP_BATCH
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  jurisdictionLinks JurisdictionIntegration[]

  @@unique([companyId, name])
  @@index([companyId])
}

model JurisdictionIntegration {
  id             String            @id @default(cuid())
  jurisdictionId String
  jurisdiction   Jurisdiction      @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  systemId       String
  system         IntegrationSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  usage          String            @default("REQUIRED") // REQUIRED | ACCEPTED | NOT_USED | TRANSITIONING
  scope          String            @default("all lines")
  notes          String?
  effectiveDate  DateTime?
  createdAt      DateTime          @default(now())

  @@unique([jurisdictionId, systemId, scope])
  @@index([jurisdictionId])
  @@index([systemId])
}

// The core obligation rows — single regulation entity (NodeRegulation /
// RegulationApplication / RegulationDeliverable all point here).
model RegulatoryRequirement {
  id                String       @id @default(cuid())
  tenantId          String
  companyId         String
  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jurisdictionId    String
  jurisdiction      Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  category          String // PRODUCT_FILING | LICENSING | PREMIUM_TAX | ...
  title             String
  requirement       String // full obligation text (markdown)
  lineOfBusiness    String       @default("ALL")
  citation          String?
  citationUrl       String?
  obligationType    String       @default("ONGOING")
  frequency         String?
  status            String       @default("ACTIVE") // ACTIVE | SUPERSEDED | PENDING
  effectiveDate     DateTime?
  supersededById    String?
  // The named regulation / regime this obligation belongs to, surfaced as a
  // column so GDPR/CCPA/NYDFS/SERFF/IIPRC are visible without drilling in.
  regime            String? // GDPR | CCPA-CPRA | NYDFS-500 | SERFF | IIPRC | IAIABC-EDI | ...
  // Market segment(s) the obligation applies to — PERSONAL, COMMERCIAL, or both
  // (an empty/both set means it applies enterprise-wide across markets). Filter
  // dimension distinct from lineOfBusiness (the granular product line).
  markets           String[]     @default([]) // PERSONAL | COMMERCIAL
  // Accuracy metadata
  confidence        String       @default("BASELINE") // BASELINE | VERIFIED | DERIVED | STALE
  sourceNote        String?
  // FB-59 — privacy/cyber regimes migrated from Standards carry their SDLC agent
  // skill (ccpa-cpra-sdlc-compliance, gdpr-sdlc-compliance, nydfs-500-sdlc-compliance)
  // so the regulation surfaces the same downloadable skill the standard did.
  agentSkill        String?
  lastVerifiedAt    DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  // User-flagged "we actually follow this as compliance practice" bucket —
  // surfaces as the Compliance card/page, cutting across all three lenses.
  // Superseded by the SCRUM-46 compliance register (complianceRegulationId
  // below); retained for backward compatibility.
  complianceFlagged Boolean      @default(false)

  // ── SCRUM-46 compliance register (v2 workbook) — L3 linkage ──
  // The enforced regime/program this source row rolls up to. Null = row is not
  // part of the determination-ready register (post-baseline additions).
  complianceRegulationId String?
  complianceRegulation   ComplianceRegulation? @relation(fields: [complianceRegulationId], references: [id], onDelete: SetNull)
  // Workbook "Compliance Required": true = binding (B), false = informational
  // (I, with notRequiredReason), null = not assessed by the register.
  complianceRequired     Boolean?
  notRequiredReason      String?

  nodeRegulations           NodeRegulation[]
  regulationApplications    RegulationApplication[]
  regulationDeliverables    RegulationDeliverable[]
  roleRegulations           RoleRegulation[]
  bulletins                 RegulatoryBulletin[]
  regulationWorkTemplates   RegulationWorkTemplate[]
  regulationTemplateAnswers RegulationTemplateAnswer[]
  nodeRegulationEvidences   NodeRegulationEvidence[]
  lineOfBusinessLinks       RequirementLineOfBusiness[]
  complianceItemLinks       ComplianceItemRequirement[]

  @@index([companyId])
  @@index([complianceRegulationId])
  @@index([jurisdictionId])
  @@index([companyId, category])
  @@index([companyId, status])
  // Common list query filters ACTIVE rows for a company then narrows by regime
  // and lineOfBusiness — a covering-ish composite keeps the large catalog fast.
  @@index([companyId, status, regime])
  @@index([companyId, status, lineOfBusiness])
  @@index([companyId, complianceFlagged])
}

// Line-of-business taxonomy — the deduped NAIC annual-statement + Solvency II
// line vocabulary. One row per distinct label; `segments` records which market
// groupings (PERSONAL/COMMERCIAL/FEDERAL/INTERNATIONAL) the label belongs to.
// Requirements attach to lines through RequirementLineOfBusiness (many-to-many).
model LineOfBusiness {
  id        String   @id @default(cuid())
  tenantId  String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code      String // slug, unique per company
  label     String
  group     String   @default("Other") // family group (Individual Life, Medical & Health, Property, …) — the table/filter roll-up
  segments  String[] @default([]) // PERSONAL | COMMERCIAL | FEDERAL | INTERNATIONAL
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirementLinks RequirementLineOfBusiness[]

  @@unique([companyId, code])
  @@index([companyId])
}

// Junction: which granular lines of business a requirement governs. A single
// obligation commonly applies to several lines, so this is many-to-many rather
// than the coarse RegulatoryRequirement.lineOfBusiness scalar (kept for the
// simple filter + backward compatibility).
model RequirementLineOfBusiness {
  id         String                @id @default(cuid())
  companyId  String
  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  regId      String
  regulation RegulatoryRequirement @relation(fields: [regId], references: [id], onDelete: Cascade)
  lobId      String
  lob        LineOfBusiness        @relation(fields: [lobId], references: [id], onDelete: Cascade)
  createdAt  DateTime              @default(now())

  @@unique([regId, lobId])
  @@index([companyId])
  @@index([lobId])
  @@index([regId])
}

// ─── COMPLIANCE REGISTER (SCRUM-46 v2 — determination-ready workbook) ────
// Three-level register: ComplianceRegulation (L1 regime/program, REG-###) →
// ComplianceItem (L2 atomic "what must be done", REG-###-C##) → the existing
// RegulatoryRequirement rows (L3 per-jurisdiction sources) linked via
// RegulatoryRequirement.complianceRegulationId. Imported once from
// documents/regulations/Regulation-Compliance-Determination-Ready.xlsx
// (scripts/import-compliance-register.ts); the app is the system of record
// for all subsequent changes (sign-offs, promotions, edits).

// L1 — one row per enforced regime/program ("what is the rule?").
model ComplianceRegulation {
  id                        String   @id @default(cuid())
  tenantId                  String
  companyId                 String
  company                   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  regCode                   String // REG-001 … natural key from the workbook
  name                      String // Regulation / Program
  category                  String // PRODUCT_FILING | LICENSING | … (same vocabulary as RegulatoryRequirement.category)
  lineOfBusiness            String   @default("ALL")
  jurisdictionScope         String // "51 jurisdictions" | "Federal" | …
  productImpact             Boolean  @default(false)
  processImpact             Boolean  @default(false)
  systemImpact              Boolean  @default(false)
  ownerTeam                 String // accountable function (free text from workbook, e.g. "Product Compliance / Filing Team")
  frequency                 String
  dueDate                   String   @default("Not Yet Determined")
  evidenceRequired          String
  auditStatus               String   @default("Not started")
  representativeRequirement String // verbatim example from the source rows
  sampleCitations           String
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  items        ComplianceItem[]
  variants     ComplianceJurisdictionVariant[]
  requirements RegulatoryRequirement[]

  @@unique([companyId, regCode])
  @@index([companyId, category])
}

// L2 — one row per atomic, auditable compliance task ("what must we do?").
model ComplianceItem {
  id                        String               @id @default(cuid())
  tenantId                  String
  companyId                 String
  company                   Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  itemCode                  String // REG-001-C01 … natural key from the workbook
  regulationId              String
  regulation                ComplianceRegulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  name                      String // the task — "what must be done"
  ownerTeam                 String
  frequency                 String
  evidence                  String
  jurisdictionScope         String
  auditStatus               String               @default("Not started")
  // ── grounding evidence (workbook zone 2) ──
  supportingReqRows         Int                  @default(0) // count of L3 source rows backing this item
  groundingBasis            String // ITEM (item-level keyword match) | REGULATION (inherits all parent rows — counsel to map)
  officialSourceRows        Int                  @default(0)
  jurisdictionsCovered      Int                  @default(0)
  representativeRequirement String
  repJurisdiction           String
  supportingCitations       String // "Jurisdiction: citation | …" top 3, official first
  frequencyDerived          String // frequency read from actual source text
  frequencyAlignment        String // MATCH | REVIEW | NO_SIGNAL
  deadlineSignals           String // extracted phrases, e.g. "within 30 days (×12)"
  // ── determination workflow (workbook zone 3) ──
  determinationStatus       String // GROUNDED | GROUNDED_NON_OFFICIAL | PARTIAL | NOT_GROUNDED
  confidence                String // HIGH | MEDIUM | LOW
  signOff                   String               @default("PENDING") // PENDING | CONFIRMED | REJECTED | NEEDS_RESEARCH
  reviewer                  String?
  reviewNotes               String?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  signOffEvents        ComplianceSignOffEvent[]
  requirementLinks     ComplianceItemRequirement[]
  promotedFromVariants ComplianceJurisdictionVariant[]
  workTemplates        ComplianceItemWorkTemplate[]
  templateAnswers      ComplianceItemTemplateAnswer[]
  rpFilingLinks        RpFilingCompliance[]

  @@unique([companyId, itemCode])
  @@index([regulationId])
  @@index([companyId, confidence])
  @@index([companyId, signOff])
}

// Junction: the specific L3 source rows a reviewer selected as supporting an
// item (upgrades groundingBasis REGULATION → ITEM during confirmation).
model ComplianceItemRequirement {
  id               String                @id @default(cuid())
  companyId        String
  complianceItemId String
  complianceItem   ComplianceItem        @relation(fields: [complianceItemId], references: [id], onDelete: Cascade)
  requirementId    String
  requirement      RegulatoryRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  createdAt        DateTime              @default(now())

  @@unique([complianceItemId, requirementId])
  @@index([complianceItemId])
  @@index([requirementId])
  @@index([companyId, complianceItemId])
}

// 51 rows where one regulation imposes different day-count deadlines by
// jurisdiction — candidates to promote into bespoke L2 items (promotedItemId
// set once promoted).
model ComplianceJurisdictionVariant {
  id               String               @id @default(cuid())
  companyId        String
  regulationId     String
  regulation       ComplianceRegulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  jurisdiction     String // regulator/jurisdiction label from the workbook (free text — not always a Jurisdiction row)
  deadlineVariant  String // e.g. "within 10 days"
  requirementTitle String
  citation         String
  promotedItemId   String?
  promotedItem     ComplianceItem?      @relation(fields: [promotedItemId], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())

  @@index([regulationId])
  @@index([companyId, regulationId])
  @@index([promotedItemId])
}

// Append-only sign-off audit trail — what makes a determination defensible.
model ComplianceSignOffEvent {
  id               String         @id @default(cuid())
  companyId        String
  complianceItemId String
  complianceItem   ComplianceItem @relation(fields: [complianceItemId], references: [id], onDelete: Cascade)
  action           String // CONFIRM | REJECT | NEEDS_RESEARCH | RESET | PROMOTE
  reviewer         String // user email/name performing the action
  note             String?
  createdAt        DateTime       @default(now())

  @@index([complianceItemId])
  @@index([companyId, createdAt])
}

model RegulatoryBulletin {
  id             String                 @id @default(cuid())
  tenantId       String
  companyId      String
  company        Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jurisdictionId String
  jurisdiction   Jurisdiction           @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  reference      String
  title          String
  summary        String?
  url            String?
  issuedDate     DateTime?
  discoveredVia  String                 @default("BASELINE") // BASELINE | PIPELINE | MANUAL
  requirementId  String?
  requirement    RegulatoryRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([companyId])
  @@index([jurisdictionId])
}

model ComplianceRule {
  id             String       @id @default(cuid())
  tenantId       String
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jurisdictionId String
  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  ruleCode       String
  category       String
  description    String?
  ruleJson       Json
  origin         String       @default("DOCUMENT") // DOCUMENT | TEMPLATE_DERIVED | PIPELINE
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([companyId, ruleCode])
  @@index([companyId])
  @@index([jurisdictionId])
}

model RegulatorySource {
  id                  String        @id @default(cuid())
  tenantId            String
  companyId           String
  company             Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jurisdictionId      String?
  jurisdiction        Jurisdiction? @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  name                String
  url                 String
  sourceType          String
  authority           String        @default("OFFICIAL_REGULATOR")
  monitor             Boolean       @default(true)
  checkTier           String        @default("WEEKLY") // PRIORITY_DAILY | WEEKLY
  lastCheckedAt       DateTime?
  lastContentHash     String?
  lastChangedAt       DateTime?
  consecutiveFailures Int           @default(0)
  healthStatus        String        @default("OK") // OK | UNREACHABLE | PARSE_ERROR
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([companyId])
  @@index([jurisdictionId])
}

// ─── FORMS RATIONALIZATION (FORMS-RATION) ───────────────────────────────
// Policy forms as a normalized layer of the machine-readable enterprise.
// Two planes share one trust model: the CLAUSE plane (what forms SAY —
// segmentation → clustering → findings → dispositions → preferred wordings)
// and the FIELD plane (what forms ASK — dictionary → extraction → mappings).
// Invariants (module spec FORMS-RATION v0.3.0): every AI output is a
// FormFinding with citations + confidence; confidence < 0.70 routes to
// needs-human and is never bulk-cleared; dispositions advance only through
// append-only FormDispositionEvent rows.

// A proprietary policy form — the library's system of record (FORMS-HLR-001).
model PolicyForm {
  id           String   @id @default(cuid())
  tenantId     String
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  formNumber   String // e.g. "CG 20 10"
  title        String
  lob          String? // line of business token: General Liability | Property | Auto | Workers Comp | Umbrella | Professional
  states       Json? // applicable state postal codes, e.g. ["NY","CA"]; null = countrywide
  editionDate  String? // edition, e.g. "04 13"
  filingStatus String   @default("Draft") // Draft | Filed | Approved | Withdrawn
  provenance   String   @default("client") // client | iso-flagged — ISO-flagged content is excluded from grounding (ADR-005, NFR-004)
  ownerRoleId  String?
  ownerRole    Role?    @relation("PolicyFormOwner", fields: [ownerRoleId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  versions     PolicyFormVersion[]
  dispositions FormDisposition[]   @relation("DispositionForm")
  mergeTargets FormDisposition[]   @relation("DispositionTargetForm")
  applications FormApplication[]
  processLinks FormProcessNode[]
  productLinks FormProductNode[]

  @@unique([companyId, formNumber])
  @@index([companyId])
  @@index([ownerRoleId])
}

// An immutable ingested revision of a form; clauses/fields hang off versions
// so re-ingest never mutates history (FORMS-HLR-001/002).
model PolicyFormVersion {
  id            String     @id @default(cuid())
  tenantId      String
  companyId     String
  formId        String
  form          PolicyForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  versionNo     Int
  status        String     @default("ready") // ingesting | ready | quarantined — mean segConfidence < 0.7 quarantines (LLD 2.1)
  sourceUri     String?
  sourceText    String // canonical extracted text; clause offsets index into this
  segConfidence Float      @default(1)
  createdAt     DateTime   @default(now())
  createdById   String? // User id (nullable: connector/agent ingest)

  clauses           FormClause[]
  fields            FormField[]
  workingSetMembers FormWorkingSetMember[]
  findings          FormFinding[]

  @@unique([formId, versionNo])
  @@index([companyId])
}

// One segmented clause with character offsets back into sourceText — the
// citation grain for every finding (FORMS-LLR-001/002).
model FormClause {
  id            String            @id @default(cuid())
  tenantId      String
  companyId     String
  formVersionId String
  formVersion   PolicyFormVersion @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
  ordinal       Int
  level         Int               @default(1)
  heading       String?
  text          String
  charStart     Int
  charEnd       Int
  textHash      String // sha256(normalized text) — hash-equal short-circuits similarity (LLD 2.2)
  segConfidence Float             @default(1)

  clusterMembers   ClauseClusterMember[]
  representativeOf ClauseCluster[]       @relation("ClusterRepresentative")
  preferredSources PreferredWording[]    @relation("PreferredWordingSource")

  @@unique([formVersionId, ordinal])
  @@index([companyId])
  @@index([textHash])
}

// A named rationalization scope of form versions. Default UX mode derives
// from member count (7 or fewer = reading, 8+ = portfolio — FORMS-HLR-008);
// modeOverride stores an explicit user choice, never the computed default.
model FormWorkingSet {
  id               String    @id @default(cuid())
  tenantId         String
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  modeOverride     String? // reading | portfolio | null = derive from size
  clusterThreshold Float     @default(0.55) // lexical-similarity theta for this set's cluster runs
  clusterStatus    String    @default("none") // none | running | done | failed
  clusteredAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  members  FormWorkingSetMember[]
  clusters ClauseCluster[]
  findings FormFinding[]

  @@unique([companyId, name])
  @@index([companyId])
}

model FormWorkingSetMember {
  id            String            @id @default(cuid())
  companyId     String
  workingSetId  String
  workingSet    FormWorkingSet    @relation(fields: [workingSetId], references: [id], onDelete: Cascade)
  formVersionId String
  formVersion   PolicyFormVersion @relation(fields: [formVersionId], references: [id], onDelete: Cascade)

  @@unique([workingSetId, formVersionId])
  @@index([workingSetId])
  @@index([formVersionId])
  @@index([companyId, workingSetId])
}

// A group of equivalent/similar clauses across the working set — the primary
// analysis primitive (ADR-001, FORMS-HLR-007). Rebuilt per cluster run.
model ClauseCluster {
  id                     String         @id @default(cuid())
  tenantId               String
  companyId              String
  workingSetId           String
  workingSet             FormWorkingSet @relation(fields: [workingSetId], references: [id], onDelete: Cascade)
  label                  String
  representativeClauseId String?
  representativeClause   FormClause?    @relation("ClusterRepresentative", fields: [representativeClauseId], references: [id], onDelete: SetNull)
  divergenceScore        Float          @default(0) // 1 - min pairwise similarity within the cluster
  createdAt              DateTime       @default(now())

  members          ClauseClusterMember[]
  findings         FormFinding[]
  dispositions     FormDisposition[]     @relation("DispositionCluster")
  preferredWording PreferredWording?

  @@index([workingSetId])
  @@index([companyId])
  @@index([representativeClauseId])
}

model ClauseClusterMember {
  id         String        @id @default(cuid())
  companyId  String
  clusterId  String
  cluster    ClauseCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  clauseId   String
  clause     FormClause    @relation(fields: [clauseId], references: [id], onDelete: Cascade)
  similarity Float // similarity to the cluster representative (medoid)
  outlier    Boolean       @default(false)

  @@unique([clusterId, clauseId])
  @@index([clusterId])
  @@index([clauseId])
}

// The ONLY AI output type (ADR-004): a claim with citations, confidence and a
// trace. confidence < 0.70 = status needs-human, excluded from bulk actions
// (FORMS-LLR-011/012).
model FormFinding {
  id            String             @id @default(cuid())
  tenantId      String
  companyId     String
  workingSetId  String?
  workingSet    FormWorkingSet?    @relation(fields: [workingSetId], references: [id], onDelete: Cascade)
  clusterId     String?
  cluster       ClauseCluster?     @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  formVersionId String?
  formVersion   PolicyFormVersion? @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
  subjectKind   String // cluster | clausePair | form | fieldMapping
  claim         String
  citations     Json // [{ formVersionId, clauseId, charStart, charEnd, quote }] — cited source text never truncated (SM-003)
  confidence    Float // 0..1
  status        String             @default("new") // new | needs-human | accepted | rejected | superseded
  agentSkill    String             @default("lexical-cluster-v1")
  traceRef      String?
  decidedById   String? // User id of the reviewer who accepted/rejected
  decidedAt     DateTime?
  createdAt     DateTime           @default(now())

  @@index([companyId])
  @@index([workingSetId])
  @@index([clusterId])
  @@index([companyId, status])
}

// A Keep / Merge-into / Retire / Redraft decision on a form or cluster.
// `status` is a derived cache of the latest FormDispositionEvent — the event
// log is the source of truth (FORMS-LLR-007).
model FormDisposition {
  id           String         @id @default(cuid())
  tenantId     String
  companyId    String
  subjectKind  String // form | cluster
  formId       String?
  form         PolicyForm?    @relation("DispositionForm", fields: [formId], references: [id], onDelete: Cascade)
  clusterId    String?
  cluster      ClauseCluster? @relation("DispositionCluster", fields: [clusterId], references: [id], onDelete: Cascade)
  type         String // keep | merge | retire | redraft
  targetFormId String? // merge target
  targetForm   PolicyForm?    @relation("DispositionTargetForm", fields: [targetFormId], references: [id], onDelete: SetNull)
  ownerRoleId  String?
  ownerRole    Role?          @relation("FormDispositionOwner", fields: [ownerRoleId], references: [id], onDelete: SetNull)
  rationale    String?
  status       String         @default("proposed") // proposed | approved | rejected | executed (cache of latest event)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  events FormDispositionEvent[]

  @@index([companyId])
  @@index([formId])
  @@index([clusterId])
  @@index([ownerRoleId])
}

// Append-only decision history — never updated, never deleted (NFR-003).
model FormDispositionEvent {
  id            String          @id @default(cuid())
  companyId     String
  dispositionId String
  disposition   FormDisposition @relation(fields: [dispositionId], references: [id], onDelete: Cascade)
  event         String // proposed | approved | rejected | executed
  actorKind     String          @default("user") // user | agent
  actorId       String? // User id, or agent skill slug for actorKind=agent
  note          String?
  at            DateTime        @default(now())

  @@index([dispositionId])
  @@index([companyId])
}

// The one surviving standard clause per resolved cluster (FORMS-HLR-011).
model PreferredWording {
  id             String        @id @default(cuid())
  tenantId       String
  companyId      String
  clusterId      String        @unique
  cluster        ClauseCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  sourceClauseId String?
  sourceClause   FormClause?   @relation("PreferredWordingSource", fields: [sourceClauseId], references: [id], onDelete: SetNull)
  clauseText     String
  status         String        @default("active") // active | superseded
  approvedById   String? // User id
  createdAt      DateTime      @default(now())

  @@index([companyId])
  @@index([sourceClauseId])
}

// ─── FORMS FIELD PLANE (QFD-informed, ACORD-aware — ADR-006) ────────────

// Canonical field dictionary entry: key grammar `role.entity.attribute`
// (instance counters live on FormField occurrences). stability=do-not-map
// keys are excluded from mapping suggestions (INV-F1); composition parts make
// a calculated field get-only (INV-F2); acordRef defers semantics to ACORD,
// never forks them (INV-F4). (FORMS-HLR-018)
model FieldDefinition {
  id                String   @id @default(cuid())
  tenantId          String
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key               String // e.g. "insured.tax.fein"
  dataSetType       String // Insured | Policy | Producer | Carrier | Coverage | Location | Vehicle | Loss | Payment | Identification | Signature | Nav | UserDefined
  dataType          String   @default("string") // string | number | date | boolean | choice | signature
  acordRef          String? // ACORD data-dictionary element id where one exists
  scope             String   @default("tenant") // global | tenant | form
  stability         String   @default("stable") // stable | do-not-map
  compositionParts  Json? // ordered FieldDefinition keys; non-null = calculated (get-only)
  compositionFormat String? // punctuation-explicit, e.g. "{FName} {MName} {LName}, {Suffix}"
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  mappings FieldMapping[]

  @@unique([companyId, key])
  @@index([companyId, dataSetType])
}

// A field occurrence extracted from a fielded form version (FORMS-LLR-016).
model FormField {
  id            String            @id @default(cuid())
  tenantId      String
  companyId     String
  formVersionId String
  formVersion   PolicyFormVersion @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
  sourceName    String // as found in AcroForm/XFA (engine prefixes normalized on ingest)
  label         String?
  page          Int               @default(1)
  widgetType    String            @default("text") // text | checkbox | radio | choice | signature | date
  options       Json? // [{ label, exportValue }] — export-value semantics preserved (FORMS-HLR-021)
  selectMode    String? // single | multi (FORMS-LLR-019)
  required      Boolean           @default(false)
  formatRule    String?
  instance      Int               @default(1)

  mappings FieldMapping[]

  @@unique([formVersionId, sourceName, instance])
  @@index([companyId])
  @@index([formVersionId])
}

// Suggested/confirmed link between an extracted field and a dictionary entry,
// with per-signal scores persisted for audit (FORMS-LLR-017, INV-F3).
model FieldMapping {
  id                String          @id @default(cuid())
  tenantId          String
  companyId         String
  formFieldId       String
  formField         FormField       @relation(fields: [formFieldId], references: [id], onDelete: Cascade)
  fieldDefinitionId String
  fieldDefinition   FieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  confidence        Float // 0.4*nameSim + 0.45*labelSim + 0.15*optionOverlap (LLD 7.2)
  nameSim           Float
  labelSim          Float
  optionOverlap     Float
  status            String          @default("suggested") // suggested | needs-human | confirmed | rejected
  reviewerId        String? // User id (INV-F3)
  decidedAt         DateTime?
  createdAt         DateTime        @default(now())

  @@unique([formFieldId, fieldDefinitionId])
  @@index([formFieldId])
  @@index([fieldDefinitionId])
  @@index([companyId, status])
}

// ─── FORMS SIX-DIMENSION JUNCTIONS (ontology bridge) ────────────────────

// PolicyForm to Application: implementedBy (renders/consumes the form) or
// feedsApplication (prefill/consumption contract) — FORMS-HLR-016.
model FormApplication {
  id            String      @id @default(cuid())
  companyId     String
  formId        String
  form          PolicyForm  @relation(fields: [formId], references: [id], onDelete: Cascade)
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  role_         String      @default("implementedBy") // implementedBy | feedsApplication

  @@unique([formId, applicationId, role_])
  @@index([formId])
  @@index([applicationId])
  @@index([companyId, formId])
}

// PolicyForm to ProcessNode: servesValueStream (L2) or impactsTask (L5) —
// the change-impact hop ("retiring this form touches these tasks").
model FormProcessNode {
  id            String      @id @default(cuid())
  companyId     String
  formId        String
  form          PolicyForm  @relation(fields: [formId], references: [id], onDelete: Cascade)
  processNodeId String
  processNode   ProcessNode @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  role_         String      @default("servesValueStream") // servesValueStream | impactsTask

  @@unique([formId, processNodeId, role_])
  @@index([formId])
  @@index([processNodeId])
  @@index([companyId, formId])
}

// PolicyForm to ProductNode (product spine L4 version node): the form set a
// product version attaches. THE single source of truth for every form the
// workspace Products grid and the Product Model tabs render — those surfaces
// resolve forms through this junction; ProductNode.attributes carries no form
// content (no free-text form lists anywhere else).
model FormProductNode {
  id            String      @id @default(cuid())
  companyId     String
  formId        String
  form          PolicyForm  @relation(fields: [formId], references: [id], onDelete: Cascade)
  productNodeId String
  productNode   ProductNode @relation(fields: [productNodeId], references: [id], onDelete: Cascade)
  role_         String      @default("baseForm") // baseForm | declarations | endorsement | stateAmendatory

  @@unique([formId, productNodeId, role_])
  @@index([formId])
  @@index([productNodeId])
  @@index([companyId, formId])
}

// ─── UW WORKBENCH (submission → clearance → triage → desk → quote → bind) ─
// AI-native underwriting workbench (UW-WORK module). 19 tenant-scoped entities
// in five planes (submission / signal / decision / commercial / governance),
// implementing tb-uw-workbench ontology v0.1.0 one-for-one. Six-dimension
// participation: AuthorityGrant→Role (ADR-03), AppetiteStatement→OrgUnit,
// BindEvent/PasBinding→Application, Submission→ProcessNode (flows-through).
// Invariants INV-1..7 are enforced in the service layer (routes/uw); the
// governance spine (UwGovernanceEvent) is append-only — no update/delete path.

model UwAccount {
  id          String  @id @default(cuid())
  tenantId    String
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  identifiers Json? // { fein?, duns?, naics? ... }
  domicile    String? // ISO country / US state token
  industry    String? // NAICS description
  blocked     Boolean @default(false) // blocked-account clearance input

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions UwSubmission[]

  @@unique([companyId, name])
  @@index([companyId])
}

model UwSubmission {
  id                String       @id @default(cuid())
  tenantId          String
  companyId         String
  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ref               String // human ref e.g. SUB-88121
  accountId         String
  account           UwAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  channel           String       @default("PORTAL") // EMAIL | PORTAL | API | FILE
  status            String       @default("RECEIVED") // RECEIVED | IN_CLEARANCE | IN_TRIAGE | IN_REVIEW | REFERRED | QUOTED | BOUND | DECLINED | WITHDRAWN
  lob               String // CP | EB | GL | BOP | OM | XS | WC
  brokerName        String?
  receivedAt        DateTime     @default(now())
  effectiveDate     DateTime?
  slaDueAt          DateTime?
  tivTotal          Float?
  description       String?
  appetiteVerdict   String? // IN | EDGE | OUT — latest evaluation (cache; citations in payload)
  appetiteCitations Json? // [{ statementRef, version }]
  // Extracted evidence with per-field confidence + provenance (LLR-01):
  // [{ field, value, confidence, provenance:{ docId, page, bbox, extractorVersion } }]
  extractedFields   Json?
  assignedRoleId    String?
  assignedRole      Role?        @relation("UwSubmissionAssignedRole", fields: [assignedRoleId], references: [id], onDelete: SetNull)
  valueStreamNodeId String? // flows-through: six-dimension ValueStream participation
  valueStreamNode   ProcessNode? @relation("UwSubmissionValueStream", fields: [valueStreamNodeId], references: [id], onDelete: SetNull)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  riskObjects      UwRiskObject[]
  coverageRequests UwCoverageRequest[]
  clearanceChecks  UwClearanceCheck[]
  triageScores     UwTriageScore[]
  referralCases    UwReferralCase[]
  decisions        UwDecision[]
  quoteProposals   UwQuoteProposal[]
  pasBindings      UwPasBinding[]
  agentActions     UwAgentAction[]
  governanceEvents UwGovernanceEvent[]

  @@unique([companyId, ref])
  @@index([companyId, status])
  @@index([companyId, slaDueAt])
  @@index([accountId])
  @@index([assignedRoleId])
  @@index([valueStreamNodeId])
}

model UwRiskObject {
  id           String       @id @default(cuid())
  tenantId     String
  companyId    String
  submissionId String
  submission   UwSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  kind         String       @default("LOCATION") // LOCATION | VEHICLE | VESSEL | ENTITY | EQUIPMENT
  name         String
  situs        String? // address / territory token
  tiv          Float?
  exposureData Json? // { sprinklerClass?, floodZone?, ammoniaRefrigeration? ... }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrichmentRecords UwEnrichmentRecord[]

  @@index([submissionId])
  @@index([companyId])
}

model UwCoverageRequest {
  id           String       @id @default(cuid())
  tenantId     String
  companyId    String
  submissionId String
  submission   UwSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  lob          String // CP | EB | GL | BOP | OM | XS | WC
  limitAmount  Float?
  deductible   Float?
  terms        Json?

  createdAt DateTime @default(now())

  @@index([submissionId])
  @@index([companyId])
}

model UwClearanceCheck {
  id                String       @id @default(cuid())
  tenantId          String
  companyId         String
  submissionId      String
  submission        UwSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  checkType         String // DUPLICATE | BLOCKED | WATCHLIST
  verdict           String       @default("CLEAR") // CLEAR | HIT | RELEASED
  matchEvidence     Json? // list evidence / match score from screening
  // Dual-control release (INV-4): two distinct operating roles required.
  firstReleaseBy    String? // email
  firstReleaseRole  String? // operating role id or role token
  firstReleaseAt    DateTime?
  secondReleaseBy   String?
  secondReleaseRole String?
  secondReleaseAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([submissionId])
  @@index([companyId, verdict])
}

model UwEnrichmentSource {
  id            String  @id @default(cuid())
  tenantId      String
  companyId     String
  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  kind          String // HAZARD | FIRMOGRAPHIC | GEOCODE | CAT_MODEL | LOSS_HISTORY | SANCTIONS
  costClass     String  @default("LOW") // FREE | LOW | MEDIUM | HIGH
  ttlHours      Int     @default(720)
  jurisdictions String? // comma list of permitted jurisdictions; null = unrestricted (NFR-06)
  active        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrichmentRecords UwEnrichmentRecord[]

  @@unique([companyId, name])
  @@index([companyId])
}

model UwEnrichmentRecord {
  id           String             @id @default(cuid())
  tenantId     String
  companyId    String
  riskObjectId String
  riskObject   UwRiskObject       @relation(fields: [riskObjectId], references: [id], onDelete: Cascade)
  sourceId     String
  source       UwEnrichmentSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  payload      Json
  payloadHash  String
  cost         Float?
  fetchedAt    DateTime           @default(now())
  expiresAt    DateTime? // fetchedAt + source.ttlHours; cache respects TTL (LLR-06)

  @@index([riskObjectId])
  @@index([sourceId])
  @@index([companyId])
}

model UwTriageScore {
  id             String       @id @default(cuid())
  tenantId       String
  companyId      String
  submissionId   String
  submission     UwSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  appetiteFit    Float // 0..100 per-lens sub-scores (LLR-05, explainable)
  winnability    Float
  expectedValue  Float
  effort         Float
  composite      Float
  weightsVersion String       @default("w1")
  rationale      Json? // per-lens explanation strings
  scoredAt       DateTime     @default(now())
  // Versioned, never overwritten — re-score appends a new row (LLR-05).

  @@index([submissionId, scoredAt])
  @@index([companyId])
}

model UwAppetiteStatement {
  id             String    @id @default(cuid())
  tenantId       String
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ref            String // AS-114 — stable across versions
  version        Int       @default(1)
  stance         String // TARGET | ACCEPTABLE | REFER | DECLINE
  lob            String
  segment        String?
  naicsCodes     String? // comma list, ^\d{4,6}$ each
  geographies    String? // comma list of region tokens
  tivMax         Float?
  capacityLimit  Float? // rejected on DECLINE stance (semantic gate)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  rationale      String
  status         String    @default("ACTIVE") // ACTIVE | SUPERSEDED | RETIRED
  ownerOrgUnitId String? // owned-by: six-dimension Organization participation
  ownerOrgUnit   OrgUnit?  @relation("UwAppetiteOwner", fields: [ownerOrgUnitId], references: [id], onDelete: SetNull)
  publishedBy    String? // email
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  // Versioned, never mutated in place (INV-3): publish creates ref@version+1.

  @@unique([companyId, ref, version])
  @@index([companyId, status])
  @@index([ownerOrgUnitId])
}

model UwGuidelineRule {
  id            String    @id @default(cuid())
  tenantId      String
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ref           String // GR-2201 — stable across versions
  version       Int       @default(1)
  name          String
  kind          String    @default("DECISION_TABLE") // DECISION_TABLE | EXPRESSION
  definition    Json // decision table rows / expression AST — evaluated by the pure evaluator
  inputsSchema  Json? // declared inputs for inputsHash computation
  stpPath       Boolean   @default(false) // straight-through allowed ONLY when true + G4 approval (INV-2 exception)
  stpApprovedBy String? // G4 approver email — required when stpPath=true
  status        String    @default("ACTIVE") // ACTIVE | SUPERSEDED | RETIRED
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  decisions UwDecision[] @relation("UwDecisionStpRule")

  @@unique([companyId, ref, version])
  @@index([companyId, status])
}

model UwAuthorityGrant {
  id                 String    @id @default(cuid())
  tenantId           String
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ref                String // AG-31 — stable across versions
  version            Int       @default(1)
  roleId             String // authority-as-data: bound to the Roles catalog, never a user id (ADR-03)
  role               Role      @relation("UwAuthorityGrantRole", fields: [roleId], references: [id], onDelete: Cascade)
  premiumMax         Float
  tivMax             Float
  lineSize           Float?
  lobs               String // comma list of LOB tokens
  territories        String // comma list of territory tokens
  delegable          Boolean   @default(false)
  bordereauxAttached Boolean   @default(false) // delegable grants blocked until a bordereaux schedule is attached
  effectiveFrom      DateTime  @default(now())
  effectiveTo        DateTime?
  status             String    @default("ACTIVE") // ACTIVE | SUPERSEDED | RETIRED
  breachCount90d     Int       @default(0) // refreshed by delegated-book breach detection (CAP-13)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  decisions UwDecision[]

  @@unique([companyId, ref, version])
  @@index([companyId, status])
  @@index([roleId])
}

model UwReferralCase {
  id                String       @id @default(cuid())
  tenantId          String
  companyId         String
  submissionId      String
  submission        UwSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  decisionId        String?
  decision          UwDecision?  @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  reason            String // authority breach / EDGE appetite / rule refer outcome
  status            String       @default("OPEN") // OPEN | APPROVED | DECLINED | RETURNED | EXPIRED
  slaDueAt          DateTime
  escalatedToRoleId String // escalation chain derives from the Roles catalog (LLR-11)
  escalatedToRole   Role         @relation("UwReferralEscalatedTo", fields: [escalatedToRoleId], references: [id], onDelete: Cascade)
  resolvedBy        String? // email — resolver must appear in the escalation chain
  resolvedByRole    String? // operating role id of resolver at resolution time
  resolutionNote    String?
  slaBreached       Boolean      @default(false)
  openedAt          DateTime     @default(now())
  resolvedAt        DateTime?

  @@index([submissionId])
  @@index([companyId, status])
  @@index([escalatedToRoleId])
}

model UwDecision {
  id               String            @id @default(cuid())
  tenantId         String
  companyId        String
  submissionId     String
  submission       UwSubmission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  outcome          String // QUOTE | DECLINE | REFER
  premium          Float?
  sublimits        Json? // [{ peril, amount }] — each >= 0 and <= TIV (syntax gate)
  rationale        String
  authorityGrantId String?
  authorityGrant   UwAuthorityGrant? @relation(fields: [authorityGrantId], references: [id], onDelete: SetNull)
  authorityResult  String // PASS | BREACH_REFERRED — pure-function validation output (INV-1)
  authorityDetail  Json? // per-limit pass/fail breakdown from the pure validator
  dispositionedBy  String // email of the human principal (ADR-02) or "stp:<ruleRef>"
  viaStpRuleId     String? // set ONLY on the G4-approved stpPath bypass
  viaStpRule       UwGuidelineRule?  @relation("UwDecisionStpRule", fields: [viaStpRuleId], references: [id], onDelete: SetNull)
  decidedAt        DateTime          @default(now())

  referralCases  UwReferralCase[]
  quoteProposals UwQuoteProposal[]

  @@index([submissionId])
  @@index([companyId, outcome])
  @@index([authorityGrantId])
}

model UwQuoteProposal {
  id                 String       @id @default(cuid())
  tenantId           String
  companyId          String
  submissionId       String
  submission         UwSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  decisionId         String?
  decision           UwDecision?  @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  premium            Float
  terms              Json?
  modelRef           String? // priced-by → RATE-PRICING model ref, ^M-[A-Z]{2}-\d{2}$
  formSetRef         String? // documented-by → FORMS-RATION form set ref, ^FS-[A-Z-]+-\d{2}$
  pricedResolved     Boolean      @default(false) // cross-module edge resolution (INV-7)
  documentedResolved Boolean      @default(false)
  status             String       @default("DRAFT") // DRAFT | PROPOSED | ACCEPTED | BOUND | EXPIRED
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  bindEvent UwBindEvent?

  @@index([submissionId])
  @@index([companyId, status])
}

model UwBindEvent {
  id            String          @id @default(cuid())
  tenantId      String
  companyId     String
  quoteId       String          @unique // binds 1—1 QuoteProposal
  quote         UwQuoteProposal @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  correlationId String // idempotency key — replay returns the existing pasPolicyRef (LLR-12)
  applicationId String // executes-on: PAS Application node (six-dimension participation)
  application   Application     @relation("UwBindApplication", fields: [applicationId], references: [id], onDelete: Cascade)
  pasPolicyRef  String
  executedBy    String // email of binding principal
  executedAt    DateTime        @default(now())

  @@unique([companyId, correlationId])
  @@index([applicationId])
  @@index([companyId])
}

model UwPasBinding {
  id              String       @id @default(cuid())
  tenantId        String
  companyId       String
  submissionId    String
  submission      UwSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  applicationId   String // connector-layer bind-execution target (routed-via)
  application     Application  @relation("UwPasBindingApplication", fields: [applicationId], references: [id], onDelete: Cascade)
  contractVersion String       @default("v1")
  status          String       @default("REGISTERED") // REGISTERED | ACTIVE | FAILED

  createdAt DateTime @default(now())

  @@unique([submissionId, applicationId])
  @@index([companyId])
  @@index([applicationId])
}

model UwAgentAction {
  id                String             @id @default(cuid())
  tenantId          String
  companyId         String
  agentId           String // e.g. triage-01, mcp:<tool>
  kind              String // EXTRACTION | TRIAGE | ENRICHMENT | PROPOSAL | QNA | MCP_TOOL
  modelRef          String // model id used, e.g. claude-fable-5
  promptHash        String
  confidence        Float?
  proposal          Json? // ProposalEnvelope output — never a state transition (ADR-02)
  disposition       String             @default("PENDING") // PENDING | ACCEPTED | MODIFIED | REJECTED | AUTO_STP
  dispositionedBy   String? // human principal email (or "stp:<ruleRef>")
  dispositionedAt   DateTime?
  submissionId      String?
  submission        UwSubmission?      @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  governanceEventId String?            @unique // audited-by 1—1 (INV-5) — required at service layer
  governanceEvent   UwGovernanceEvent? @relation(fields: [governanceEventId], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())

  @@index([companyId, disposition])
  @@index([submissionId])
}

model UwGovernanceEvent {
  id            String        @id @default(cuid())
  tenantId      String
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  eventType     String // SubmissionCreated | ExtractionCompleted | ClearanceCompleted | AppetiteEvaluated | TriageScored | EnrichmentRecorded | ProposalIssued | DecisionRecorded | ReferralOpened | ReferralResolved | QuoteProposed | BindExecuted | DivergenceDetected | RationalizationActioned | AgentControl
  actorKind     String // HUMAN | AGENT | SYSTEM
  actorId       String // email or agent id
  actorRole     String? // operating role id / token at event time
  payloadHash   String
  payload       Json?
  correlationId String // stitches intake → bind across modules (NFR-04)
  submissionId  String?
  submission    UwSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  at            DateTime      @default(now())
  // Append-only audit spine — the service layer exposes no update/delete path.

  agentAction UwAgentAction?
  rpModelRuns RpModelRun[] // Rate-Price runs anchor their trace here (traced-by)

  @@index([companyId, at])
  @@index([companyId, eventType])
  @@index([correlationId])
  @@index([submissionId])
}

model UwDivergencePair {
  id            String    @id @default(cuid())
  tenantId      String
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ref           String // DP-018
  kind          String // APPETITE | RULE | AUTHORITY
  leftRef       String // artifact ref on the left estate (e.g. AS-114)
  leftEstate    String?
  rightRef      String
  rightEstate   String?
  weight        Float // 1 - similarity
  proposal      String? // MERGE | MERGE_WITH_EXCEPTION | RETIRE | KEEP_BOTH
  impactPreview Json? // { submissionsAffected, rolesAffected, pasBindingsAffected }
  status        String    @default("OPEN") // OPEN | MERGED | RETIRED | KEEP_BOTH
  actionedBy    String? // CUO-role principal (INV-6)
  actionNote    String?
  actionedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([companyId, ref])
  @@index([companyId, kind, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// RATE-PRICE — Rating & Pricing Rationalization module.
// Model estate registry → immutable published versions → run store → rate
// programs / filing packets → legacy rationalization (extract → diverge →
// migrate). Governed on the same append-only UwGovernanceEvent spine as the
// UW Workbench (ADR-001: one authority/trace choke point for humans, copilots,
// and agents). TB is the rationalization plane, not the production rating
// engine (ADR-002): runs here are reference quotes / parallel-run evidence.
// ─────────────────────────────────────────────────────────────────────────────

model RpRatingModel {
  id                String       @id @default(cuid())
  tenantId          String
  companyId         String
  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ref               String // M-GL-01 — same grain as UwQuoteProposal.modelRef (^M-[A-Z]{2}-\d{2}$), so the priced-by cross-module edge resolves against this registry
  name              String
  lob               String // CP | EB | GL | BOP | OM | XS | WC
  jurisdictions     String // comma list of USPS codes; CW = countrywide
  engineOfRecord    String       @default("tb-reference") // earnix | hx | pas-native | spreadsheet | legacy | tb-reference
  lifecycle         String       @default("draft") // draft | review | approved | deployed | deprecated | retired
  ownerRoleId       String? // owned-by: six-dimension Role participation
  ownerRole         Role?        @relation("RpModelOwnerRole", fields: [ownerRoleId], references: [id], onDelete: SetNull)
  valueStreamNodeId String? // supports: six-dimension ValueStream participation
  valueStreamNode   ProcessNode? @relation("RpModelValueStream", fields: [valueStreamNodeId], references: [id], onDelete: SetNull)
  currentVersionId  String? // latest published version — derived cache, publish path owns it
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  versions     RpModelVersion[]
  programLinks RpProgramModel[]
  targetWaves  RpMigrationWave[]

  @@unique([companyId, ref])
  @@index([companyId, lifecycle])
  @@index([ownerRoleId])
  @@index([valueStreamNodeId])
}

model RpModelVersion {
  id          String        @id @default(cuid())
  tenantId    String
  companyId   String
  modelId     String
  model       RpRatingModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  semver      String
  bundleHash  String // sha256 of spec — immutable content address, frozen on publish (INV-01)
  provenance  String        @default("human") // human | aglm-proposal | migration-extract
  spec        Json // canonical factor set the reference engine evaluates: { inputs[], factors[], minPremium?, rounding? }
  status      String        @default("draft") // draft | published — published versions are never mutated (edits create a new version)
  publishedBy String? // email — absent until published
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  runs               RpModelRun[]
  optimizationJobs   RpOptimizationJob[]
  filingPackets      RpFilingPacket[]
  divergenceMatrices RpDivergenceMatrix[]

  @@unique([modelId, semver])
  @@index([companyId, status])
}

model RpModelRun {
  id           String             @id @default(cuid())
  tenantId     String
  companyId    String
  versionId    String
  version      RpModelVersion     @relation(fields: [versionId], references: [id], onDelete: Cascade)
  kind         String // quote | what-if | batch | parallel-run
  riskInput    Json
  output       Json // { premium, factorBreakdown[] } (+ { delta, materiality } on parallel-run)
  premium      Float
  latencyMs    Int
  batchId      String?
  batch        RpTestBatch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  traceEventId String? // traced-by: governance-spine anchor for replay
  traceEvent   UwGovernanceEvent? @relation(fields: [traceEventId], references: [id], onDelete: SetNull)
  executedAt   DateTime           @default(now())

  @@index([versionId, executedAt])
  @@index([batchId])
  @@index([traceEventId])
  @@index([companyId])
}

model RpTestBatch {
  id                String   @id @default(cuid())
  tenantId          String
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  purpose           String   @default("regression") // regression | parallel_run | challenger
  versionIds        Json // enumerated scope — bulk ops list every affected version (SM-05)
  datasetRef        String
  tolerancePct      Float    @default(5)
  status            String   @default("RUNNING") // RUNNING | CHECKPOINTED | COMPLETED | FAILED
  checkpoint        Json? // resume point — partial completion is a first-class state
  passFailMatrix    Json?
  disruptionDeciles Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  runs RpModelRun[]

  @@index([companyId, status])
}

model RpJurisdictionRuleSet {
  id                     String        @id @default(cuid())
  tenantId               String
  companyId              String
  company                Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code                   String // USPS code; CW = countrywide default
  jurisdictionId         String? // anchored to the regulations spine when the state is profiled
  jurisdiction           Jurisdiction? @relation(fields: [jurisdictionId], references: [id], onDelete: SetNull)
  version                Int           @default(1)
  optimizationRestricted Boolean       @default(false) // restricted states block optimization until P6 acknowledgment
  constraints            Json // [{ kind, value, note }] — rate caps, banned factors, filing rules. Data, not code (ADR-006 / INV-05)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  optimizationJobs RpOptimizationJob[]

  @@unique([companyId, code, version])
  @@index([companyId])
  @@index([jurisdictionId])
}

model RpOptimizationJob {
  id              String                @id @default(cuid())
  tenantId        String
  companyId       String
  versionId       String
  version         RpModelVersion        @relation(fields: [versionId], references: [id], onDelete: Cascade)
  objective       String // e.g. retention-weighted margin
  constraints     Json? // job-local caps, e.g. per-risk change cap
  ruleSetId       String // constrained-by: constraints resolve ONLY from a versioned rule set (INV-05)
  ruleSet         RpJurisdictionRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
  scenarioCount   Int                   @default(0)
  status          String                @default("READY") // BLOCKED | READY | RUNNING | COMPLETED
  complianceAckBy String? // P6 principal email — agent actors cannot supply the acknowledgment
  complianceAckAt DateTime?
  resultSummary   Json? // disruption preview: premium-change deciles
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([versionId])
  @@index([companyId, status])
  @@index([ruleSetId])
}

model RpRateProgram {
  id            String    @id @default(cuid())
  tenantId      String
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ref           String // RP-001
  product       String
  lob           String
  jurisdiction  String // USPS code
  effectiveDate DateTime?
  filingStatus  String    @default("drafting") // drafting | filed | approved | withdrawn
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  modelLinks    RpProgramModel[]
  filingPackets RpFilingPacket[]

  @@unique([companyId, ref])
  @@index([companyId, filingStatus])
}

model RpProgramModel {
  id        String        @id @default(cuid())
  companyId String
  programId String
  program   RpRateProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  modelId   String
  model     RpRatingModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([programId, modelId])
  @@index([programId])
  @@index([modelId])
}

model RpFilingPacket {
  id              String         @id @default(cuid())
  tenantId        String
  companyId       String
  programId       String
  program         RpRateProgram  @relation(fields: [programId], references: [id], onDelete: Cascade)
  modelVersionId  String // generated-from: the implementing published version
  modelVersion    RpModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)
  serffTrackingNo String?
  status          String         @default("draft") // draft | submitted | accepted | objection | disposed
  sections        Json // [{ name, status, boundComplianceRef? }] — factor deltas, exhibits, checklist
  submittedBy     String?
  submittedAt     DateTime?
  disposition     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  complianceLinks RpFilingCompliance[]

  @@index([programId])
  @@index([modelVersionId])
  @@index([companyId, status])
}

model RpFilingCompliance {
  id               String         @id @default(cuid())
  companyId        String
  filingPacketId   String
  filingPacket     RpFilingPacket @relation(fields: [filingPacketId], references: [id], onDelete: Cascade)
  complianceItemId String // satisfies: obligation discharged by the filing
  complianceItem   ComplianceItem @relation(fields: [complianceItemId], references: [id], onDelete: Cascade)

  @@unique([filingPacketId, complianceItemId])
  @@index([filingPacketId])
  @@index([complianceItemId])
}

model RpLegacyRater {
  id              String   @id @default(cuid())
  tenantId        String
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ref             String // LR-001
  name            String
  lob             String
  artifactType    String // spreadsheet | engine | vendor
  discoveredVia   String?
  complexityScore Float?
  definition      Json? // inventoried raw structure the extractor walks (factor cells, macros, exports)
  status          String   @default("INVENTORIED") // INVENTORIED | EXTRACTED | MIGRATING | RETIRED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  specs       RpCanonicalSpec[]
  waveMembers RpWaveMember[]

  @@unique([companyId, ref])
  @@index([companyId, status])
}

model RpCanonicalSpec {
  id                   String        @id @default(cuid())
  tenantId             String
  companyId            String
  legacyRaterId        String
  legacyRater          RpLegacyRater @relation(fields: [legacyRaterId], references: [id], onDelete: Cascade)
  specVersion          Int           @default(1)
  spec                 Json // { model, inputs[], factors[], logic[], unextracted[] } — unextracted is flagged, never approximated (LLR-18.1)
  extractionConfidence String // high | medium | low
  humanConfirmed       Boolean       @default(false) // cutover gate input (INV-04)
  confirmedBy          String?
  confirmedAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  divergenceMatrices RpDivergenceMatrix[]

  @@unique([legacyRaterId, specVersion])
  @@index([companyId])
}

model RpDivergenceMatrix {
  id               String          @id @default(cuid())
  tenantId         String
  companyId        String
  specId           String
  spec             RpCanonicalSpec @relation(fields: [specId], references: [id], onDelete: Cascade)
  targetVersionId  String
  targetVersion    RpModelVersion  @relation(fields: [targetVersionId], references: [id], onDelete: Cascade)
  portfolioRef     String
  maxDivergencePct Float
  cells            Json // per-factor { factor, class: identical|parametric-delta|structural-delta|unique, deltaPct? }
  recommendation   String? // merge | re-baseline | rebuild | retire
  createdAt        DateTime        @default(now())

  @@index([specId])
  @@index([targetVersionId])
  @@index([companyId])
}

model RpMigrationWave {
  id            String         @id @default(cuid())
  tenantId      String
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ref           String // MW-01
  name          String
  sequence      Int
  cutoverDate   DateTime?
  rollbackPlan  String?
  tolerancePct  Float          @default(5) // divergence tolerance every member must be within (INV-04)
  status        String         @default("PLANNED") // PLANNED | READY | CUTOVER | ROLLED_BACK
  targetModelId String? // migrates-to: the target model raters cut over to
  targetModel   RpRatingModel? @relation(fields: [targetModelId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  members RpWaveMember[]

  @@unique([companyId, ref])
  @@index([companyId, status])
  @@index([targetModelId])
}

model RpWaveMember {
  id            String          @id @default(cuid())
  companyId     String
  waveId        String
  wave          RpMigrationWave @relation(fields: [waveId], references: [id], onDelete: Cascade)
  legacyRaterId String
  legacyRater   RpLegacyRater   @relation(fields: [legacyRaterId], references: [id], onDelete: Cascade)
  status        String          @default("PLANNED") // PLANNED | CUTOVER | ROLLED_BACK

  @@unique([waveId, legacyRaterId])
  @@index([waveId])
  @@index([legacyRaterId])
}
