{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transform-platform/schemas/control.schema.json",
  "title": "Control Definition Schema (framework-agnostic)",
  "description": "Machine-readable definition of a single compliance control / validation that an AI agent can execute or validate for audit-ready automation. Generalized from the Actuarial Loss Analysis control schema so it serves any standard or regulation (SOX, ACORD, ISO, GDPR, ...). Each control is ONE testable validation: it names its source systems, the data it needs, the method, the pass/fail logic, the machine-checkable assertions (with a test script), the evidence it must leave, and its regulatory citation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "control_id",
    "control_name",
    "framework",
    "control_family",
    "domain",
    "control_objective",
    "risk_addressed",
    "regulatory_mapping",
    "test_type",
    "execution_mode",
    "control_frequency",
    "control_owner",
    "required_data_sources",
    "required_data_elements",
    "method",
    "pass_fail_logic",
    "validation",
    "required_evidence",
    "audit"
  ],
  "properties": {
    "control_id": {
      "type": "string",
      "description": "Stable id, e.g. SOX-ITGC-AC-01 or ACORD-PC-01.",
      "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
    },
    "control_name": { "type": "string", "minLength": 3 },
    "framework": {
      "type": "string",
      "description": "The standard or regulation this control belongs to.",
      "minLength": 2
    },
    "control_family": {
      "type": "string",
      "description": "Grouping within the framework, e.g. ITGC-Access, ITGC-Change, Entity-Level, Message-Conformance."
    },
    "domain": { "type": "string", "minLength": 3 },
    "control_objective": { "type": "string", "minLength": 10 },
    "risk_addressed": { "type": "string", "minLength": 10 },
    "regulatory_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework", "citation", "owner_role", "sdlc_gates"],
      "properties": {
        "framework": { "type": "string" },
        "citation": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Section / article / clause references, e.g. ['SOX 404', 'COSO CC5.2'] or ['ACORD P&C v2.x']."
        },
        "owner_role": { "type": "string" },
        "sdlc_gates": {
          "type": "array",
          "items": { "type": "string", "enum": ["Requirements", "Design", "Development", "Testing", "Run"] }
        },
        "applies_to_value_streams": { "type": "array", "items": { "type": "string" } },
        "agent_skill": { "type": "string", "description": "The SDLC agent skill that enforces this control." }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "applies_to": { "type": "array", "items": { "type": "string" } },
        "in_scope_systems": { "type": "array", "items": { "type": "string" } },
        "business_units": { "type": "array", "items": { "type": "string" } },
        "geographies": { "type": "array", "items": { "type": "string" } },
        "legal_entities": { "type": "array", "items": { "type": "string" } },
        "assessment_cycle": { "type": "string" },
        "as_of_date": { "type": "string", "format": "date" }
      }
    },
    "test_type": {
      "type": "string",
      "enum": ["Preventive", "Detective", "Monitoring", "Preventive / Detective"]
    },
    "execution_mode": {
      "type": "string",
      "enum": ["AI Execute", "AI Validate", "Hybrid"]
    },
    "control_frequency": {
      "type": "string",
      "enum": ["Continuous", "Daily", "Weekly", "Monthly", "Quarterly", "Semiannual", "Annual", "Event-triggered", "Each release", "Each analysis cycle", "Each governance cycle"]
    },
    "control_owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_role"],
      "properties": {
        "primary_role": { "type": "string" },
        "supporting_roles": { "type": "array", "items": { "type": "string" } },
        "approval_role": { "type": "string" }
      }
    },
    "required_data_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_name", "system_type", "authoritative", "access_method"],
        "properties": {
          "source_name": { "type": "string" },
          "system_type": {
            "type": "string",
            "enum": [
              "IAM",
              "ITSM",
              "SCM/Git",
              "CI/CD",
              "GL/ERP",
              "Policy Admin",
              "Claims",
              "Billing",
              "Actuarial Mart",
              "Integration/ESB",
              "API Gateway",
              "Schema Registry",
              "CMDB",
              "Data Warehouse",
              "Document Repository",
              "Regulator Portal",
              "External Benchmark",
              "Economic Index",
              "SIEM/Logging",
              "Other"
            ]
          },
          "authoritative": { "type": "boolean" },
          "access_method": {
            "type": "string",
            "description": "How an agent binds to this source to gather evidence.",
            "enum": ["SQL", "API", "MCP", "Git", "SharePoint", "Confluence", "Cowork", "EDI", "SFTP", "File", "Manual Upload", "BI Extract", "Other"]
          },
          "connector_ref": { "type": "string", "description": "Key into source-connectors.md (e.g. 'iam.okta', 'itsm.servicenow')." },
          "system_of_record": { "type": "string" },
          "dataset_identifier": { "type": "string" },
          "location_uri": { "type": "string", "description": "Concrete locator: SQL FQN, API/MCP endpoint, repo URL, SharePoint/Confluence URL." },
          "refresh_cadence": { "type": "string" }
        }
      }
    },
    "required_data_elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field_name", "business_definition", "required"],
        "properties": {
          "field_name": { "type": "string" },
          "business_definition": { "type": "string" },
          "source_name": { "type": "string" },
          "grain": { "type": "string" },
          "data_type": { "type": "string" },
          "required": { "type": "boolean" },
          "null_threshold_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "valid_values": { "oneOf": [{ "type": "array", "items": { "type": "string" } }, { "type": "string" }] },
          "quality_checks": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "steps"],
      "properties": {
        "summary": { "type": "string" },
        "approved_methodology": { "type": "string" },
        "approved_version": { "type": "string" },
        "unit_of_analysis": { "type": "array", "items": { "type": "string" } },
        "steps": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "pseudocode": { "type": "string" },
        "model_or_script_reference": { "type": "string" },
        "sampling_rule": { "type": "string" },
        "fallback_logic": { "type": "string" }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "materiality_basis": { "type": "string" },
        "pass_tolerance": { "type": "string" },
        "warning_threshold": { "type": "string" },
        "escalation_threshold": { "type": "string" },
        "persistence_rule": { "type": "string" }
      }
    },
    "pass_fail_logic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass_criteria", "fail_criteria"],
      "properties": {
        "pass_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "warning_criteria": { "type": "array", "items": { "type": "string" } },
        "fail_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "exception_handling": { "type": "array", "items": { "type": "string" } }
      }
    },
    "validation": {
      "type": "object",
      "description": "Makes the control individually testable. assertions[] are evaluated against a run's metrics by lib/run-control.mjs; test_script is the node:test harness that exercises them.",
      "additionalProperties": false,
      "required": ["assertion_id", "automation_level", "check_type", "test_script", "assertions"],
      "properties": {
        "assertion_id": { "type": "string" },
        "automation_level": { "type": "string", "enum": ["Full", "Partial", "Manual"] },
        "check_type": {
          "type": "string",
          "enum": ["schema", "threshold", "presence", "reconciliation", "policy", "query", "sampling"]
        },
        "test_script": { "type": "string", "description": "Path (pack-relative) to the node:test script that exercises this control." },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metric", "operator", "value", "severity"],
            "properties": {
              "metric": { "type": "string", "description": "Key read from the run/fixture metrics map." },
              "operator": { "type": "string", "enum": ["eq", "ne", "gt", "gte", "lt", "lte", "between", "in", "exists", "matches"] },
              "value": {},
              "severity": { "type": "string", "enum": ["fail", "warn"] },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "required_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts", "retention_period"],
      "properties": {
        "artifacts": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "evidence_repository": { "type": "string" },
        "linkage_required": { "type": "boolean" },
        "retention_period": { "type": "string" },
        "review_signoff_required": { "type": "boolean" },
        "timestamp_required": { "type": "boolean" }
      }
    },
    "downstream_linkage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "target_artifact_types"],
      "properties": {
        "required": { "type": "boolean" },
        "target_artifact_types": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "target_systems": { "type": "array", "items": { "type": "string" } },
        "link_fields": { "type": "array", "items": { "type": "string" } },
        "staleness_rule": { "type": "string" }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preconditions": { "type": "array", "items": { "type": "string" } },
        "actions_on_fail": { "type": "array", "items": { "type": "string" } },
        "issue_ticket_type": { "type": "string" },
        "notification_roles": { "type": "array", "items": { "type": "string" } },
        "sla_days": { "type": "integer", "minimum": 0 }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reproducible", "version_controlled", "independent_review_required"],
      "properties": {
        "reproducible": { "type": "boolean" },
        "version_controlled": { "type": "boolean" },
        "independent_review_required": { "type": "boolean" },
        "override_allowed": { "type": "boolean" },
        "override_approval_required": { "type": "boolean" },
        "audit_focus": { "type": "array", "items": { "type": "string" } }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["Draft", "Active", "Deprecated"] },
    "version": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
