{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "cascade-backend"],
      "port": 4000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "cascade-frontend"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "uw-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:server", "--prefix", "C:/Users/khicks/code/uw-workbench"],
      "port": 4000
    },
    {
      "name": "uw-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:web", "--prefix", "C:/Users/khicks/code/uw-workbench"],
      "port": 5173,
      "name": "backend-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "cascade-backend"],
      "port": 4100,
      "autoPort": true
    },
    {
      "name": "frontend-alt",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:BACKEND_PROXY='http://localhost:4100'; npm run dev -w cascade-frontend"
      ],
      "port": 5273,
      "autoPort": true
    }
  ]
}
