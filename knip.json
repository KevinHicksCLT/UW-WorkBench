{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignore": [
    "backend/scripts/**",
    "scripts/**",
    ".claude/**",
    "standards/**",
    "documents/**"
  ],
  "workspaces": {
    ".": {
      "entry": ["api/index.ts", "playwright.config.ts", "e2e/**/*.spec.ts", "eslint.config.js"],
      "project": ["*.{js,ts}"]
    },
    "backend": {
      "entry": ["src/index.ts", "src/seed/*.ts", "vitest.config.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "frontend": {
      "entry": ["src/main.tsx", "index.html", "vite.config.ts", "vitest.config.ts", "tests/**/*.test.{ts,tsx}", "src/test/setup.ts", "tests/setup.ts"],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
    },
    "shared": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
