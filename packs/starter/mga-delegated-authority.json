          {
            "when": { "roofingPct": { "op": "gt", "value": 15 } },
            "outcome": "REFER",
            "note": "15-40% roofing share needs program-manager sign-off"
          }
        ]
      },
      "inputsSchema": { "roofingPct": "number" }
    }
